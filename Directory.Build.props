<Project>
  <PropertyGroup>
    <Version>0.24.0</Version>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <EmbedUntrackedSources>false</EmbedUntrackedSources>
    <GenerateRepositoryUrlAttribute>false</GenerateRepositoryUrlAttribute>
  </PropertyGroup>

  <PropertyGroup>
    <EnableSourceLink>false</EnableSourceLink>
    <EnableSourceControlManagerQueries>false</EnableSourceControlManagerQueries>
  </PropertyGroup>

  <!-- Reproducible publication builds. The release gate (#1410,
       scripts/verify_release_adjudication.py) rebuilds the packages at publication
       and compares their SHA-256 with the adjudicated hashes, so two builds of one
       commit must produce the same bytes in any checkout directory. Guarded by
       scripts/test_reproducible_builds.py; proof in
       docs/plans/evidence/deterministic-builds/. -->
  <PropertyGroup Label="Reproducible builds">
    <!-- Roslyn: no MVID/timestamp randomness (the SDK default, made explicit). -->
    <Deterministic>true</Deterministic>
    <CalorRepoRoot>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)'))</CalorRepoRoot>
    <!-- NuGet pack writes this time into every .nupkg zip entry instead of the wall
         clock. A fixed constant with no condition: no git or environment input can
         change it (an ambient SOURCE_DATE_EPOCH or DeterministicTimestamp environment
         variable is ignored). Only an explicit -p:DeterministicTimestamp=... global
         property overrides it. -->
    <DeterministicTimestamp>2000-01-01T00:00:00Z</DeterministicTimestamp>
  </PropertyGroup>

  <!-- Release builds of the shipped projects (everything under src/) map the
       checkout directory to /_/ and the NuGet package root to /_1/ in DLLs and PDBs
       (the absolute PDB path in the debug directory and every document path). This
       is the SDK's DeterministicSourcePaths mechanism, fed by the SourceRoot below
       because source-control queries and SourceLink are disabled in this repo.
       Debug builds and test/tool projects keep real paths for local debugging. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release' AND $(MSBuildProjectDirectory.Replace('\', '/').StartsWith('$(CalorRepoRoot.Replace('\', '/'))src/'))">
    <DeterministicSourcePaths>true</DeterministicSourcePaths>
  </PropertyGroup>
  <ItemGroup Condition="'$(DeterministicSourcePaths)' == 'true'">
    <SourceRoot Include="$(CalorRepoRoot)" />
  </ItemGroup>

  <PropertyGroup>
    <Company>Calor</Company>
    <Product>Calor Compiler</Product>
    <Copyright>Copyright © 2024</Copyright>
  </PropertyGroup>

  <PropertyGroup Label="NuGet Package Metadata">
    <Authors>Juan Rivera</Authors>
    <PackageProjectUrl>https://github.com/juanmicrosoft/calor</PackageProjectUrl>
    <RepositoryUrl>https://github.com/juanmicrosoft/calor</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>calor;compiler;dsl;code-generation;dotnet;csharp</PackageTags>
  </PropertyGroup>
</Project>
