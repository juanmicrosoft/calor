§M{Stats}
  §F{Sum:pub} (i32:n) -> i32
    §B{~total} 0
    §L{i:0:n:1}
      §B{~total} (+ total i)
    §R total

  §F{Max:pub} (i32:a, i32:b, i32:c) -> i32
    §IF (&& (>= a b) (>= a c))
      §R a
    §EI (>= b c)
      §R b
    §EL
      §R c

  §F{Classify:pub} (i32:score) -> i32
    §IF (< score 0)
      §R (- 0 1)
    §EI (== score 0)
      §R 0
    §EI (< score 50)
      §IF (< score 25)
        §R 1
      §EL
        §R 2
    §EI (< score 80)
      §R 3
    §EL
      §IF (== score 100)
        §R 5
      §EL
        §R 4

  §F{CountPositive:pub} (i32:n) -> i32
    §B{~count} 0
    §L{i:0:n:1}
      §IF (> i 0)
        §B{~count} (+ count 1)
    §R count

  §F{NestedLoop:pub} (i32:n) -> i32
    §B{~acc} 0
    §L{i:0:n:1}
      §L{j:0:n:1}
        §IF (> i j)
          §B{~acc} (+ acc 1)
        §EL
          §B{~acc} (- acc 1)
    §R acc

