§M{MathLib}
  §F{Add:pub} (i32:a, i32:b) -> i32
    §R (+ a b)

  §F{Subtract:pub} (i32:a, i32:b) -> i32
    §R (- a b)

  §F{Multiply:pub} (i32:x, i32:y) -> i32
    §R (* x y)

  §F{Divide:pub} (i32:a, i32:b) -> i32
    §R (/ a b)

  §F{Sign:pub} (i32:n) -> i32
    §IF (> n 0)
      §R 1
    §EI (< n 0)
      §R (- 0 1)
    §EL
      §R 0

