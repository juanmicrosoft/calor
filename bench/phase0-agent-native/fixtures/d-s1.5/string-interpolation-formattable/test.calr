§M{m001:InterpolationFormattableTest}
  §U{System}

  §CL{c001:FormattableProbe:pub:stat}
    §MT{m002:Kind:pub:stat} (FormattableString:f) -> i32
      §R 1

    §MT{m003:Kind:pub:stat} (any:o) -> i32
      §R (- 1)

    §MT{m004:Verify:pub:stat} () -> i32
      §S (== result 107)
      §B{x:i32} 42
      §B{s:str} "k=${x},${(+ x 1)}"
      §R (+ (* §C{Kind} §A (cast global::System.FormattableString "k=${x},${(+ x 1)}") §/C 100) (len s))
