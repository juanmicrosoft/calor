<!--
  Calor-arm execution template (gates doc §1 pin).
  Instantiated by the runner per pair: __REPO_ROOT__ is substituted with the
  repo root. Effects enforcement ON, permissive OFF, contract mode debug —
  runs violating this pin are invalid by automated check.

  W1 / roadmap v0.16 §4.1 (additive): __CALOR_PERMISSIVE_EFFECTS__ follows the
  arm config — `false` for every treatment arm (the §1 pin), `true` ONLY for
  the registered pre-rows control arm (pair.json `permissiveEffects: true`
  together with `controlArmKind: "pre-rows"`; run-pair.sh admits nothing
  else). run-pair.sh proves the property is honored by the arm's Calor.Tasks
  build with a canary (permissive-canary.calr) before any spend: as of
  7d621c0d neither src/Calor.Sdk/Sdk/Sdk.targets nor CompileCalor.cs threads
  a permissive knob into CompilationOptions.UnknownCallPolicy, so the
  property is inert until that plumbing lands — the canary fails loudly
  rather than letting a "pre-rows" arm run strict.
-->
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <CalorTasksAssembly>__REPO_ROOT__/src/Calor.Tasks/bin/Release/net10.0/Calor.Tasks.dll</CalorTasksAssembly>
    <CalorOutputDirectory>$(MSBuildThisFileDirectory)obj/calor/</CalorOutputDirectory>
    <CalorEnforceEffects>true</CalorEnforceEffects>
    <CalorPermissiveEffects>__CALOR_PERMISSIVE_EFFECTS__</CalorPermissiveEffects>
    <!-- A-1.3 verify gate (instrumentation item 1): the same env knob that
         adds the verify flag to the envelope compile turns on contract
         verification in the Tasks build. MSBuild reads env vars as ambient
         properties, so no template substitution is needed. Semantics: SET to
         any non-empty value = on (even "0"); unset or empty = off — matching
         the bash ${VAR:+...} expansion on the envelope side (#826 review L1). -->
    <CalorVerify Condition="'$(CALOR_P0_VERIFY_GATE)' != ''">true</CalorVerify>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="__REPO_ROOT__/src/Calor.Runtime/Calor.Runtime.csproj" />
    <ProjectReference Include="__REPO_ROOT__/src/Calor.Tasks/Calor.Tasks.csproj"
                      ReferenceOutputAssembly="false"
                      Private="false" />
  </ItemGroup>

  <ItemGroup>
    <CalorCompile Include="**/*.calr" />
  </ItemGroup>

  <Import Project="__REPO_ROOT__/src/Calor.Sdk/Sdk/Sdk.targets" />

</Project>
