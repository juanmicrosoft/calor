  §F{f003:l2m13_fn03:pub} (i32:x, i32:y) -> i32
    §E{}
    §Q (> x 6)
    §S (>= x 7)
    §B{acc:i32} (+ (* x 5) y)
    §IF{if03} (> acc 22422)
      §R (+ acc 22422)
    §EL
      §R (+ (* acc 2) 22422)

