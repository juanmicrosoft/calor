§M{m122:L1M22}

  §F{f001:l1m22_fn01:pub} (i32:x, i32:y) -> i32
    §E{}
    §B{v1:i32} §C{l2m07_fn01} §A x §A INT:88 §/C
    §B{v2:i32} §C{l2m11_fn07} §A x §A INT:62 §/C
    §R (+ (+ v1 v2) y)

  §F{f002:l1m22_fn02:pub} (i32:x, i32:y) -> i32
    §E{}
    §Q (>= x 2)
    §Q (>= y 0)
    §S (>= x 0)
    §B{acc:i32} (+ (* x 3) y)
    §IF{if02} (> acc 21155)
      §R (+ acc 21155)
    §EL
      §R (+ (* acc 2) 21155)

