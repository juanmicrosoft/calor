§M{m310:L3M10}

  §F{f001:l3m10_fn01:pub} (i32:x, i32:y) -> i32
    §E{}
    §Q (>= x 3)
    §Q (>= y 0)
    §S (>= x 1)
    §B{acc:i32} (+ (* x 5) y)
    §IF{if01} (> acc 24235)
      §R (+ acc 24235)
    §EL
      §R (+ (* acc 2) 24235)

