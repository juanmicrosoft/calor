  §F{f001:l1m01_fn01:pub} (i32:x, i32:y) -> i32
    §E{}
    §Q (> x 2)
    §S (>= x 3)
    §B{acc:i32} (+ (* x 2) y)
    §IF{if01} (> acc 20000)
      §R (+ acc 20000)
    §EL
      §R (+ (* acc 2) 20000)

