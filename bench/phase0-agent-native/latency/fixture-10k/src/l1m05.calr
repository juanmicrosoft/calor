§M{m105:L1M05}

  §F{f001:l1m05_fn01:pub} (i32:x, i32:y) -> i32
    §E{}
    §Q (> x 7)
    §S (>= x 8)
    §B{acc:i32} (+ (* x 5) y)
    §IF{if01} (> acc 20245)
      §R (+ acc 20245)
    §EL
      §R (+ (* acc 2) 20245)

