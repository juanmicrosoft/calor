§M{m105:L1M05}

  §F{f001:l1m05_fn01:pub} (i32:x, i32:y) -> i32
    §E{}
    §Q (> x 5)
    §S (>= x 6)
    §B{acc:i32} (+ (* x 3) y)
    §IF{if01} (> acc 20203)
      §R (+ acc 20203)
    §EL
      §R (+ (* acc 2) 20203)

  §F{f002:l1m05_fn02:pub} (i32:x, i32:y) -> i32
    §E{}
    §B{v1:i32} §C{l2m12_fn05} §A x §A INT:87 §/C
    §R (+ v1 y)

  §F{f003:l1m05_fn03:pub} (i32:x, i32:y) -> i32
    §E{}
    §Q (>= y 0)
    §S (>= result x)
    §S (>= result 20210)
    §IF{if03} (>= x 20210)
      §R x
    §EL
      §R 20210

  §F{f004:l1m05_fn04:pub} (i32:x, i32:y) -> i32
