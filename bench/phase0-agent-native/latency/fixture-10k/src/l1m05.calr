    §Q (>= y 0)
    §S (>= result 20224)
    §B{total:i32} (+ (* x 2) y)
    §IF{if05} (< total 20224)
      §R 20224
    §EL
      §R total

  §F{f006:l1m05_fn06:pub} (i32:x, i32:y) -> i32
    §E{}
