  §F{f003:l2m02_fn03:pub} (i32:x, i32:y) -> i32
    §E{}
    §Q (>= x 1)
    §Q (>= y 0)
    §S (>= x 0)
    §B{acc:i32} (+ (* x 2) y)
    §IF{if03} (> acc 21932)
      §R (+ acc 21932)
    §EL
      §R (+ (* acc 2) 21932)

