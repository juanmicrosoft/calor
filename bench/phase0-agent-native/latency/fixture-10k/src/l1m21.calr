§M{m121:L1M21}

  §F{f001:l1m21_fn01:pub} (i32:x, i32:y) -> i32
    §E{}
    §Q (>= x 7)
    §Q (>= y 0)
    §S (>= x 5)
    §B{acc:i32} (+ (* x 3) y)
    §IF{if01} (> acc 21113)
      §R (+ acc 21113)
    §EL
      §R (+ (* acc 2) 21113)

