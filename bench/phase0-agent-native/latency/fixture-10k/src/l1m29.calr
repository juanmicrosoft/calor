§M{m129:L1M29}

  §F{f001:l1m29_fn01:pub} (i32:x, i32:y) -> i32
    §E{}
    §Q (> x 4)
    §S (>= x 5)
    §B{acc:i32} (+ (* x 5) y)
    §IF{if01} (> acc 21519)
      §R (+ acc 21519)
    §EL
      §R (+ (* acc 2) 21519)

  §F{f002:l1m29_fn02:pub} (i32:x, i32:y) -> i32
