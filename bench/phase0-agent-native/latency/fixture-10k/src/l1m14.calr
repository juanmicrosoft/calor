  §F{f004:l1m14_fn04:pub} (i32:x, i32:y) -> i32
    §E{}
    §Q (>= x 3)
    §Q (>= y 0)
    §S (>= x 1)
    §B{acc:i32} (+ (* x 5) y)
    §IF{if04} (> acc 20756)
      §R (+ acc 20756)
    §EL
      §R (+ (* acc 2) 20756)

