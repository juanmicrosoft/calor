§M{m104:L1M04}

  §F{f001:l1m04_fn01:pub} (i32:x, i32:y) -> i32
    §E{}
    §B{v1:i32} §C{l2m08_fn11} §A x §A INT:59 §/C
    §B{v2:i32} §C{l2m19_fn01} §A x §A INT:33 §/C
    §R (+ (+ v1 v2) y)

  §F{f002:l1m04_fn02:pub} (i32:x, i32:y) -> i32
    §E{}
    §Q (> x 2)
    §S (>= x 3)
    §B{acc:i32} (+ (* x 3) y)
    §IF{if02} (> acc 20189)
      §R (+ acc 20189)
    §EL
      §R (+ (* acc 2) 20189)

  §F{f003:l1m04_fn03:pub} (i32:x, i32:y) -> i32
