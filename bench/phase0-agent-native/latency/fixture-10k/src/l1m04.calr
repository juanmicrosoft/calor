  §F{f003:l1m04_fn03:pub} (i32:x, i32:y) -> i32
    §E{}
    §Q (> x 2)
    §S (>= x 3)
    §B{acc:i32} (+ (* x 2) y)
    §IF{if03} (> acc 20161)
      §R (+ acc 20161)
    §EL
