§M{m312:L3M12}

  §F{f001:l3m12_fn01:pub} (i32:x, i32:y) -> i32
    §E{}
    §Q (> x 3)
    §S (>= x 4)
    §B{acc:i32} (+ (* x 2) y)
    §IF{if01} (> acc 24256)
      §R (+ acc 24256)
    §EL
      §R (+ (* acc 2) 24256)

  §F{f002:l3m12_fn02:pub} (i32:x, i32:y) -> i32
    §E{}
    §B{base:i32} (- (* x 4) y)
    §R (+ base 4)

  §F{f003:l3m12_fn03:pub} (i32:x, i32:y) -> i32
    §E{}
    §Q (>= x 0)
    §S (<= result 24263)
    §B{total:i32} (+ (* x 5) y)
    §IF{if03} (> total 24263)
      §R 24263
    §R total

  §F{f004:l3m12_fn04:pub} (i32:x, i32:y) -> i32
