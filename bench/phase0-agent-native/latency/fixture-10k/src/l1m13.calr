§M{m113:L1M13}

  §F{f001:l1m13_fn01:pub} (i32:x, i32:y) -> i32
    §E{}
    §Q (>= x 8)
    §Q (>= y 0)
    §S (>= x 6)
    §B{acc:i32} (+ (* x 2) y)
    §IF{if01} (> acc 20721)
      §R (+ acc 20721)
    §EL
      §R (+ (* acc 2) 20721)

  §F{f002:l1m13_fn02:pub} (i32:x, i32:y) -> i32
