§M{m110:L1M10}

  §F{f001:l1m10_fn01:pub} (i32:x, i32:y) -> i32
    §E{}
    §Q (>= x 4)
    §Q (>= y 0)
    §S (>= result 20504)
    §B{total:i32} (+ (* x 2) y)
    §IF{if01} (< total 20504)
      §R 20504
    §EL
      §R total

  §F{f002:l1m10_fn02:pub} (i32:x, i32:y) -> i32
