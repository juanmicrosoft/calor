§M{m212:L2M12}

  §F{f001:l2m12_fn01:pub} (i32:x, i32:y) -> i32
    §E{}
    §Q (> x 2)
    §S (>= x 3)
    §B{acc:i32} (+ (* x 2) y)
    §IF{if01} (> acc 22380)
      §R (+ acc 22380)
    §EL
      §R (+ (* acc 2) 22380)

