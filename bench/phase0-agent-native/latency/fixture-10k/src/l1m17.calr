    §R (+ (+ v1 v2) y)

  §F{f010:l1m17_fn10:pub} (i32:x, i32:y) -> i32
    §E{}
    §Q (> x 4)
    §S (>= x 5)
    §B{acc:i32} (+ (* x 5) y)
    §IF{if10} (> acc 20903)
      §R (+ acc 20903)
    §EL
      §R (+ (* acc 2) 20903)

  §F{f011:l1m17_fn11:pub} (i32:x, i32:y) -> i32
