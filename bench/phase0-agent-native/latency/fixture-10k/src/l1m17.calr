  §F{f006:l1m17_fn06:pub} (i32:x, i32:y) -> i32
    §E{}
    §Q (>= y 0)
    §S (>= result x)
    §S (>= result 20889)
    §IF{if06} (>= x 20889)
      §R x
    §EL
      §R 20889

  §F{f007:l1m17_fn07:pub} (i32:x, i32:y) -> i32
