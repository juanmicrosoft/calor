  §F{f008:l1m17_fn08:pub} (i32:x, i32:y) -> i32
    §E{}
    §Q (>= x 5)
    §Q (>= y 0)
    §S (>= result 20896)
    §B{total:i32} (+ (* x 3) y)
    §IF{if08} (< total 20896)
      §R 20896
    §EL
      §R total

  §F{f009:l1m17_fn09:pub} (i32:x, i32:y) -> i32
    §E{}
