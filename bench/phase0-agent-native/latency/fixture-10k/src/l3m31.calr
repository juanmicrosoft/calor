§M{m331:L3M31}

  §F{f001:l3m31_fn01:pub} (i32:x, i32:y) -> i32
    §E{}
    §Q (> x 0)
    §S (>= x 1)
    §B{acc:i32} (+ (* x 5) y)
    §IF{if01} (> acc 25292)
      §R (+ acc 25292)
    §EL
      §R (+ (* acc 2) 25292)

  §F{f002:l3m31_fn02:pub} (i32:x, i32:y) -> i32
    §E{}
    §Q (>= y 0)
    §S (>= result x)
    §S (>= result 25299)
    §IF{if02} (>= x 25299)
      §R x
    §EL
      §R 25299

  §F{f003:l3m31_fn03:pub} (i32:x, i32:y) -> i32
    §E{}
    §Q (>= x 4)
    §Q (>= y 0)
    §S (>= result 25306)
    §B{total:i32} (+ (* x 3) y)
    §IF{if03} (< total 25306)
      §R 25306
    §EL
      §R total

  §F{f004:l3m31_fn04:pub} (i32:x, i32:y) -> i32
    §E{}
