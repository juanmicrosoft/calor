§M{m128:L1M28}

  §F{f001:l1m28_fn01:pub} (i32:x, i32:y) -> i32
    §E{}
    §B{v1:i32} §C{l2m09_fn10} §A x §A INT:31 §/C
    §B{v2:i32} §C{l2m19_fn10} §A x §A INT:71 §/C
    §R (+ (+ v1 v2) y)

  §F{f002:l1m28_fn02:pub} (i32:x, i32:y) -> i32
    §E{}
    §Q (>= x 6)
    §Q (>= y 0)
    §S (>= x 4)
    §B{acc:i32} (+ (* x 5) y)
    §IF{if02} (> acc 21442)
      §R (+ acc 21442)
    §EL
      §R (+ (* acc 2) 21442)

