    §R (+ v1 y)

  §F{f005:l2m22_fn05:pub} (i32:x, i32:y) -> i32
    §E{}
    §Q (> x 4)
    §S (>= x 5)
    §B{acc:i32} (+ (* x 2) y)
    §IF{if05} (> acc 22863)
      §R (+ acc 22863)
    §EL
      §R (+ (* acc 2) 22863)

  §F{f006:l2m22_fn06:pub} (i32:x, i32:y) -> i32
    §E{}
    §B{v1:i32} §C{l3m06_fn06} §A x §A INT:69 §/C
