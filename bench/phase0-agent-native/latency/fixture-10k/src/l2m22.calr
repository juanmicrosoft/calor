  §F{f011:l2m22_fn11:pub} (i32:x, i32:y) -> i32
    §E{}
    §B{v1:i32} §C{l3m04_fn02} §A x §A INT:37 §/C
    §R (+ v1 y)

  §F{f012:l2m22_fn12:pub} (i32:x, i32:y) -> i32
    §E{}
    §Q (>= y 0)
    §S (>= result x)
    §S (>= result 22884)
    §IF{if12} (>= x 22884)
      §R x
    §EL
