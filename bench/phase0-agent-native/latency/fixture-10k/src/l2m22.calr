§M{m222:L2M22}

  §F{f001:l2m22_fn01:pub} (i32:x, i32:y) -> i32
    §E{}
    §B{v1:i32} §C{l3m20_fn01} §A x §A INT:8 §/C
    §B{v2:i32} §C{l3m25_fn01} §A x §A INT:35 §/C
    §R (+ (+ v1 v2) y)

  §F{f002:l2m22_fn02:pub} (i32:x, i32:y) -> i32
    §E{}
    §Q (>= x 0)
    §S (<= result 22849)
    §B{total:i32} (+ (* x 5) y)
    §IF{if02} (> total 22849)
      §R 22849
    §R total

  §F{f003:l2m22_fn03:pub} (i32:x, i32:y) -> i32
    §E{}
    §Q (>= x 0)
    §S (<= result 22856)
    §B{total:i32} (+ (* x 2) y)
    §IF{if03} (> total 22856)
      §R 22856
    §R total

  §F{f004:l2m22_fn04:pub} (i32:x, i32:y) -> i32
    §E{}
