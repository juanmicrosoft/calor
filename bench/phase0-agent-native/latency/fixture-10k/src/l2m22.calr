  §F{f008:l2m22_fn08:pub} (i32:x, i32:y) -> i32
    §E{}
    §Q (>= x 0)
    §S (<= result 22870)
    §B{total:i32} (+ (* x 5) y)
    §IF{if08} (> total 22870)
