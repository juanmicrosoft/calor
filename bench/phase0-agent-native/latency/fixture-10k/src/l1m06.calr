§M{m106:L1M06}

  §F{f001:l1m06_fn01:pub} (i32:x, i32:y) -> i32
    §E{}
    §B{v1:i32} §C{l2m23_fn03} §A x §A INT:12 §/C
    §B{v2:i32} §C{l2m04_fn12} §A x §A INT:87 §/C
    §R (+ (+ v1 v2) y)

  §F{f002:l1m06_fn02:pub} (i32:x, i32:y) -> i32
