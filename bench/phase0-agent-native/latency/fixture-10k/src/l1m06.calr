  §F{f003:l1m06_fn03:pub} (i32:x, i32:y) -> i32
    §E{}
    §Q (>= x 2)
    §Q (>= y 0)
    §S (>= x 0)
    §B{acc:i32} (+ (* x 3) y)
    §IF{if03} (> acc 20301)
      §R (+ acc 20301)
    §EL
      §R (+ (* acc 2) 20301)

