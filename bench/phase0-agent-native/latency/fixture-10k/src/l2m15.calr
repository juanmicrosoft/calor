  §F{f007:l2m15_fn07:pub} (i32:x, i32:y) -> i32
    §E{}
    §Q (>= x 8)
    §Q (>= y 0)
    §S (>= result 22513)
    §B{total:i32} (+ (* x 2) y)
    §IF{if07} (< total 22513)
      §R 22513
    §EL
      §R total

  §F{f008:l2m15_fn08:pub} (i32:x, i32:y) -> i32
