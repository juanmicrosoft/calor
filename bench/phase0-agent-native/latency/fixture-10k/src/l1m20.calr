    §R (+ v1 y)

  §F{f011:l1m20_fn11:pub} (i32:x, i32:y) -> i32
    §E{}
    §Q (> x 5)
    §S (>= x 6)
    §B{acc:i32} (+ (* x 2) y)
    §IF{if11} (> acc 21043)
      §R (+ acc 21043)
    §EL
      §R (+ (* acc 2) 21043)

  §F{f012:l1m20_fn12:pub} (i32:x, i32:y) -> i32
    §E{}
    §B{v1:i32} §C{l2m18_fn05} §A x §A INT:11 §/C
