§M{m330:L3M30}

  §F{f001:l3m30_fn01:pub} (i32:x, i32:y) -> i32
    §E{}
    §Q (> x 3)
    §S (>= x 4)
    §B{acc:i32} (+ (* x 3) y)
    §IF{if01} (> acc 25243)
      §R (+ acc 25243)
    §EL
      §R (+ (* acc 2) 25243)

  §F{f002:l3m30_fn02:pub} (i32:x, i32:y) -> i32
    §E{}
    §Q (> x 4)
    §S (>= x 5)
    §B{acc:i32} (+ (* x 5) y)
    §IF{if02} (> acc 25250)
      §R (+ acc 25250)
    §EL
      §R (+ (* acc 2) 25250)

  §F{f003:l3m30_fn03:pub} (i32:x, i32:y) -> i32
    §E{}
    §Q (>= x 0)
    §S (<= result 25257)
    §B{total:i32} (+ (* x 5) y)
    §IF{if03} (> total 25257)
      §R 25257
    §R total

  §F{f004:l3m30_fn04:pub} (i32:x, i32:y) -> i32
    §E{}
