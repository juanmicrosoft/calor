§M{m133:L1M33}

  §F{f001:l1m33_fn01:pub} (i32:x, i32:y) -> i32
    §E{}
    §Q (>= x 6)
    §Q (>= y 0)
    §S (>= x 4)
    §B{acc:i32} (+ (* x 3) y)
    §IF{if01} (> acc 21715)
      §R (+ acc 21715)
    §EL
      §R (+ (* acc 2) 21715)

