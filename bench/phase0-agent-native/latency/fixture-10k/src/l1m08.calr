§M{m108:L1M08}

  §F{f001:l1m08_fn01:pub} (i32:x, i32:y) -> i32
    §E{}
    §B{v1:i32} §C{l2m33_fn09} §A x §A INT:7 §/C
    §R (+ v1 y)

  §F{f002:l1m08_fn02:pub} (i32:x, i32:y) -> i32
    §E{}
    §Q (>= x 2)
    §Q (>= y 0)
    §S (>= x 0)
    §B{acc:i32} (+ (* x 3) y)
    §IF{if02} (> acc 20441)
      §R (+ acc 20441)
    §EL
      §R (+ (* acc 2) 20441)

