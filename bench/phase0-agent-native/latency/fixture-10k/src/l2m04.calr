    §B{v2:i32} §C{l3m12_fn03} §A x §A INT:17 §/C
    §R (+ (+ v1 v2) y)

  §F{f003:l2m04_fn03:pub} (i32:x, i32:y) -> i32
    §E{}
    §Q (>= x 8)
    §Q (>= y 0)
    §S (>= x 6)
    §B{acc:i32} (+ (* x 5) y)
    §IF{if03} (> acc 22030)
      §R (+ acc 22030)
    §EL
      §R (+ (* acc 2) 22030)

  §F{f004:l2m04_fn04:pub} (i32:x, i32:y) -> i32
