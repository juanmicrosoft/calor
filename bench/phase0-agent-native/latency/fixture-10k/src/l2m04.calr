§M{m204:L2M04}

  §F{f001:l2m04_fn01:pub} (i32:x, i32:y) -> i32
    §E{}
    §B{v1:i32} §C{l3m29_fn01} §A x §A INT:40 §/C
    §B{v2:i32} §C{l3m09_fn02} §A x §A INT:74 §/C
    §R (+ (+ v1 v2) y)

  §F{f002:l2m04_fn02:pub} (i32:x, i32:y) -> i32
    §E{}
