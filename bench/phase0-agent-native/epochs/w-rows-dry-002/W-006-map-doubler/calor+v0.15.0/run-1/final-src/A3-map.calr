§M{m001:MapAfter}
  §F{f001:Map:pub}<eff e> ([i32]:xs, Func<i32,i32>:f §E{e}) -> [i32]
    §E{e, alloc, mut}
    §B{n:i32} (len xs)
    §B{~out:[i32]} §ARR{i32} n
    §B{hi:i32} (- n INT:1)
    §L{l1:i:0:hi:1}
      §SETIDX{out} i §C{f} §A §IDX xs i §/C
    §R out

  §F{f002:Double:pub} (i32:x) -> i32
    §E{}
    §R (* x INT:2)

  §F{f003:Announce:pub} (i32:x) -> i32
    §E{cw}
    §P x
    §R x

  §F{f004:UsePure:pub} ([i32]:xs) -> [i32]
    §E{alloc, mut}
    §R §C{Map} §A xs §A Double §/C

  §F{f005:UseImpure:pub} ([i32]:xs) -> [i32]
    §E{alloc, mut, cw}
    §R §C{Map} §A xs §A Announce §/C

  §CL{c001:Doubler:pub}
    §FLD{Func<i32,i32>:_stage:priv} §E{}

    §CTOR{ctor001:pub}
      §ASSIGN _stage MapAfterModule.Double

    §MT{mt001:Loud:pub} ([i32]:xs) -> [i32]
      §E{alloc, mut, cw}
      §R §C{Map} §A §C{Map} §A xs §A _stage §/C §A MapAfterModule.Announce §/C

    §MT{mt002:Twice:pub} ([i32]:xs) -> [i32]
      §E{alloc, mut}
      §R §C{Map} §A §C{Map} §A xs §A _stage §/C §A _stage §/C
