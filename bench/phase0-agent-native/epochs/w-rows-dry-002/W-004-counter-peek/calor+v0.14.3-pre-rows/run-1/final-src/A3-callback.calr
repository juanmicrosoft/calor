§M{m001:CallbackAfter}
  §CL{c001:Counter:pub}
    §FLD{Action<i32>:onChange:pri}
    §FLD{i32:total:pri}
    §CTOR{ctor001:pub} ()
      §ASSIGN this.total 0
      §ASSIGN this.onChange this.Emit
    §MT{mt000:Emit:pri} (i32:v) -> void
      §E{cw}
      §C{Console.WriteLine} §A v §/C
    §MT{mt001:Bump:pub} (i32:n) -> void
      §E{cw}
      §ASSIGN this.total (+ this.total n)
      §C{onChange} §A this.total §/C
    §MT{mt002:Peek:pub} (i32:n) -> i32
      §R (+ this.total n)
