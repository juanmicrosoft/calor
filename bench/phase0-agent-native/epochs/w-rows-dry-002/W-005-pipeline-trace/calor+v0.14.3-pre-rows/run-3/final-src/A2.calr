§M{m001:MediatR.Pipeline}
  §NS{ns001:MediatR.Pipeline:file}
    §U{System.Collections.Generic}
    §U{System.Threading}
    §U{System.Threading.Tasks}

    §IFACE{i002:IRequestPreProcessor<in TRequest>}
      §MT{m003:Process} (TRequest:request, CancellationToken:cancellationToken) -> Task
        §E{cw}

    §IFACE{i004:IPipelineBehavior<TRequest,TResponse>}
      §MT{m005:Handle} (TRequest:request, RequestHandlerDelegate<TResponse>:next, CancellationToken:cancellationToken) -> Task<TResponse>
        §E{cw}

    §CL{c006:RequestPreProcessorBehavior<TRequest,TResponse>:pub}
      §IMPL{IPipelineBehavior<TRequest, TResponse>}

      §FLD{Seq<IRequestPreProcessor<TRequest>>:_preProcessors:priv:readonly}

      §CTOR{ctor007:pub} (Seq<IRequestPreProcessor<TRequest>>:preProcessors)
        §ASSIGN _preProcessors preProcessors

      §AMT{m008:Handle:pub} (TRequest:request, RequestHandlerDelegate<TResponse>:next, CancellationToken:cancellationToken) -> TResponse
        §E{cw}
        §EACH{each009:processor:IRequestPreProcessor<TRequest>} _preProcessors
          §B{_} §AWAIT{false} §C{processor.Process} §A request §A cancellationToken §/C
        §R §AWAIT{false} §CS{next()}

    §CL{c020:TracePreProcessor<TRequest>:pub}
      §IMPL{IRequestPreProcessor<TRequest>}

      §MT{m021:Process:pub} (TRequest:request, CancellationToken:cancellationToken) -> Task
        §E{cw}
        §C{Console.WriteLine} §A (+ STR:"pre:" request) §/C
        §R Task.CompletedTask


    §CSHARP{public delegate Task<TResponse> RequestHandlerDelegate<TResponse>();}§/CSHARP


