§M{m001:CsvRow}
  §F{f001:NeedsQuoting:pub} (str:field) -> bool
    §E{}
    §R (|| (contains field ",") (|| (contains field "\"") (|| (contains field "\r") (contains field "\n"))))

  §F{f002:EscapeField:pub} (str:field) -> str
    §E{}
    §B{q:bool} §C{NeedsQuoting} §A field §/C
    §IF{if1} q
      §B{doubled:str} (replace field "\"" "\"\"")
      §R (+ "\"" (+ doubled "\""))
    §R field

  §F{f003:JoinRow:pub} (List<str>:fields) -> str
    §E{}
    §B{~result:str} ""
    §B{~first:bool} true
    §EACH{e1:f} fields
      §IF{if1} first
        §ASSIGN first false
      §EL
        §ASSIGN result (+ result ",")
      §B{esc:str} §C{EscapeField} §A f §/C
      §ASSIGN result (+ result esc)
    §R result

  §F{f004:SplitRow:pub} (str:line) -> List<str>
    §E{mut}
    §B{n:i32} (len line)
    §LIST{result:str}
    §/LIST{result}
    §B{~i:i32} 0
    §B{~more:bool} true
    §WH{w1} more
      §B{~cur:str} ""
      §IF{ifq} (&& (< i n) (== (substr line i 1) "\""))
        §ASSIGN i (+ i 1)
        §B{~inq:bool} true
        §WH{w2} inq
          §IF{ife} (>= i n)
            §ASSIGN inq false
          §EI (== (substr line i 1) "\"")
            §IF{ifd} (&& (< (+ i 1) n) (== (substr line (+ i 1) 1) "\""))
              §ASSIGN cur (+ cur "\"")
              §ASSIGN i (+ i 2)
            §EL
              §ASSIGN i (+ i 1)
              §ASSIGN inq false
          §EL
            §ASSIGN cur (+ cur (substr line i 1))
            §ASSIGN i (+ i 1)
      §EL
        §WH{w3} (&& (< i n) (! (== (substr line i 1) ",")))
          §ASSIGN cur (+ cur (substr line i 1))
          §ASSIGN i (+ i 1)
      §PUSH{result} cur
      §IF{ifc} (&& (< i n) (== (substr line i 1) ","))
        §ASSIGN i (+ i 1)
        §ASSIGN more true
      §EL
        §ASSIGN more false
    §R result
