§M{m001:MiddlewareAfter}
  §F{f001:RunTwice:pub}<eff e> (Func<i32>:g §E{e}) -> i32
    §E{e}
    §B{first:i32} §C{g}
    §B{second:i32} §C{g}
    §R (+ first second)

  §F{f002:Beat:pub} () -> i32
    §E{cw}
    §C{Console.WriteLine} §A "beat" §/C
    §R 1

  §IFACE{i001:IPipelineBehavior}
    §MT{mt001:Handle}<eff e> (i32:request, Func<i32>:next §E{e}) -> i32
      §E{e}

  §CL{c001:RetryBehavior:pub}
    §IMPL{IPipelineBehavior}
    §FLD{Func<i32>:_step:priv} §E{}
    §CTOR{ctor1:pub} ()
      §ASSIGN this._step §LAM{ls} §R 1 §/LAM{ls}
    §MT{mt002:Handle:pub}<eff e> (i32:request, Func<i32>:next §E{e}) -> i32
      §E{e}
      §R §C{RunTwice} §A next §/C
    §MT{mt003:Probe:pub} () -> i32
      §E{cw}
      §B{b:Func<i32>} §E{cw} §LAM{lp} §R §C{Beat} §/LAM{lp}
      §R §C{RunTwice} §A b §/C
    §MT{mt004:Twice:pub} () -> i32
      §E{}
      §B{s:Func<i32>} §E{} this._step
      §R §C{RunTwice} §A s §/C
