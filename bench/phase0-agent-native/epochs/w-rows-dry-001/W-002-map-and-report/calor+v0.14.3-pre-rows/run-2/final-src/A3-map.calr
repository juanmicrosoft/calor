§M{m001:MapAfter}
  §F{f001:Map:pub} ([i32]:xs, Func<i32,i32>:f) -> [i32]
    §E{alloc, mut}
    §B{n:i32} (len xs)
    §B{~out:[i32]} §ARR{i32} n
    §B{hi:i32} (- n INT:1)
    §L{l1:i:0:hi:1}
      §SETIDX{out} i §C{f} §A §IDX xs i §/C
    §R out

  §F{f002:Double:pub} (i32:x) -> i32
    §E{}
    §R (* x INT:2)

  §F{f003:Announce:pub} (i32:x) -> i32
    §E{cw}
    §P x
    §R x

  §F{f004:UsePure:pub} ([i32]:xs) -> [i32]
    §E{alloc, mut}
    §R §C{Map} §A xs §A Double §/C

  §F{f005:UseImpure:pub} ([i32]:xs) -> [i32]
    §E{alloc, mut, cw}
    §R §C{Map} §A xs §A Announce §/C

  §F{f006:DoubleAndReport:pub} (i32:x) -> i32
    §E{cw}
    §R §C{Announce} §A §C{Double} §A x §/C §/C

  §F{f007:MapAndReport:pub} ([i32]:xs) -> [i32]
    §E{alloc, mut, cw}
    §R §C{Map} §A xs §A DoubleAndReport §/C

  §F{f008:Total:pub} ([i32]:xs) -> i32
    §E{alloc, mut}
    §B{doubled:[i32]} §C{Map} §A xs §A Double §/C
    §B{m:i32} (len doubled)
    §B{hi:i32} (- m INT:1)
    §B{~s:i32} INT:0
    §L{l2:i:0:hi:1}
      §ASSIGN s (+ s §IDX doubled i)
    §R s
