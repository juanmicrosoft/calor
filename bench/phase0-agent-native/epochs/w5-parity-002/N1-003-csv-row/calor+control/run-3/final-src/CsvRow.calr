§M{m001:CsvRow}
  §F{f001:NeedsQuoting:pub} (str:field) -> bool
    §E{}
    §R (|| (contains field ",") (|| (contains field "\"") (|| (contains field "\r") (contains field "\n"))))

  §F{f002:EscapeField:pub} (str:field) -> str
    §E{}
    §B{q:bool} §C{NeedsQuoting} §A field §/C
    §IF{if1} (! q)
      §R field
    §B{doubled:str} (replace field "\"" "\"\"")
    §R (+ "\"" (+ doubled "\""))

  §F{f003:JoinRow:pub} (List<str>:fields) -> str
    §E{}
    §B{~result:str} ""
    §EACH{e1:f:str:idx} fields
      §IF{if1} (> idx 0)
        §ASSIGN result (+ result ",")
      §B{esc:str} §C{EscapeField} §A f §/C
      §ASSIGN result (+ result esc)
    §R result

  §F{f004:SplitRow:pub} (str:line) -> List<str>
    §E{mut,alloc}
    §LIST{result:str}
    §/LIST{result}
    §B{n:i32} (len line)
    §B{~i:i32} 0
    §B{~more:bool} true
    §WH{w1} more
      §B{~field:str} ""
      §IF{ifq} (&& (< i n) (equals (substr line i 1) "\""))
        §ASSIGN i (+ i 1)
        §B{~inq:bool} true
        §WH{w2} inq
          §IF{ife} (>= i n)
            §ASSIGN inq false
          §EI (equals (substr line i 1) "\"")
            §IF{ifd} (&& (< (+ i 1) n) (equals (substr line (+ i 1) 1) "\""))
              §ASSIGN field (+ field "\"")
              §ASSIGN i (+ i 2)
            §EL
              §ASSIGN i (+ i 1)
              §ASSIGN inq false
          §EL
            §ASSIGN field (+ field (substr line i 1))
            §ASSIGN i (+ i 1)
      §EL
        §WH{w3} (&& (< i n) (! (equals (substr line i 1) ",")))
          §ASSIGN field (+ field (substr line i 1))
          §ASSIGN i (+ i 1)
      §PUSH{result} field
      §IF{ifc} (&& (< i n) (equals (substr line i 1) ","))
        §ASSIGN i (+ i 1)
        §IF{ift} (>= i n)
          §PUSH{result} ""
          §ASSIGN more false
      §EL
        §ASSIGN more false
    §R result
