§M{m001:CsvRow}
  §F{f001:NeedsQuoting:pub} (str:field) -> bool
    §E{}
    §R (|| (contains field ",") (|| (contains field "\"") (|| (contains field "\r") (contains field "\n"))))
  §F{f002:EscapeField:pub}
    §I{str:field}
    §O{str}
    §E{}
    §B{q} §C{NeedsQuoting} field
    §IF{if1} q
      §R (concat "\"" (concat (replace field "\"" "\"\"") "\""))
    §EL
      §R field
  §F{f003:JoinRow:pub}
    §I{List<str>:fields}
    §O{str}
    §E{}
    §B{n} §CNT fields
    §B{~result} STR:""
    §B{~i} INT:0
    §WH{wh1} (< i n)
      §B{f} §IDX fields i
      §B{esc} §C{EscapeField} f
      §IF{if2} (> i 0)
        §ASSIGN result (concat result (concat "," esc))
      §EL
        §ASSIGN result (concat result esc)
      §ASSIGN i (+ i 1)
    §R result
  §F{f004:SplitRow:pub}
    §I{str:line}
    §O{List<str>}
    §E{mut}
    §LIST{result:str}
    §/LIST{result}
    §B{n} (len line)
    §B{~i} INT:0
    §B{~more} BOOL:true
    §WH{wh2} more
      §B{~field} STR:""
      §IF{if3} (&& (< i n) (== (char-code (char-at line i)) 34))
        §ASSIGN i (+ i 1)
        §B{~inq} BOOL:true
        §WH{wh3} inq
          §IF{if4} (>= i n)
            §ASSIGN inq false
          §EI (== (char-code (char-at line i)) 34)
            §IF{if5} (&& (< (+ i 1) n) (== (char-code (char-at line (+ i 1))) 34))
              §ASSIGN field (concat field "\"")
              §ASSIGN i (+ i 2)
            §EL
              §ASSIGN i (+ i 1)
              §ASSIGN inq false
          §EL
            §ASSIGN field (concat field (str (char-at line i)))
            §ASSIGN i (+ i 1)
      §EL
        §B{~inf} BOOL:true
        §WH{wh4} inf
          §IF{if6} (>= i n)
            §ASSIGN inf false
          §EI (== (char-code (char-at line i)) 44)
            §ASSIGN inf false
          §EL
            §ASSIGN field (concat field (str (char-at line i)))
            §ASSIGN i (+ i 1)
      §PUSH{result} field
      §IF{if7} (&& (< i n) (== (char-code (char-at line i)) 44))
        §ASSIGN i (+ i 1)
      §EL
        §ASSIGN more false
    §R result
