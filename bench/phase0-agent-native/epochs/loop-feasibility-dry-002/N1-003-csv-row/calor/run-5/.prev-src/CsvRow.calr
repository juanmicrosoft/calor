§M{m001:CsvRow}
  §F{f001:NeedsQuoting:pub} (str:field) -> bool
    §E{}
    §R (|| (contains field ",") (|| (contains field "\"") (|| (contains field "\r") (contains field "\n"))))

  §F{f002:EscapeField:pub} (str:field) -> str
    §E{}
    §B{nq:bool} §C{NeedsQuoting} field
    §IF{if1} nq
      §R (+ "\"" (+ (replace field "\"" "\"\"") "\""))
    §EL
      §R field

  §F{f003:JoinRow:pub} (List<str>:fields) -> str
    §E{}
    §B{~result:str} ""
    §B{~first:bool} true
    §EACH{e1:field} fields
      §IF{if1} first
        §ASSIGN first false
      §EL
        §ASSIGN result (+ result ",")
      §B{esc:str} §C{EscapeField} field
      §ASSIGN result (+ result esc)
    §R result

  §F{f004:SplitRow:pub} (str:line) -> List<str>
    §E{mut}
    §B{result:List<str>} §NEW{List<str>} §/NEW
    §B{~current:str} ""
    §B{~inq:bool} false
    §B{n:i32} (len line)
    §B{~i:i32} INT:0
    §WH{w1} (< i n)
      §B{ch:str} (substr line i INT:1)
      §IF{if1} inq
        §IF{if2} (== ch "\"")
          §IF{if3} (&& (< (+ i INT:1) n) (== (substr line (+ i INT:1) INT:1) "\""))
            §ASSIGN current (+ current "\"")
            §ASSIGN i (+ i INT:2)
          §EL
            §ASSIGN inq false
            §ASSIGN i (+ i INT:1)
        §EL
          §ASSIGN current (+ current ch)
          §ASSIGN i (+ i INT:1)
      §EL
        §IF{if4} (== ch ",")
          §PUSH{result} current
          §ASSIGN current ""
          §ASSIGN i (+ i INT:1)
        §EI (== ch "\"")
          §ASSIGN inq true
          §ASSIGN i (+ i INT:1)
        §EL
          §ASSIGN current (+ current ch)
          §ASSIGN i (+ i INT:1)
    §PUSH{result} current
    §R result
