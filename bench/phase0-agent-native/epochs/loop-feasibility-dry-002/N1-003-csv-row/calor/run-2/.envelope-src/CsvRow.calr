§M{m001:CsvRow}
  §F{f001:NeedsQuoting:pub} (str:field) -> bool
    §E{}
    §R (|| (contains field ",") (|| (contains field "\"") (|| (contains field "\r") (contains field "\n"))))

  §F{f002:EscapeField:pub} (str:field) -> str
    §E{}
    §B{q:bool} §C{NeedsQuoting} §A field §/C
    §IF{if1} q
      §R (+ "\"" (+ (replace field "\"" "\"\"") "\""))
    §R field

  §F{f003:JoinRow:pub} (List<str>:fields) -> str
    §E{}
    §B{~result:str} ""
    §B{~first:bool} true
    §EACH{e1:f} fields
      §IF{if2} (! first)
        §ASSIGN result (+ result ",")
      §ASSIGN first false
      §B{esc:str} §C{EscapeField} §A f §/C
      §ASSIGN result (+ result esc)
    §R result

  §F{f004:SplitRow:pub} (str:line) -> List<str>
    §E{mut}
    §LIST{result:str}
    §/LIST{result}
    §B{n:i32} (len line)
    §B{~i:i32} 0
    §B{~more:bool} true
    §WH{w1} more
      §ASSIGN more false
      §B{~field:str} ""
      §IF{if3} (&& (< i n) (== (substr line i 1) "\""))
        §ASSIGN i (+ i 1)
        §B{~done:bool} false
        §WH{w2} (! done)
          §B{cur:str} (substr line i 1)
          §IF{if4} (== cur "\"")
            §IF{if5} (&& (< (+ i 1) n) (== (substr line (+ i 1) 1) "\""))
              §ASSIGN field (+ field "\"")
              §ASSIGN i (+ i 2)
            §EL
              §ASSIGN i (+ i 1)
              §ASSIGN done true
          §EL
            §ASSIGN field (+ field cur)
            §ASSIGN i (+ i 1)
      §EL
        §WH{w3} (&& (< i n) (!= (substr line i 1) ","))
          §ASSIGN field (+ field (substr line i 1))
          §ASSIGN i (+ i 1)
      §PUSH{result} field
      §IF{if6} (&& (< i n) (== (substr line i 1) ","))
        §ASSIGN i (+ i 1)
        §ASSIGN more true
    §R result
