#!/usr/bin/env bash
set -uo pipefail
if [[ "${CALOR_P0_SHIM_OFF:-0}" == "1" ]]; then exec "/opt/homebrew/bin/dotnet" "$@"; fi

# Portable millisecond clock: BSD date has no %N (the harness runs on macOS
# AND Linux), so prefer perl/python3 and degrade to whole seconds last.
now_ms() {
  if command -v perl >/dev/null 2>&1; then
    perl -MTime::HiRes=time -e 'printf("%d", time()*1000)'
  elif command -v python3 >/dev/null 2>&1; then
    python3 -c 'import time,sys;sys.stdout.write(str(int(time.time()*1000)))'
  else
    echo $(( $(date +%s) * 1000 ))
  fi
}

arm="calor"
ts_iso="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
t0=$(now_ms)
"/opt/homebrew/bin/dotnet" "$@"; rc=$?
# feedback_latency_ms is stamped HERE — the moment the agent-visible dotnet
# returns. Everything below (silent src rebuild, held-out suite, envelope
# capture, id attribution) is harness observation the agent never sees in this
# invocation's output, and the held-out cost is arm-asymmetric (the calor arm
# build drives the full Calor.Tasks pipeline) — including it would bias the
# latency comparison (review of #758 item 2; CLAUDE.md benchmark-fairness).
lat=$(( $(now_ms) - t0 )); [[ $lat -lt 0 ]] && lat=0
case "${1:-}" in
  build|test|run)
    # Serialize the telemetry section: .lasthash/.itercount are read-modify-
    # write and journal.jsonl is appended — concurrent dotnet invocations
    # would corrupt iteration ordinals (review of #758 minor 2). mkdir is the
    # portable atomic lock; on timeout we proceed unlocked (degrades to the
    # pre-lock behavior rather than deadlocking the agent).
    lock_tries=0
    while ! mkdir "/Users/juanrivera/sources/repos/juanmicrosoft/calor/bench/phase0-agent-native/epochs/loop-feasibility-dry-002/W2-005-scheduler/calor/run-4/.telemetry.lock" 2>/dev/null; do
      lock_tries=$((lock_tries+1))
      [[ $lock_tries -gt 1200 ]] && break
      sleep 0.05
    done
    trap 'rmdir "/Users/juanrivera/sources/repos/juanmicrosoft/calor/bench/phase0-agent-native/epochs/loop-feasibility-dry-002/W2-005-scheduler/calor/run-4/.telemetry.lock" 2>/dev/null || true' EXIT

    # bin/obj are excluded: generated outputs (e.g. the calor arm's obj/calor/
    # *.g.cs) would otherwise flip the hash on the first build and journal a
    # phantom edited:true iteration with zero agent edits
    hash=$(find "/private/var/folders/6k/p_3c7f5s7qx5_0shc1rx5fwr0000gn/T/p0-W2-005-scheduler-calor-J5lCpz/src" -type f \( -name '*.cs' -o -name '*.calr' \) -not -path '*/obj/*' -not -path '*/bin/*' -exec shasum {} + 2>/dev/null | shasum | cut -d' ' -f1)
    prev=$(cat "/Users/juanrivera/sources/repos/juanmicrosoft/calor/bench/phase0-agent-native/epochs/loop-feasibility-dry-002/W2-005-scheduler/calor/run-4/.lasthash" 2>/dev/null || echo none)
    edited=$([[ "$hash" != "$prev" ]] && echo true || echo false)
    echo "$hash" > "/Users/juanrivera/sources/repos/juanmicrosoft/calor/bench/phase0-agent-native/epochs/loop-feasibility-dry-002/W2-005-scheduler/calor/run-4/.lasthash"

    # iteration: 1-based ordinal among edited invocations (counter persisted
    # next to .lasthash); JSON null for unedited observations (gates doc §2)
    iteration=null
    if [[ "$edited" == "true" ]]; then
      iteration=$(( $(cat "/Users/juanrivera/sources/repos/juanmicrosoft/calor/bench/phase0-agent-native/epochs/loop-feasibility-dry-002/W2-005-scheduler/calor/run-4/.itercount" 2>/dev/null || echo 0) + 1 ))
      echo "$iteration" > "/Users/juanrivera/sources/repos/juanmicrosoft/calor/bench/phase0-agent-native/epochs/loop-feasibility-dry-002/W2-005-scheduler/calor/run-4/.itercount"
    fi

    # Optional src-tree snapshot keyed by src_tree_hash (reject-replay, D4.6).
    # Off by default; enabled with CALOR_LOOP_SNAPSHOTS=1.
    if [[ "${CALOR_LOOP_SNAPSHOTS:-0}" == "1" && ! -d "/Users/juanrivera/sources/repos/juanmicrosoft/calor/bench/phase0-agent-native/epochs/loop-feasibility-dry-002/W2-005-scheduler/calor/run-4/snapshots/$hash" ]]; then
      mkdir -p "/Users/juanrivera/sources/repos/juanmicrosoft/calor/bench/phase0-agent-native/epochs/loop-feasibility-dry-002/W2-005-scheduler/calor/run-4/snapshots"
      cp -R "/private/var/folders/6k/p_3c7f5s7qx5_0shc1rx5fwr0000gn/T/p0-W2-005-scheduler-calor-J5lCpz/src" "/Users/juanrivera/sources/repos/juanmicrosoft/calor/bench/phase0-agent-native/epochs/loop-feasibility-dry-002/W2-005-scheduler/calor/run-4/snapshots/.tmp-$hash" 2>/dev/null || true
      find "/Users/juanrivera/sources/repos/juanmicrosoft/calor/bench/phase0-agent-native/epochs/loop-feasibility-dry-002/W2-005-scheduler/calor/run-4/snapshots/.tmp-$hash" -type d \( -name bin -o -name obj \) -prune -exec rm -rf {} + 2>/dev/null || true
      mv "/Users/juanrivera/sources/repos/juanmicrosoft/calor/bench/phase0-agent-native/epochs/loop-feasibility-dry-002/W2-005-scheduler/calor/run-4/snapshots/.tmp-$hash" "/Users/juanrivera/sources/repos/juanmicrosoft/calor/bench/phase0-agent-native/epochs/loop-feasibility-dry-002/W2-005-scheduler/calor/run-4/snapshots/$hash" 2>/dev/null || true
    fi

    ho_pass=0; ho_fail=27
    # Fresh, decoupled src build; only if it succeeds is the dll current and
    # the held-out result meaningful (non-compiling state = all failing)
    if CALOR_P0_SHIM_OFF=1 "/opt/homebrew/bin/dotnet" build "/private/var/folders/6k/p_3c7f5s7qx5_0shc1rx5fwr0000gn/T/p0-W2-005-scheduler-calor-J5lCpz/src/Src.csproj" --nologo -v q > "/Users/juanrivera/sources/repos/juanmicrosoft/calor/bench/phase0-agent-native/epochs/loop-feasibility-dry-002/W2-005-scheduler/calor/run-4/.src_build.txt" 2>&1; then
      if CALOR_P0_SHIM_OFF=1 "/opt/homebrew/bin/dotnet" test "/Users/juanrivera/sources/repos/juanmicrosoft/calor/bench/phase0-agent-native/epochs/loop-feasibility-dry-002/W2-005-scheduler/calor/run-4/heldout/HeldOut.csproj" --nologo -v q > "/Users/juanrivera/sources/repos/juanmicrosoft/calor/bench/phase0-agent-native/epochs/loop-feasibility-dry-002/W2-005-scheduler/calor/run-4/.ho_last.txt" 2>&1; then
        ho_fail=0
        ho_pass=$(grep -oE 'Passed:[[:space:]]+[0-9]+' "/Users/juanrivera/sources/repos/juanmicrosoft/calor/bench/phase0-agent-native/epochs/loop-feasibility-dry-002/W2-005-scheduler/calor/run-4/.ho_last.txt" | grep -oE '[0-9]+' | head -1 || echo 0)
      else
        ho_fail=$(grep -oE 'Failed:[[:space:]]+[0-9]+' "/Users/juanrivera/sources/repos/juanmicrosoft/calor/bench/phase0-agent-native/epochs/loop-feasibility-dry-002/W2-005-scheduler/calor/run-4/.ho_last.txt" | grep -oE '[0-9]+' | head -1 || echo 27)
        ho_pass=$(grep -oE 'Passed:[[:space:]]+[0-9]+' "/Users/juanrivera/sources/repos/juanmicrosoft/calor/bench/phase0-agent-native/epochs/loop-feasibility-dry-002/W2-005-scheduler/calor/run-4/.ho_last.txt" | grep -oE '[0-9]+' | head -1 || echo 0)
      fi
    fi

    edit_ids="[]"; diags="[]"; dtrunc=false; env_valid=null

    # edit_target_ids (calor arm, edited only): per changed .calr file, run
    # `calor ids index` on the CURRENT file and take the IDs whose
    # approximate line span intersects the changed-line ranges vs the
    # previous-iteration copy under .prev-src/ (line-range attribution;
    # precision limits documented in telemetry-helpers.py). Files deleted
    # since the previous iteration have no current-file IDs to attribute and
    # are skipped. C# arm: no .calr files change, so this stays [].
    if [[ "$arm" == "calor" && "$edited" == "true" && -n "/Users/juanrivera/sources/repos/juanmicrosoft/calor/src/Calor.Compiler/bin/Release/net10.0/calor.dll" ]] && command -v python3 >/dev/null 2>&1; then
      while IFS= read -r rel; do
        cur="/private/var/folders/6k/p_3c7f5s7qx5_0shc1rx5fwr0000gn/T/p0-W2-005-scheduler-calor-J5lCpz/src/$rel"; prevf="/Users/juanrivera/sources/repos/juanmicrosoft/calor/bench/phase0-agent-native/epochs/loop-feasibility-dry-002/W2-005-scheduler/calor/run-4/.prev-src/$rel"
        if [[ ! -f "$prevf" ]] || ! cmp -s "$prevf" "$cur"; then
          if CALOR_P0_SHIM_OFF=1 "/opt/homebrew/bin/dotnet" "/Users/juanrivera/sources/repos/juanmicrosoft/calor/src/Calor.Compiler/bin/Release/net10.0/calor.dll" ids index "$cur" -o "/Users/juanrivera/sources/repos/juanmicrosoft/calor/bench/phase0-agent-native/epochs/loop-feasibility-dry-002/W2-005-scheduler/calor/run-4/.ids-index.json" >/dev/null 2>&1; then
            prev_arg="-"; [[ -f "$prevf" ]] && prev_arg="$prevf"
            file_ids=$(python3 "/Users/juanrivera/sources/repos/juanmicrosoft/calor/bench/phase0-agent-native/telemetry-helpers.py" edit-targets "$prev_arg" "$cur" "/Users/juanrivera/sources/repos/juanmicrosoft/calor/bench/phase0-agent-native/epochs/loop-feasibility-dry-002/W2-005-scheduler/calor/run-4/.ids-index.json" 2>/dev/null || echo "[]")
            edit_ids=$(jq -cn --argjson a "$edit_ids" --argjson b "$file_ids" '$a + $b | unique')
          fi
          mkdir -p "$(dirname "$prevf")"; cp "$cur" "$prevf"
        fi
      done < <(cd "/private/var/folders/6k/p_3c7f5s7qx5_0shc1rx5fwr0000gn/T/p0-W2-005-scheduler-calor-J5lCpz/src" && find . -name '*.calr' -not -path '*/obj/*' -not -path '*/bin/*' | sed 's|^\./||')
    fi

    # diagnostics + envelope_valid (calor arm only): compile the .calr set
    # directly with the calor CLI under the pair's pinned flags
    # (enforce-effects on, permissive off, contract-mode debug) with
    # --format json, and extract up to 50 {code, declarationId} entries.
    # Inputs are COPIES under .envelope-src/ — compiling in place would drop
    # .g.cs next to the agent's sources and flip the next src-tree hash.
    # Cached per src state: re-run only when the tree changed.
    if [[ "$arm" == "calor" && -n "/Users/juanrivera/sources/repos/juanmicrosoft/calor/src/Calor.Compiler/bin/Release/net10.0/calor.dll" ]] && command -v python3 >/dev/null 2>&1; then
      if [[ "$edited" == "true" || ! -s "/Users/juanrivera/sources/repos/juanmicrosoft/calor/bench/phase0-agent-native/epochs/loop-feasibility-dry-002/W2-005-scheduler/calor/run-4/.envelope-meta.json" ]]; then
        rm -rf "/Users/juanrivera/sources/repos/juanmicrosoft/calor/bench/phase0-agent-native/epochs/loop-feasibility-dry-002/W2-005-scheduler/calor/run-4/.envelope-src"; mkdir -p "/Users/juanrivera/sources/repos/juanmicrosoft/calor/bench/phase0-agent-native/epochs/loop-feasibility-dry-002/W2-005-scheduler/calor/run-4/.envelope-src"
        inputs=()
        while IFS= read -r rel; do
          mkdir -p "/Users/juanrivera/sources/repos/juanmicrosoft/calor/bench/phase0-agent-native/epochs/loop-feasibility-dry-002/W2-005-scheduler/calor/run-4/.envelope-src/$(dirname "$rel")"
          cp "/private/var/folders/6k/p_3c7f5s7qx5_0shc1rx5fwr0000gn/T/p0-W2-005-scheduler-calor-J5lCpz/src/$rel" "/Users/juanrivera/sources/repos/juanmicrosoft/calor/bench/phase0-agent-native/epochs/loop-feasibility-dry-002/W2-005-scheduler/calor/run-4/.envelope-src/$rel"
          inputs+=(--input "/Users/juanrivera/sources/repos/juanmicrosoft/calor/bench/phase0-agent-native/epochs/loop-feasibility-dry-002/W2-005-scheduler/calor/run-4/.envelope-src/$rel")
        done < <(cd "/private/var/folders/6k/p_3c7f5s7qx5_0shc1rx5fwr0000gn/T/p0-W2-005-scheduler-calor-J5lCpz/src" && find . -name '*.calr' -not -path '*/obj/*' -not -path '*/bin/*' | sed 's|^\./||')
        if [[ ${#inputs[@]} -gt 0 ]]; then
          CALOR_P0_SHIM_OFF=1 "/opt/homebrew/bin/dotnet" "/Users/juanrivera/sources/repos/juanmicrosoft/calor/src/Calor.Compiler/bin/Release/net10.0/calor.dll" "${inputs[@]}" \
            --enforce-effects --contract-mode debug --no-telemetry --format json \
            > "/Users/juanrivera/sources/repos/juanmicrosoft/calor/bench/phase0-agent-native/epochs/loop-feasibility-dry-002/W2-005-scheduler/calor/run-4/.envelope.json" 2> "/Users/juanrivera/sources/repos/juanmicrosoft/calor/bench/phase0-agent-native/epochs/loop-feasibility-dry-002/W2-005-scheduler/calor/run-4/.envelope.err" || true
          python3 "/Users/juanrivera/sources/repos/juanmicrosoft/calor/bench/phase0-agent-native/telemetry-helpers.py" envelope "/Users/juanrivera/sources/repos/juanmicrosoft/calor/bench/phase0-agent-native/epochs/loop-feasibility-dry-002/W2-005-scheduler/calor/run-4/.envelope.json" > "/Users/juanrivera/sources/repos/juanmicrosoft/calor/bench/phase0-agent-native/epochs/loop-feasibility-dry-002/W2-005-scheduler/calor/run-4/.envelope-meta.json" 2>/dev/null \
            || echo '{"diagnostics":[],"diagnostics_truncated":false,"envelope_valid":false}' > "/Users/juanrivera/sources/repos/juanmicrosoft/calor/bench/phase0-agent-native/epochs/loop-feasibility-dry-002/W2-005-scheduler/calor/run-4/.envelope-meta.json"
        fi
      fi
      if [[ -s "/Users/juanrivera/sources/repos/juanmicrosoft/calor/bench/phase0-agent-native/epochs/loop-feasibility-dry-002/W2-005-scheduler/calor/run-4/.envelope-meta.json" ]]; then
        diags=$(jq -c .diagnostics "/Users/juanrivera/sources/repos/juanmicrosoft/calor/bench/phase0-agent-native/epochs/loop-feasibility-dry-002/W2-005-scheduler/calor/run-4/.envelope-meta.json")
        dtrunc=$(jq -c .diagnostics_truncated "/Users/juanrivera/sources/repos/juanmicrosoft/calor/bench/phase0-agent-native/epochs/loop-feasibility-dry-002/W2-005-scheduler/calor/run-4/.envelope-meta.json")
        env_valid=$(jq -c .envelope_valid "/Users/juanrivera/sources/repos/juanmicrosoft/calor/bench/phase0-agent-native/epochs/loop-feasibility-dry-002/W2-005-scheduler/calor/run-4/.envelope-meta.json")
      fi
    fi

    # apply_verdict / rejected_edit: reserved for the WS2 transactional apply
    # path — always null in the baseline harness (schema doc).
    jq -cn \
      --arg ts "$ts_iso" --arg pair "W2-005-scheduler" --arg armlabel "calor" \
      --argjson run 4 --arg cmd "${1}" --argjson exit "$rc" \
      --argjson edited "$edited" --argjson iteration "$iteration" \
      --argjson lat "$lat" --argjson hp "$ho_pass" --argjson hf "$ho_fail" \
      --arg hash "$hash" --arg mech "raw" \
      --argjson ids "$edit_ids" --argjson diags "$diags" \
      --argjson dtrunc "$dtrunc" --argjson envv "$env_valid" \
      '{schema:"loop-telemetry/2", ts:$ts, pair:$pair, arm:$armlabel,
        run:$run, iteration:$iteration, cmd:$cmd, exit:$exit,
        edited:$edited, feedback_latency_ms:$lat,
        heldout_pass:$hp, heldout_fail:$hf, src_tree_hash:$hash,
        edit_mechanism:$mech, edit_target_ids:$ids,
        diagnostics:$diags, diagnostics_truncated:$dtrunc,
        envelope_valid:$envv, apply_verdict:null, rejected_edit:null}' \
      >> "/Users/juanrivera/sources/repos/juanmicrosoft/calor/bench/phase0-agent-native/epochs/loop-feasibility-dry-002/W2-005-scheduler/calor/run-4/journal.jsonl"
    ;;
esac
exit $rc
