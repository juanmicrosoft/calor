§M{m001:CsvRow}
  §F{f001:NeedsQuoting:pub} (str:field) -> bool
    §E{}
    §R (|| (contains field ",") (|| (contains field "\"") (|| (contains field "\r") (contains field "\n"))))

  §F{f002:EscapeField:pub} (str:field) -> str
    §E{}
    §B{needs:bool} §C{NeedsQuoting} §A field §/C
    §IF{if1} needs
      §R (concat "\"" (replace field "\"" "\"\"") "\"")
    §EL
      §R field

  §F{f003:JoinRow:pub} (List<str>:fields) -> str
    §E{mut,alloc}
    §LIST{parts:str}
    §/LIST{parts}
    §EACH{e1:f} fields
      §B{esc:str} §C{EscapeField} §A f §/C
      §PUSH{parts} esc
    §R (join "," parts)

  §F{f004:SplitRow:pub} (str:line) -> List<str>
    §E{mut,alloc}
    §LIST{result:str}
    §/LIST{result}
    §B{~i:i32} 0
    §B{n:i32} (len line)
    §B{~more:bool} true
    §WH{w1} more
      §B{~field:str} ""
      §IF{ifq} (&& (< i n) (equals (substr line i 1) "\""))
        §ASSIGN i (+ i 1)
        §B{~inq:bool} true
        §WH{w2} inq
          §IF{ife} (>= i n)
            §ASSIGN inq false
          §EI (equals (substr line i 1) "\"")
            §IF{ifd} (&& (< (+ i 1) n) (equals (substr line (+ i 1) 1) "\""))
              §ASSIGN field (concat field "\"")
              §ASSIGN i (+ i 2)
            §EL
              §ASSIGN i (+ i 1)
              §ASSIGN inq false
          §EL
            §ASSIGN field (concat field (substr line i 1))
            §ASSIGN i (+ i 1)
      §EL
        §B{start:i32} i
        §WH{w3} (&& (< i n) (! (equals (substr line i 1) ",")))
          §ASSIGN i (+ i 1)
        §ASSIGN field (substr line start (- i start))
      §PUSH{result} field
      §IF{ifc} (&& (< i n) (equals (substr line i 1) ","))
        §ASSIGN i (+ i 1)
      §EL
        §ASSIGN more false
    §R result
