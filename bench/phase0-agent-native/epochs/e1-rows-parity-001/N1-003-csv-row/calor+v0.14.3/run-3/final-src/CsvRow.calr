§M{m001:CsvRow}
  §F{f001:NeedsQuoting:pub} (str:field) -> bool
    §E{}
    §R (|| (contains field ",") (|| (contains field "\"") (|| (contains field "\r") (contains field "\n"))))

  §F{f002:EscapeField:pub} (str:field) -> str
    §E{}
    §B{nq:bool} §C{NeedsQuoting} §A field §/C
    §IF{if1} (! nq)
      §R field
    §B{doubled:str} (replace field "\"" "\"\"")
    §R (+ "\"" (+ doubled "\""))

  §F{f003:JoinRow:pub} (List<str>:fields) -> str
    §E{}
    §B{~result:str} ""
    §B{n:i32} §CNT{fields}
    §B{~i:i32} 0
    §WH{w1} (< i n)
      §IF{if1} (> i 0)
        §ASSIGN result (+ result ",")
      §B{fld:str} §IDX fields i
      §B{esc:str} §C{EscapeField} §A fld §/C
      §ASSIGN result (+ result esc)
      §ASSIGN i (+ i 1)
    §R result

  §F{f004:SplitRow:pub} (str:line) -> List<str>
    §E{mut,alloc}
    §B{n:i32} (len line)
    §LIST{result:str}
    §/LIST{result}
    §B{~i:i32} 0
    §B{~more:bool} true
    §WH{w1} more
      §B{~field:str} ""
      §IF{if1} (&& (< i n) (equals (substr line i 1) "\""))
        §ASSIGN i (+ i 1)
        §B{~done:bool} false
        §WH{w2} (! done)
          §B{ch:str} (substr line i 1)
          §IF{if2} (equals ch "\"")
            §B{next:str} (? (< (+ i 1) n) (substr line (+ i 1) 1) "")
            §IF{if3} (equals next "\"")
              §ASSIGN field (+ field "\"")
              §ASSIGN i (+ i 2)
            §EL
              §ASSIGN i (+ i 1)
              §ASSIGN done true
          §EL
            §ASSIGN field (+ field ch)
            §ASSIGN i (+ i 1)
      §EL
        §WH{w3} (&& (< i n) (! (equals (substr line i 1) ",")))
          §ASSIGN field (+ field (substr line i 1))
          §ASSIGN i (+ i 1)
      §PUSH{result} field
      §IF{if4} (< i n)
        §ASSIGN i (+ i 1)
      §EL
        §ASSIGN more false
    §R result
