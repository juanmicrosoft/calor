§M{m001:CsvRow}
  §F{f001:NeedsQuoting:pub} (str:field) -> bool
    §E{}
    §R (|| (contains field ",") (|| (contains field "\"") (|| (contains field "\r") (contains field "\n"))))

  §F{f002:EscapeField:pub} (str:field) -> str
    §E{}
    §B{needs:bool} §C{NeedsQuoting} §A field §/C
    §IF{if1} needs
      §B{doubled:str} (replace field "\"" "\"\"")
      §R (+ "\"" (+ doubled "\""))
    §R field

  §F{f003:JoinRow:pub} (List<str>:fields) -> str
    §E{}
    §B{n:i32} §CNT{fields}
    §B{~result:str} ""
    §B{~i:i32} 0
    §WH{w1} (< i n)
      §B{field:str} §IDX fields i
      §B{esc:str} §C{EscapeField} §A field §/C
      §IF{if1} (> i 0)
        §ASSIGN result (+ result ",")
      §ASSIGN result (+ result esc)
      §ASSIGN i (+ i 1)
    §R result

  §F{f004:SplitRow:pub} (str:line) -> List<str>
    §E{mut,alloc}
    §LIST{result:str}
    §/LIST{result}
    §B{n:i32} (len line)
    §B{~i:i32} 0
    §WH{w1} true
      §B{~current:str} ""
      §IF{if1} (&& (< i n) (equals (substr line i 1) "\""))
        §ASSIGN i (+ i 1)
        §WH{w2} (< i n)
          §B{c:str} (substr line i 1)
          §IF{if2} (equals c "\"")
            §IF{if3} (&& (< (+ i 1) n) (equals (substr line (+ i 1) 1) "\""))
              §ASSIGN current (+ current "\"")
              §ASSIGN i (+ i 2)
            §EL
              §ASSIGN i (+ i 1)
              §BK
          §EL
            §ASSIGN current (+ current c)
            §ASSIGN i (+ i 1)
      §EL
        §WH{w3} (&& (< i n) (! (equals (substr line i 1) ",")))
          §ASSIGN current (+ current (substr line i 1))
          §ASSIGN i (+ i 1)
      §PUSH{result} current
      §IF{if4} (&& (< i n) (equals (substr line i 1) ","))
        §ASSIGN i (+ i 1)
      §EL
        §BK
    §R result
