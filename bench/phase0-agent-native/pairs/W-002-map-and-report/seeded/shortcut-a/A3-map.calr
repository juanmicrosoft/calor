§M{m001:MapAfter}
  §F{f001:Map:pub} ([i32]:xs, Func<i32,i32>:f) -> [i32]
    §E{alloc, mut}
    §B{n:i32} (len xs)
    §B{~out:[i32]} §ARR{i32} n
    §L{l1:i:0:(- n 1):1}
      §SETIDX{out} i §C{f} §A §IDX xs i §/C
    §R out

  §F{f002:Double:pub} (i32:x) -> i32
    §E{}
    §R (* x INT:2)

  §F{f003:Announce:pub} (i32:x) -> i32
    §E{cw}
    §P x
    §R x

  §F{f004:UsePure:pub} ([i32]:xs) -> [i32]
    §E{alloc, mut}
    §R §C{Map} §A xs §A Double §/C

  §F{f005:UseImpure:pub} ([i32]:xs) -> [i32]
    §E{alloc, mut, cw}
    §R §C{Map} §A xs §A Announce §/C

  §F{f006:MapAndReport:pub} ([i32]:xs) -> [i32]
    §E{alloc, mut}
    §B{report:Func<i32,i32>} §LAM{lam1:x:i32}
      §B{y:i32} (* x INT:2)
      §P y
      §R y
    §/LAM{lam1}
    §R §C{Map} §A xs §A report §/C

  §F{f007:Total:pub} ([i32]:xs) -> i32
    §E{alloc, mut}
    §B{ys:[i32]} §C{MapAndReport} §A xs §/C
    §B{~sum:i32} INT:0
    §B{n:i32} (len ys)
    §L{l2:i:0:(- n 1):1}
      §B{y:i32} §IDX ys i
      §ASSIGN sum (+ sum y)
    §R sum
