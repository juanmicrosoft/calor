§M{m001:CallbackAfter}
  §F{f001:Show:pub} (i32:v) -> void
    §E{cw}
    §P v

  §CL{c001:Counter:pub}
    §FLD{Action<i32>:onChange:pri} §E{cw}
    §FLD{i32:total:pri}
    §CTOR{ctor001:pub} ()
      §ASSIGN total INT:0
      §ASSIGN onChange CallbackAfterModule.Show
    §MT{mt001:Bump:pub} (i32:n) -> void
      §E{cw, mut}
      §ASSIGN total (+ total n)
      §C{onChange} §A total §/C
    §MT{mt002:Peek:pub} (i32:n) -> i32
      §E{}
      §B{next:i32} (+ total n)
      §C{onChange} §A next §/C
      §R next
