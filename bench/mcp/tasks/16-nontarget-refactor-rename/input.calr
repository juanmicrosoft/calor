module DocumentStore
  class DbContext
    func SaveChanges static () → int
      ! db:w
      return 1

  func Save (string:key, string:content) → bool
    ! db:w
    DbContext.SaveChanges()
    return true

  func Load (string:key) → string
    ! db:r
    return ""

  func SaveAndLog (string:key, string:content) → bool
    ! db:w,cw
    let bool:success = Save(key, content)
    Console.WriteLine("Saved document: " + key)
    return success
