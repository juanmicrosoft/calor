module NotificationService
  class Messenger
    func Post static (string:target, string:payload) → void
      ! net:rw
      return

  class DbContext
    func SaveChanges static () → int
      ! db:w
      return 1

  func SendEmail (string:address | (# != ""), string:subject | (# != ""), string:body) → bool
    ! cw,net:rw
    Console.WriteLine("Sending email to: " + address)
    Messenger.Post(address, body)
    return true

  func SendSms (string:phoneNumber | (# != ""), string:message) → bool
    ! cw,net:rw
    Console.WriteLine("Sending SMS to: " + phoneNumber)
    Messenger.Post(phoneNumber, message)
    return true

  func LogNotification (string:type, string:recipient, bool:success) → void
    ! db:w
    DbContext.SaveChanges()
