module DataService
  using System.IO

  func WriteRecord private (string:key, string:value) → bool
    File.AppendAllText(key, value)
    return true

  func CreateUser (string:name, string:email) → bool
    ! fs:w, cw
    Console.WriteLine("Creating user: " + name)
    let bool:success = WriteRecord("user", name)
    Console.WriteLine("Done")
    return success
