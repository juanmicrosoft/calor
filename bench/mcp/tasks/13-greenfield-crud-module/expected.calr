module UserCrud
  func CreateUser (string:name, string:email) → bool
    ! db:w
    let user = new User { Name = name, Email = email }
    _dbContext.Users.Add(user)
    let result = _dbContext.SaveChanges()
    return result > 0

  func GetUser (int:userId) → User
    ! db:r
    return _dbContext.Users.Find(userId)

  func UpdateUser (int:userId, string:name, string:email) → bool
    ! db:w
    var user = _dbContext.Users.Find(userId)
    set user.Name name
    set user.Email email
    let result = _dbContext.SaveChanges()
    return result > 0

  func DeleteUser (int:userId) → bool
    ! db:w
    let user = _dbContext.Users.Find(userId)
    _dbContext.Users.Remove(user)
    let result = _dbContext.SaveChanges()
    return result > 0
