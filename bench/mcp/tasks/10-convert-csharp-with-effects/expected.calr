module OrderService overflow unchecked
  module OrderService
    func PlaceOrder (DbContext:dbContext, string:product, int:quantity) → bool
      ! db:w,cw
      let order = new Order { Product = product, Quantity = quantity }
      dbContext.Orders.Add(order)
      let result = dbContext.SaveChanges()
      Console.WriteLine("Order placed for ${quantity}x ${product}")
      return result > 0

    func GetOrder (DbContext:dbContext, int:orderId) → Order
      ! db:r
      return dbContext.Orders.Find(orderId)
