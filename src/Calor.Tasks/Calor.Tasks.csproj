<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Calor.Tasks</RootNamespace>
    <IsPackable>true</IsPackable>
    <PackageId>Calor.Tasks</PackageId>
    <Description>MSBuild tasks for compiling Calor source files to C#</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>See https://github.com/juanmicrosoft/calor/blob/main/CHANGELOG.md</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Calor.Tasks.Tests" />
    <InternalsVisibleTo Include="IncrementalBuildBench" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Build.Utilities.Core" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Calor.Compiler\Calor.Compiler.csproj">
      <Private>true</Private>
    </ProjectReference>
  </ItemGroup>

  <!-- Z3 (#1420): the build host's native libz3 reaches this project's output
       ROOT, where the MSBuild task context probes for it, through
       Calor.Compiler's AddZ3AssetsToOutput items like every other consumer.
       The former AfterTargets="Build" side copy read the compiler's source
       directory directly and is gone. -->

</Project>
