<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <InternalsVisibleTo Include="Calor.Compiler.Tests" />
    <InternalsVisibleTo Include="Calor.Enforcement.Tests" />
    <InternalsVisibleTo Include="Calor.ILAnalysis.Tests" />
    <InternalsVisibleTo Include="Calor.LanguageServer.Tests" />
    <InternalsVisibleTo Include="calor-lsp" />
    <InternalsVisibleTo Include="McpBenchHarness" />
    <InternalsVisibleTo Include="Calor.Tasks" />
    <InternalsVisibleTo Include="Calor.Tasks.Tests" />
    <InternalsVisibleTo Include="IncrementalBuildBench" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>calor</AssemblyName>
    <RootNamespace>Calor.Compiler</RootNamespace>

    <!-- dotnet global tool packaging -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>calor</ToolCommandName>
    <PackageId>calor</PackageId>
    <Description>Calor compiler CLI - Convert C# to Calor and compile Calor to C#</Description>
    <PackageProjectUrl>https://calor.dev</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReleaseNotes>See https://github.com/juanmicrosoft/calor/blob/main/CHANGELOG.md</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.nuget.md" Pack="true" PackagePath="README.md" />
    <None Include="..\..\docs\assets\calor-icon.png" Pack="true" PackagePath="icon.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.ApplicationInsights" />
    <PackageReference Include="Microsoft.Extensions.FileSystemGlobbing" />
    <PackageReference Include="System.CommandLine" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    <PackageReference Include="Ulid" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Calor.Runtime\Calor.Runtime.csproj" />
  </ItemGroup>

  <!-- Z3 Configuration -->
  <!-- We download Z3 4.15.7 from GitHub releases (both managed DLL and native libs) -->
  <!-- This ensures compatibility across all platforms including macOS ARM64 -->
  <!-- The NuGet package Microsoft.Z3 4.12.2 doesn't support ARM64, so we don't use it -->
  <PropertyGroup>
    <Z3Dir>$(MSBuildThisFileDirectory)z3</Z3Dir>
    <Z3RuntimesDir>$(MSBuildThisFileDirectory)runtimes</Z3RuntimesDir>
    <!-- CS8012: Microsoft.Z3.dll reports a processor target but is a managed wrapper;
         native Z3 libs are in runtimes/{rid}/native/. Suppress for cross-compilation. -->
    <NoWarn>$(NoWarn);CS8012</NoWarn>
  </PropertyGroup>

  <!-- Reference the downloaded Microsoft.Z3.dll directly -->
  <ItemGroup>
    <Reference Include="Microsoft.Z3">
      <HintPath>$(Z3Dir)\Microsoft.Z3.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <!-- Normal builds are deliberately network-free. Z3 is restored by an
       explicit bootstrap step, then every managed/native asset is verified
       before references are resolved or compilation begins. -->
  <Target Name="ValidateZ3Assets" BeforeTargets="ResolveReferences">
    <Exec Command="python3 &quot;$(MSBuildThisFileDirectory)../../scripts/verify-z3-assets.py&quot;"
          Condition="'$(OS)' != 'Windows_NT'" />
    <Exec Command="python &quot;$(MSBuildThisFileDirectory)..\..\scripts\verify-z3-assets.py&quot;"
          Condition="'$(OS)' == 'Windows_NT'" />
  </Target>

  <!-- Z3 consumer propagation (#1420). Every Z3 output item is created at
       EXECUTION time, after ValidateZ3Assets has verified the bootstrapped
       files, and before AssignTargetPaths. GetCopyToOutputDirectoryItems (what
       a referencing project calls to harvest this project's copy-local
       content) and publish/pack both depend on AssignTargetPaths, so test
       hosts, Calor.Tasks, the CLI tool package, and the SDK package all
       receive the same verified set from one place.

       This replaces an evaluation-time `runtimes\**\*` glob, an Exists()-guarded
       Microsoft.Z3.dll item, and an AfterTargets="Build" side copy (#859). An
       evaluation-time glob is frozen when MSBuild loads the project; if the
       explicit bootstrap lands after that, the build passes validation yet ships
       no natives, and every Z3 test in the consumer silently skips.

       The list is explicit, not a glob: it is the supported RID set in
       eng/z3-consumers.json (osx-x64 has no valid upstream binary; win-x86 has
       no .NET 10 SDK), and scripts/test_z3_hermetic.py keeps the two in sync.
       Microsoft.Z3.dll itself flows through the Private Reference above.
       CopyToOutputDirectory="Always" (not PreserveNewest): a stale or replaced
       destination with a newer timestamp is overwritten by the verified source
       on the next build instead of surviving it. -->
  <Target Name="AddZ3AssetsToOutput"
          BeforeTargets="AssignTargetPaths"
          DependsOnTargets="ValidateZ3Assets">
    <ItemGroup>
      <None Include="$(Z3RuntimesDir)\linux-x64\native\libz3.so" Link="runtimes\linux-x64\native\libz3.so" CopyToOutputDirectory="Always" />
      <None Include="$(Z3RuntimesDir)\linux-arm64\native\libz3.so" Link="runtimes\linux-arm64\native\libz3.so" CopyToOutputDirectory="Always" />
      <None Include="$(Z3RuntimesDir)\osx-arm64\native\libz3.dylib" Link="runtimes\osx-arm64\native\libz3.dylib" CopyToOutputDirectory="Always" />
      <None Include="$(Z3RuntimesDir)\win-x64\native\libz3.dll" Link="runtimes\win-x64\native\libz3.dll" CopyToOutputDirectory="Always" />
      <None Include="$(Z3RuntimesDir)\win-arm64\native\libz3.dll" Link="runtimes\win-arm64\native\libz3.dll" CopyToOutputDirectory="Always" />
    </ItemGroup>
    <!-- The build host's native also goes to the output ROOT, the first
         Z3ContextFactory probe root. MSBuild loads task assemblies without
         deps.json native probing, so Calor.Tasks relies on this copy (pinned by
         CompileCalorIntegrationTests.VerifyGate_NativeZ3_DeployedToTasksOutputRoot).
         It flows to referencing projects like any other item, but never into
         publish or pack output: packages carry runtimes/<rid>/native only. -->
    <PropertyGroup>
      <_CalorZ3HostRid Condition="$([MSBuild]::IsOSPlatform('OSX')) AND '$([System.Runtime.InteropServices.RuntimeInformation]::ProcessArchitecture)' == 'Arm64'">osx-arm64</_CalorZ3HostRid>
      <_CalorZ3HostRid Condition="$([MSBuild]::IsOSPlatform('Windows')) AND '$([System.Runtime.InteropServices.RuntimeInformation]::ProcessArchitecture)' == 'X64'">win-x64</_CalorZ3HostRid>
      <_CalorZ3HostRid Condition="$([MSBuild]::IsOSPlatform('Windows')) AND '$([System.Runtime.InteropServices.RuntimeInformation]::ProcessArchitecture)' == 'Arm64'">win-arm64</_CalorZ3HostRid>
      <_CalorZ3HostRid Condition="$([MSBuild]::IsOSPlatform('Linux')) AND '$([System.Runtime.InteropServices.RuntimeInformation]::ProcessArchitecture)' == 'X64'">linux-x64</_CalorZ3HostRid>
      <_CalorZ3HostRid Condition="$([MSBuild]::IsOSPlatform('Linux')) AND '$([System.Runtime.InteropServices.RuntimeInformation]::ProcessArchitecture)' == 'Arm64'">linux-arm64</_CalorZ3HostRid>
    </PropertyGroup>
    <PropertyGroup>
      <_CalorZ3HostLib Condition="$(_CalorZ3HostRid.StartsWith('osx-'))">libz3.dylib</_CalorZ3HostLib>
      <_CalorZ3HostLib Condition="$(_CalorZ3HostRid.StartsWith('win-'))">libz3.dll</_CalorZ3HostLib>
      <_CalorZ3HostLib Condition="$(_CalorZ3HostRid.StartsWith('linux-'))">libz3.so</_CalorZ3HostLib>
    </PropertyGroup>
    <ItemGroup Condition="'$(_CalorZ3HostRid)' != ''">
      <None Include="$(Z3RuntimesDir)\$(_CalorZ3HostRid)\native\$(_CalorZ3HostLib)" Link="$(_CalorZ3HostLib)" CopyToOutputDirectory="Always" CopyToPublishDirectory="Never" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <PackageReference Include="DiffPlex" />
  </ItemGroup>

  <ItemGroup>
    <!-- Exclude golden .g.cs files from C# compilation — they are only embedded resources -->
    <Compile Remove="Resources\SelfTest\*.g.cs" />
    <EmbeddedResource Include="Resources\SelfTest\*.calr">
      <LogicalName>Calor.Compiler.Resources.SelfTest.%(Filename).calr</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Resources\SelfTest\*.g.cs">
      <LogicalName>Calor.Compiler.Resources.SelfTest.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\Templates\*.template">
      <LogicalName>Calor.Compiler.Resources.Templates.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Manifests\*.calor-effects.json">
      <LogicalName>Calor.Compiler.Manifests.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Resources\agent-syntax-exemplar.md">
      <LogicalName>Calor.Compiler.Resources.agent-syntax-exemplar.md</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Resources\calor-syntax-documentation.json">
      <LogicalName>Calor.Compiler.Resources.calor-syntax-documentation.json</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Resources\error-suggestions.json">
      <LogicalName>Calor.Compiler.Resources.error-suggestions.json</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\..\bench\phase0-agent-native\metadata-references-manifest.json">
      <LogicalName>Calor.Compiler.Resources.metadata-references-manifest.json</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\..\tests\Calor.Evaluation\Skills\calor-language-skills.md">
      <LogicalName>Calor.Compiler.Resources.calor-language-skills.md</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
