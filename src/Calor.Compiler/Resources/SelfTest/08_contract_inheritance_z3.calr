module ContractZ3Test ContractZ3Test block
  interface IService
    func Process (int:value | (# >= 0)) → int
      !

  class ValidService
    implements IService

    func Process (int:value | (# >= -10)) → int
      !
      => result >= 1
      return value + 1

  class AnotherValidService
    implements IService

    func Process (int:value | (# >= 0)) → int
      !
      => result >= 10
      return value + 10
