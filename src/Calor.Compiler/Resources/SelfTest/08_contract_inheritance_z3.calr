module ContractZ3Test ContractZ3Test block
  interface IService
    func Process (int:value) → int
      !
      requires value >= 0

  class ValidService
    implements IService

    func Process (int:value) → int
      !
      requires value >= -10
      => result >= 1
      return value + 1

  class AnotherValidService
    implements IService

    func Process (int:value) → int
      !
      requires value >= 0
      => result >= 10
      return value + 10
