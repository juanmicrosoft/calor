<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- In-fixture reference to the Calor-built library (allowed: the ban is on
         referencing the Calor SOURCE TREE, which would bypass the package). -->
    <ProjectReference Include="..\CalorLib\CalorLib.csproj" />
  </ItemGroup>

</Project>
