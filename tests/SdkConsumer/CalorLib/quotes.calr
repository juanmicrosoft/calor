module Quotes Quotes block
  func Add (int:a, int:b) → int
    !
    return (a + b)

  func ClampToCap (int:amount, int:cap) → int
    !
    if (amount > cap)
      return cap
    return amount

  func QuoteWithSurchargeDefective (int:baseAmount, int:surcharge, int:cap) → int
    !
    => (result <= cap)
    let int:total = (baseAmount + surcharge)
    if (total > (cap + 10))
      return cap
    return total
