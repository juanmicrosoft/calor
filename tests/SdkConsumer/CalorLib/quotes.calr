§M{m001:Quotes}
  §F{f001:Add:pub} (i32:a, i32:b) -> i32
    §R (+ a b)

  §F{f002:ClampToCap:pub} (i32:amount, i32:cap) -> i32
    §IF{if1} (> amount cap)
      §R cap
    §R amount

  §F{f003:QuoteWithSurchargeDefective:pub} (i32:baseAmount, i32:surcharge, i32:cap) -> i32
    §S (<= result cap)
    §B{total:i32} (+ baseAmount surcharge)
    §IF{if2} (> total (+ cap 10))
      §R cap
    §R total
