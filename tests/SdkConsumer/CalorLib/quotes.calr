§M{Quotes}
  §F{Add:pub} (i32:a, i32:b) -> i32
    §R (+ a b)

  §F{ClampToCap:pub} (i32:amount, i32:cap) -> i32
    §IF (> amount cap)
      §R cap
    §R amount

  §F{QuoteWithSurchargeDefective:pub} (i32:baseAmount, i32:surcharge, i32:cap) -> i32
    §S (<= result cap)
    §B{total:i32} (+ baseAmount surcharge)
    §IF (> total (+ cap 10))
      §R cap
    §R total
