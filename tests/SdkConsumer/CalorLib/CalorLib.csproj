<Project Sdk="Microsoft.NET.Sdk;Calor.Sdk/CALOR_SDK_VERSION_PLACEHOLDER">

  <!-- Explicitly versioned package SDK reference — never a source-tree reference
       and never an implicit global.json msbuild-sdks mapping. -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Exercise the packaged Z3 verify gate: the canary contract in
         quotes.calr must produce a Calor0712 refutation warning. -->
    <CalorVerify>true</CalorVerify>
  </PropertyGroup>

</Project>
