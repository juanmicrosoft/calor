<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="calor-local" value="CALOR_LOCAL_FEED_PLACEHOLDER" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <!-- Calor.Sdk must come from the just-packed local feed, never nuget.org -->
    <packageSource key="calor-local">
      <package pattern="Calor.Sdk" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
