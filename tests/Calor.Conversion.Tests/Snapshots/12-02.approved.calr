§M{Test_12_02:overflow=unchecked}
  §CL{Parser:pub}
    §MT{TryParse:pub} (str:input, i32:result:out) -> bool
      §ASSIGN result 0
      §IF (isempty input)
        §R false
      §ASSIGN result §C{int.Parse} input
      §R true

    §MT{Increment:pub} (i32:value:ref)
      §ASSIGN value (+ value 1)


