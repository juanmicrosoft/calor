§M{Test_04_04:overflow=unchecked}
  §U{global:System}
  §U{global:Collections:System.Collections.Generic}
  §U{global:static:System.Math}
  §U{Text:System.String}

  §IFACE{IProducer<out T>:Collections.IEnumerable<T>}
