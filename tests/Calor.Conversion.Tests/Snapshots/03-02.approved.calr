§M{m001:Test_03_02:overflow=unchecked}
  §CL{c001:Loops:pub}
    §MT{m002:Sum:pub} (i32:n) -> i32
      §B{~total:i32} 0
      §IF{scope007} true
        §B{~i:i32} 0
        §B{~_forFirst003:bool} true
        §WH{while006} true
          §IF{if004} _forFirst003
            §ASSIGN _forFirst003 false
          §EL
            §ASSIGN i (+ i 1)
          §IF{if005} (! (< i n))
            §BK
          §ASSIGN total (+ total i)
      §R total


