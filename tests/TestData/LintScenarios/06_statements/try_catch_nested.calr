§M{NestedTry}
  §F{OuterHandler:pub} (i32:x) -> i32
    §TR
      §TR
        §R (/ 100 x)
      §CA{DivideByZeroException:inner}
        §R -1
    §CA{Exception:outer}
      §R -2

  §F{DeepNesting:pub} (i32:a, i32:b) -> i32
    §TR
      §TR
        §TR
          §R (/ (/ a b) b)
        §CA{DivideByZeroException:e3}
          §R -3
      §CA{ArithmeticException:e2}
        §R -2
    §CA{Exception:e1}
      §R -1

