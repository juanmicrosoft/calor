module NestedTry NestedTry block
  func OuterHandler (int:x) → int
    !
    try
      try
        return (100 / x)
      catch DivideByZeroException:inner
        return -1
    catch Exception:outer
      return -2

  func DeepNesting (int:a, int:b) → int
    !
    try
      try
        try
          return ((a / b) / b)
        catch DivideByZeroException:e3
          return -3
      catch ArithmeticException:e2
        return -2
    catch Exception:e1
      return -1
