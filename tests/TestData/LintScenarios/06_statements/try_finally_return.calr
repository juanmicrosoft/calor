module FinallyReturn FinallyReturn block
  func WithFinally (int:x) → int
    !
    var result = 0
    try
      var result = (x + 10)
      return result
    finally
      Console.WriteLine("cleanup")

  func FinallyNoReturn (int:x) → int
    !
    var result = 0
    try
      var result = (x + 10)
    catch Exception:e
      var result = -1
    finally
      Console.WriteLine("finally executed")
    return result

  func TryOnlyFinally () → void
    ! cw
    try
      Console.WriteLine("try block")
    finally
      Console.WriteLine("finally block")
