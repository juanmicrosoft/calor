§M{FinallyReturn}
  §F{WithFinally:pub} (i32:x) -> i32
    §B{~result} 0
    §TR
      §B{~result} (+ x 10)
      §R result
    §FI
      §P "cleanup"

  §F{FinallyNoReturn:pub} (i32:x) -> i32
    §B{~result} 0
    §TR
      §B{~result} (+ x 10)
    §CA{Exception:e}
      §B{~result} -1
    §FI
      §P "finally executed"
    §R result

  §F{TryOnlyFinally:pub} () -> void
    §E{cw}
    §TR
      §P "try block"
    §FI
      §P "finally block"

