module WhenFilter WhenFilter block
  func FilteredHandler (int:code) → string
    !
    try
      throw "Error"
    catch Exception:ex when (code == 42)
      return "special"
    catch Exception:ex
      return "general"

  func MultipleFilters (int:value) → string
    !
    try
      throw "Error"
    catch Exception:ex when (value < 0)
      return "negative"
    catch Exception:ex when (value == 0)
      return "zero"
    catch Exception:ex when (value > 100)
      return "large"
    catch Exception:ex
      return "normal"

  func FilterWithLogicalOps (int:x, int:y) → string
    !
    try
      throw "Error"
    catch Exception:ex when ((x > 0) && (y > 0))
      return "both positive"
    catch Exception:ex when ((x < 0) || (y < 0))
      return "at least one negative"
    catch Exception:ex
      return "default"
