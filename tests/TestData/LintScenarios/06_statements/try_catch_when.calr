§M{WhenFilter}
  §F{FilteredHandler:pub} (i32:code) -> str
    §TR
      §TH "Error"
    §CA{Exception:ex} WHEN (== code 42)
      §R "special"
    §CA{Exception:ex}
      §R "general"

  §F{MultipleFilters:pub} (i32:value) -> str
    §TR
      §TH "Error"
    §CA{Exception:ex} WHEN (< value 0)
      §R "negative"
    §CA{Exception:ex} WHEN (== value 0)
      §R "zero"
    §CA{Exception:ex} WHEN (> value 100)
      §R "large"
    §CA{Exception:ex}
      §R "normal"

  §F{FilterWithLogicalOps:pub} (i32:x, i32:y) -> str
    §TR
      §TH "Error"
    §CA{Exception:ex} WHEN (&& (> x 0) (> y 0))
      §R "both positive"
    §CA{Exception:ex} WHEN (|| (< x 0) (< y 0))
      §R "at least one negative"
    §CA{Exception:ex}
      §R "default"

