module TryCatch TryCatch block
  func SafeDivide (int:a, int:b) → int
    !
    try
      return (a / b)
    catch Exception:ex
      return 0

  func WithFinally () → void
    ! cw
    try
      Console.WriteLine("try")
    catch Exception:e
      Console.WriteLine("catch")
    finally
      Console.WriteLine("finally")
