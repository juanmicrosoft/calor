module Compare Compare block
  func IsEqual (int:a, int:b) → bool
    !
    return (a == b)

  func IsNotEqual (int:a, int:b) → bool
    !
    return (a != b)

  func IsLess (int:a, int:b) → bool
    !
    return (a < b)

  func IsGreater (int:a, int:b) → bool
    !
    return (a > b)

  func IsLessEqual (int:a, int:b) → bool
    !
    return (a <= b)

  func IsGreaterEqual (int:a, int:b) → bool
    !
    return (a >= b)
