§M{Compare}
  §F{IsEqual:pub} (i32:a, i32:b) -> bool
    §R (== a b)

  §F{IsNotEqual:pub} (i32:a, i32:b) -> bool
    §R (!= a b)

  §F{IsLess:pub} (i32:a, i32:b) -> bool
    §R (< a b)

  §F{IsGreater:pub} (i32:a, i32:b) -> bool
    §R (> a b)

  §F{IsLessEqual:pub} (i32:a, i32:b) -> bool
    §R (<= a b)

  §F{IsGreaterEqual:pub} (i32:a, i32:b) -> bool
    §R (>= a b)

