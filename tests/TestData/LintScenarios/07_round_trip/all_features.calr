module AllFeatures AllFeatures block
  func Main () → void
    ! cw
    Console.WriteLine("Starting")
    let x = 10
    var y = 0
    for i from 1 to 10 step 1
      if (i > 5)
        Console.WriteLine("high")
      else if (i == 5)
        Console.WriteLine("middle")
      else
        Console.WriteLine("low")
      var y = (y + i)
    Console.WriteLine(y)

  func Calculate (int:a | (# > 0), int:b | (# > 0)) → int
    !
    => (result > 0)
    let sum = (a + b)
    let product = (a * b)
    return (sum + product)

  func Divide private (int:x, int:y | (# != 0)) → int
    try
      return (x / y)
    catch Exception:e
      return 0
