module Complex Complex block
  func Process () → int
    ! cw
    var result = 0
    for i from 1 to 10 step 1
      if (i > 5)
        for j from 1 to 5 step 1
          if ((j % 2) == 0)
            var result = (result + j)
      else
        var result = (result + i)
    return result
