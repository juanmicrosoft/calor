module Contracted Contracted block
  assume{env} "the clock is monotonic"
  func Bounded (int:n | (# >= 0)) → int
    !
    => result >= 1
    assume{perf} "callers pass small values"
    return n + 1

  func Plain () → int
    !
    return 0

  func Shout (string:s) → void
    ! cw
    Console.WriteLine(s)
