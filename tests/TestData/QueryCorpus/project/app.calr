§M{App}
  §F{Run:pub} () -> i32
    §E{}
    §R §C{Scale} §A INT:5 §/C
  §F{Unused:pub} () -> i32
    §E{}
    §R INT:0
  §F{Log:pub} (str:s) -> void
    §E{cw}
    §P s
  §F{Leaky:pub} () -> void
    §E{}
    §C{Log} §A STR:"x" §/C
  §F{Relay:pub} () -> void
    §E{cw}
    §C{Log} §A STR:"y" §/C
  §F{Fan:pub} () -> void
    §E{cw}
    §C{Relay} §/C
  §F{Quiet:pub} () -> i32
    §R INT:1
  §F{Whisper:pub} () -> void
    §E{}
    §C{Shout} §A STR:"z" §/C
  §F{Map:pub}<eff e> (Func<i32,i32>:f §E{e}, i32:value) -> i32
    §E{e}
    §R §C{f} §A value §/C
  §F{Twice:pub}<eff e> (Func<i32,i32>:g §E{e}, i32:v) -> i32
    §E{e}
    §R §C{Map} §A g §A v §/C
