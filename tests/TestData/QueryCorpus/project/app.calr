module App App block
  func Run () → int
    !
    return Scale(5)

  func Unused () → int
    !
    return 0

  func Log (string:s) → void
    ! cw
    Console.WriteLine(s)

  func Leaky () → void
    !
    Log("x")

  func Relay () → void
    ! cw
    Log("y")

  func Fan () → void
    ! cw
    Relay()

  func Quiet () → int
    !
    return 1

  func Whisper () → void
    !
    Shout("z")

  func Map <! e> (Func<int, int>:f ! e, int:value) → int
    ! e
    return f(value)

  func Twice <! e> (Func<int, int>:g ! e, int:v) → int
    ! e
    return Map(g, v)
