{
  "description": "Shared interop controls (#1428). SharedInteropControlsTests converts each fixture on every measured surface, compiles and runs it, and compares the trace with the original C#. 'expected' lists the allowed outcomes; controls-results.json holds the committed observation of each cell.",
  "surfaces": [
    {
      "id": "library",
      "measured": true,
      "entry": "new CSharpToCalorConverter() with default ConversionOptions",
      "defaults": {
        "rescueUnusableMembers": false,
        "passthroughOnError": false
      }
    },
    {
      "id": "cli-convert",
      "measured": true,
      "entry": "calor convert Input.cs -o Input.calr --format json (no conversion flags)",
      "defaults": {
        "rescueUnusableMembers": true,
        "passthroughOnError": false
      }
    },
    {
      "id": "cli-migrate",
      "measured": true,
      "entry": "calor migrate <dir> --skip-verify --skip-analyze --report <json> (one-file project)",
      "defaults": {
        "rescueUnusableMembers": false,
        "passthroughOnError": false
      }
    },
    {
      "id": "mcp-convert",
      "measured": true,
      "entry": "MCP calor_convert {source}",
      "defaults": {
        "rescueUnusableMembers": false,
        "passthroughOnError": false
      }
    },
    {
      "id": "mcp-convert-passthroughOnError",
      "measured": true,
      "entry": "MCP calor_convert {source, passthroughOnError: true}",
      "defaults": {
        "rescueUnusableMembers": false,
        "passthroughOnError": true
      }
    },
    {
      "id": "mcp-migrate",
      "measured": true,
      "entry": "MCP calor_migrate {projectPath, phase: convert} (one-file project)",
      "defaults": {
        "rescueUnusableMembers": false,
        "passthroughOnError": false
      }
    },
    {
      "id": "mcp-batch",
      "measured": true,
      "entry": "MCP calor_batch {action: convert, projectPath} (one-file project, writes output)",
      "defaults": {
        "rescueUnusableMembers": false,
        "passthroughOnError": false
      }
    },
    {
      "id": "sdk",
      "measured": false,
      "reason": "src/Calor.Sdk has only MSBuild Sdk.props/Sdk.targets and no conversion entry point (F6 decision D4-sdk-surface); the library row is the SDK surface."
    },
    {
      "id": "msbuild",
      "measured": false,
      "reason": "Calor.Tasks compiles Calor and does not call the C# to Calor converter; no conversion behavior to measure."
    },
    {
      "id": "lsp",
      "measured": false,
      "reason": "Calor.LanguageServer does not call the C# to Calor converter; no conversion behavior to measure."
    }
  ],
  "controls": [
    {
      "id": "T1-REFOUT-NULLABLE",
      "covers": [
        "refout-nullable-locals"
      ],
      "fixture": "tests/TestData/InteropScope/T1/fixtures/T1-REFOUT-NULLABLE.cs.txt",
