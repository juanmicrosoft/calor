module TypeSystem TypeSystem
  func Main public () → void
    ! cw,throw,alloc
    Console.WriteLine("=== Calor Type System Demo ===")
    TestNullable()
    let int:quotient = Divide(100, 2)
    Console.WriteLine(quotient)
    try
      Divide(100, 0)
    catch ArgumentException:error
      Console.WriteLine("Division by zero was caught")

  func TestNullable private () → void
    let string?:present = "hello"
    let string?:missing = null
    Console.WriteLine(present ?? "fallback")
    Console.WriteLine(missing ?? "fallback")

  func Divide private (int:a, int:b) → int
    if b == 0
      throw new ArgumentException("Division by zero")
    return a / b
