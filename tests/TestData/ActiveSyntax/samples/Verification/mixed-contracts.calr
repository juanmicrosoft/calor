module MixedContracts MixedContracts
  func SafeDivide public (int:a, int:b | (# != 0)) → int
    !
    => b != 0
    return a / b

  func SumArray public (int:n | (# >= 0)) → int
    !
    return 0

  func Increment public (int:x) → int
    !
    => result == x + 1
    return x + 1

  func ClampPositive public (int:x) → int
    !
    => result >= 0
    if x < 0
      return 0
    else
      return x
