// Arithmetic Benchmark: Division by Zero Detection
// Tests bug pattern analysis for division by zero vulnerabilities

module DivByZeroBenchmark DivByZeroBenchmark
  func VulnerableDivision public (int:x, int:y) → int
    !
    // BUG: Division by unchecked parameter
    // EXPECTED: Calor0920 Division by Zero
    return x / y

  func SafeDivisionWithGuard public (int:x, int:y) → int
    !
    // SAFE: Division with zero check
    // EXPECTED: No warnings
    if y != 0
      return x / y
    else
      return 0

  func VulnerableModulo public (int:a, int:b) → int
    !
    // BUG: Modulo by unchecked parameter
    // EXPECTED: Calor0920 Division by Zero
    return a % b

  func SafeDivisionByLiteral public (int:x) → int
    !
    // SAFE: Division by non-zero literal
    // EXPECTED: No warnings
    return x / 2

  func VulnerableDivisionInLoop public (int:n) → int
    !
    // BUG: Division in loop where counter can be zero
    // EXPECTED: Calor0920 Division by Zero
    var int:result = 0
    for i from 0 to n step 1
      set result result + 100 / i
    return result

  func SafeDivisionInLoopFromOne public (int:n) → int
    !
    // SAFE: Loop starts from 1
    // EXPECTED: No warnings
    var int:result = 0
    for i from 1 to n step 1
      set result result + 100 / i
    return result

  func VulnerableDivisionAfterDecrement public (int:x, int:y) → int
    !
    // BUG: Division after value can become zero
    // EXPECTED: Calor0920 Division by Zero
    let int:divisor = y - 1
    return x / divisor

  func SafeDivisionWithContract public (int:x, int:y | (# > 0)) → int
    !
    // SAFE: Precondition guarantees non-zero
    // EXPECTED: No warnings
    return x / y
