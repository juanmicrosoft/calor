// Arithmetic Benchmark: Integer Overflow Detection
// Tests bug pattern analysis for integer overflow vulnerabilities

module OverflowBenchmark OverflowBenchmark
  func VulnerableAddition public (int:a, int:b) → int
    !
    // BUG: Unchecked addition may overflow
    // EXPECTED: Calor0923 Integer Overflow
    return a + b

  func SafeCheckedAddition public (int:a, int:b) → int
    !
    // SAFE: Addition with overflow check
    // EXPECTED: No warnings
    var int:result = 0
    raw member:checked-block:Other:checked%20overflow%20block%20preserved%20verbatim 36
        checked { result = a + b; }

    return result

  func VulnerableMultiplication public (int:x, int:y) → int
    !
    // BUG: Unchecked multiplication may overflow
    // EXPECTED: Calor0923 Integer Overflow
    return x * y

  func SafeSmallValues public (int:x | ((# < 1000) && (# > 0))) → int
    !
    // SAFE: Values known to be small
    // EXPECTED: No warnings
    return x * 100

  func VulnerableLeftShift public (int:x, int:n) → int
    !
    // BUG: Left shift may overflow
    // EXPECTED: Calor0923 Integer Overflow
    return x << n

  func SafeBoundedShift public (int:x | ((# >= -536870912) && (# <= 536870911))) → int
    !
    // SAFE: Both the operand and shift amount are bounded
    // EXPECTED: No warnings
    return x << 2

  func VulnerableAccumulator public (int:n) → int
    !
    // BUG: Accumulator in loop may overflow
    // EXPECTED: Calor0923 Integer Overflow
    var int:sum = 0
    for i from 1 to n step 1
      set sum sum + i
    return sum

  func SafeBoundedAccumulator public () → int
    !
    // SAFE: Loop bound prevents overflow
    // EXPECTED: No warnings
    var int:sum = 0
    for i from 1 to 100 step 1
      set sum sum + i
    return sum
