// Current nullable/exception semantics, not a replay of the frozen benchmark.
§M{NullDerefBenchmark}

  §F{VulnerableNullDeref:pub}
    // BUG: Potential null dereference without check
    // EXPECTED: Calor0922 Null Dereference
    §I{?string:maybeNull}
    §O{i32}
    §R maybeNull . Length

  §F{SafeNullCheck:pub}
    // SAFE: Null check before use
    // EXPECTED: No warnings
    §I{?string:maybeNull}
    §O{i32}
    §IF (!= maybeNull null)
      §R maybeNull . Length
    §EL
      §R INT:0

  §F{VulnerableChainedAccess:pub}
    // BUG: Chained access without null checks
    // EXPECTED: Calor0922 Null Dereference
    §I{?BenchmarkNode:obj}
    §O{?string}
    §B{inner:?BenchmarkNode} obj . Inner
    §B{value:?string} inner . Value
    §R value

  §F{SafeCoalesce:pub}
    // SAFE: Coalesce provides default
    // EXPECTED: No warnings
    §I{?string:maybeNull}
    §O{string}
    §B{safe:string} (?? maybeNull STR:"default")
    §R safe

  §F{RequiredNullableValue:pub}
    // SAFE: Absence deliberately throws; it is not an implicit unwrap.
    // EXPECTED: No warnings
    §I{?i32:maybeValue}
    §O{i32}
    §E{alloc,throw}
    §R (?? maybeValue §TH §NEW{InvalidOperationException} §A "Missing value" §/NEW)

  §F{SafeNullableCheck:pub}
    // SAFE: Guarded nullable value with a fallback
    // EXPECTED: No warnings
    §I{?i32:maybeValue}
    §O{i32}
    §IF (!= maybeValue null)
      §R (?? maybeValue INT:0)
    §EL
      §R INT:0

  §F{VulnerableFunctionReturn:pub}
    // BUG: Function return may be null
    // EXPECTED: Calor0922 Null Dereference
    §I{i32:key}
    §I{System.Collections.Generic.Dictionary<i32,?string>:dict}
    §O{i32}
    §B{result:?string} §C{System.Collections.Generic.CollectionExtensions.GetValueOrDefault} §A dict §A key §/C
    §R §C{result.GetHashCode} §/C

  §F{SafeOrDefault:pub}
    // SAFE: Using get_or_default
    // EXPECTED: No warnings
    §I{i32:key}
    §I{System.Collections.Generic.Dictionary<i32,?string>:dict}
    §O{i32}
    §B{result:string} (?? §C{System.Collections.Generic.CollectionExtensions.GetValueOrDefault} §A dict §A key §/C STR:"")
    §R §C{result.GetHashCode} §/C

  §CL{BenchmarkNode:pub}
    §FLD{?BenchmarkNode:Inner:pub}
    §FLD{?string:Value:pub}
