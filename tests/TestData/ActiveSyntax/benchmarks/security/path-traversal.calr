// Security Benchmark: Path Traversal Detection
// Tests taint analysis for path traversal vulnerabilities

module PathTraversalBenchmark PathTraversalBenchmark
  func VulnerableFileRead public (string:user_path) → string
    // BUG: Direct file read with user-provided path
    // EXPECTED: Calor0983 Path Traversal
    ! fs:r
    let string:content = System.IO.File.ReadAllText(user_path)
    return content

  func SafeWhitelistedPath public (string:user_input) → string
    // SAFE: Only whitelisted paths allowed
    // EXPECTED: No warnings
    ! fs:r
    if user_input == "index.html"
      return System.IO.File.ReadAllText("/app/public/index.html")
    if user_input == "about.html"
      return System.IO.File.ReadAllText("/app/public/about.html")
    return ""

  func VulnerablePathJoin public (string:user_path) → string
    // BUG: User input used in path.join
    // EXPECTED: Calor0983 Path Traversal
    ! fs:r
    let string:basePath = "/var/data"
    let string:fullPath = System.IO.Path.Combine(basePath, user_path)
    let string:content = System.IO.File.ReadAllText(fullPath)
    return content

  func SafeSanitizedPath public (string:user_input) → string
    // SAFE: Path properly sanitized
    // EXPECTED: No warnings
    ! fs:r
    let string:sanitized = System.IO.Path.GetFileName(user_input) ?? ""
    if sanitized == "." || sanitized == ".."
      return ""
    let string:basePath = "/safe/directory/"
    let string:fullPath = basePath + sanitized
    let string:content = System.IO.File.ReadAllText(fullPath)
    return content

  func VulnerableFileWrite public (string:user_input, string:content) → void
    // BUG: Writing to user-controlled path
    // EXPECTED: Calor0983 Path Traversal
    ! fs:w
    let string:path = "/uploads/" + user_input
    System.IO.File.WriteAllText(path, content)

  func SafeConstantPath public () → string
    // SAFE: Path is a constant
    // EXPECTED: No warnings
    ! fs:r
    let string:path = "/etc/app/config.json"
    let string:content = System.IO.File.ReadAllText(path)
    return content
