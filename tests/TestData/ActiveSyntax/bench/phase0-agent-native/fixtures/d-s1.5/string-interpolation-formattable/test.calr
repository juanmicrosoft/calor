§M{m001:InterpolationFormattableTest}
  §U{System}

  §M{c001:FormattableProbe:pub}
    §F{m002:Kind:pub} (FormattableString:f) -> i32
      §R 1

    §F{m003:Kind:pub} (any:o) -> i32
      §R (- 1)

    §F{m004:Verify:pub} () -> i32
      §S (== result 107)
      §B{x:i32} 42
      §B{s:str} "k=${x},${(+ x 1)}"
      §R (+ (* §C{Kind} §A (cast global::System.FormattableString "k=${x},${(+ x 1)}") §/C 100) (len s))
