// Active migration/semantic check; not a replay of historical raw input.
§M{TextUtils}
  §F{Slugify:pub} (str:s) -> str
    §E{}
    §B{lower:str} §C{s.ToLowerInvariant} §/C
    §R §C{lower.Replace} §A " " §A "-" §/C
  §F{Truncate:pub} (str:s, i32:maxLen) -> str
    §E{}
    §IF (<= (len s) maxLen)
      §R s
    §IF (> maxLen 3)
      §R (concat (substr s 0 (- maxLen 3)) "...")
    §R (substr s 0 maxLen)
  §F{WordCount:pub} (str:s) -> i32
    §E{}
    §B{trimmed:str} (trim s)
    §IF (== (len trimmed) 0)
      §R 0
    §B{words} (regex-split trimmed "\\s+")
    §R (len words)
