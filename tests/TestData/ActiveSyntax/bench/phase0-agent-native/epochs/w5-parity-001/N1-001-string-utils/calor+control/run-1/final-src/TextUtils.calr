§M{TextUtils}
  §F{Slugify:pub} (str:s) -> str
    §E{}
    §B{lower:str} §C{s.ToLowerInvariant} §/C
    §R §C{lower.Replace} §A " " §A "-" §/C

  §F{Truncate:pub} (str:s, i32:maxLen) -> str
    §E{}
    §IF (<= (len s) maxLen)
      §R s
    §IF (> maxLen 3)
      §R (+ (substr s 0 (- maxLen 3)) "...")
    §R (substr s 0 maxLen)

  §F{WordCount:pub} (str:s) -> i32
    §E{}
    §B{~count:i32} 0
    §B{~inWord:bool} false
    §B{~i:i32} 0
    §WH (< i (len s))
      §B{c:str} (substr s i 1)
      §B{isWs:bool} (|| (== c " ") (|| (== c "\t") (|| (== c "\r") (== c "\n"))))
      §IF isWs
        §ASSIGN inWord false
      §EL
        §IF (! inWord)
          §ASSIGN count (+ count 1)
          §ASSIGN inWord true
      §ASSIGN i (+ i 1)
    §R count
