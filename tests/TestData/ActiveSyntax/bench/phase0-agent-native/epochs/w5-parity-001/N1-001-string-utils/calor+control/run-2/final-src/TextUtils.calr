§M{TextUtils}
  §F{Slugify:pub} (str:s) -> str
    §E{}
    §B{lower:str} §C{s.ToLowerInvariant} §/C
    §R §C{lower.Replace} §A " " §A "-" §/C

  §F{Truncate:pub} (str:s, i32:maxLen) -> str
    §E{}
    §IF (<= (len s) maxLen)
      §R s
    §EI (> maxLen 3)
      §R (concat (substr s 0 (- maxLen 3)) "...")
    §EL
      §R (substr s 0 maxLen)

  §F{WordCount:pub} (str:s) -> i32
    §E{}
    §B{trimmed:str} (trim s)
    §IF (== (len trimmed) 0)
      §R 0
    §EL
      §B{normalized:str} (regex-replace trimmed "\\s+" " ")
      §R (+ (- (len normalized) (len (replace normalized " " ""))) 1)
