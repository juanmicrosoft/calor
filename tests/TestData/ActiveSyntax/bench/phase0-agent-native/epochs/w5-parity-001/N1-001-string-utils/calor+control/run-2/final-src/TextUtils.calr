module TextUtils TextUtils block
  module TextUtilsModule public
    func Slugify (string:s) → string
      !
      let string:lower = s.ToLowerInvariant()
      return lower.Replace(" ", "-")

    func Truncate (string:s, int:maxLen) → string
      !
      if (s.Length <= maxLen)
        return s
      else if (maxLen > 3)
        return string.Concat((s).Substring(0, (maxLen - 3)), "...")
      else
        return (s).Substring(0, maxLen)

    func WordCount (string:s) → int
      !
      let string:trimmed = (s).Trim()
      if (trimmed.Length == 0)
        return 0
      else
        let string:normalized = System.Text.RegularExpressions.Regex.Replace(trimmed, "\\s+", " ")
        return ((normalized.Length - ((normalized).Replace(" ", "")).Length) + 1)
