§M{CsvRow}
  §F{NeedsQuoting:pub} (str:field) -> bool
    §E{}
    §R (|| (contains field ",") (|| (contains field "\"") (|| (contains field "\r") (contains field "\n"))))

  §F{EscapeField:pub} (str:field) -> str
    §E{}
    §B{needs} §C{NeedsQuoting} field
    §IF needs
      §R (+ (+ "\"" (replace field "\"" "\"\"")) "\"")
    §EL
      §R field

  §F{JoinRow:pub} (List<str>:fields) -> str
    §E{}
    §B{~result} ""
    §B{~first} true
    §EACH{field} fields
      §B{esc} §C{EscapeField} field
      §IF first
        §ASSIGN result esc
        §ASSIGN first false
      §EL
        §ASSIGN result (+ (+ result ",") esc)
    §R result

  §F{SplitRow:pub} (str:line) -> List<str>
    §E{mut,alloc}
    §B{result} §NEW{List<str>} §/NEW
    §B{n} (len line)
    §B{~i} 0
    §B{~more} true
    §WH more
      §B{~current} ""
      §IF (&& (< i n) (== (char-code (char-at line i)) 34))
        §ASSIGN i (+ i 1)
        §B{~q} true
        §WH q
          §IF (>= i n)
            §ASSIGN q false
          §EI (== (char-code (char-at line i)) 34)
            §IF (&& (< (+ i 1) n) (== (char-code (char-at line (+ i 1))) 34))
              §ASSIGN current (+ current "\"")
              §ASSIGN i (+ i 2)
            §EL
              §ASSIGN i (+ i 1)
              §ASSIGN q false
          §EL
            §ASSIGN current (+ current (str (char-at line i)))
            §ASSIGN i (+ i 1)
      §EL
        §WH (&& (< i n) (!= (char-code (char-at line i)) 44))
          §ASSIGN current (+ current (str (char-at line i)))
          §ASSIGN i (+ i 1)
      §PUSH{result} current
      §IF (&& (< i n) (== (char-code (char-at line i)) 44))
        §ASSIGN i (+ i 1)
      §EL
        §ASSIGN more false
    §R result
