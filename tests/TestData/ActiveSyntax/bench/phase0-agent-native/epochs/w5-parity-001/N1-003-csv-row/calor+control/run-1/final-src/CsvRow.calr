module CsvRow CsvRow block
  module CsvRowModule public
    func NeedsQuoting (string:@field) → bool
      !
      return ((@field).Contains(",") || ((@field).Contains("\"") || ((@field).Contains("\r") || (@field).Contains("\n"))))

    func EscapeField (string:@field) → string
      !
      let needs = NeedsQuoting(@field)
      if needs
        return string.Concat("\"", (@field).Replace("\"", "\"\""), "\"")
      else
        return @field

    func JoinRow (List<string>:fields) → string
      !
      let result = ""
      let first = true
      each @field in fields
        let esc = EscapeField(@field)
        if first
          set result esc
          set first false
        else
          set result string.Concat(result, ",", esc)
      return result

    func SplitRow (string:line) → List<string>
      ! mut, alloc
      let result = new List<string>()
      let n = line.Length
      let i = 0
      let cont = true
      do
        let @field = ""
        if ((i < n) && ((line).Substring(i, 1)).Equals("\""))
          set i (i + 1)
          let inq = true
          while inq
            if (i >= n)
              set inq false
            else
              let ch = (line).Substring(i, 1)
              if (ch).Equals("\"")
                if (((i + 1) < n) && ((line).Substring((i + 1), 1)).Equals("\""))
                  set @field string.Concat(@field, "\"")
                  set i (i + 2)
                else
                  set i (i + 1)
                  set inq false
              else
                set @field string.Concat(@field, ch)
                set i (i + 1)
        else
          while ((i < n) && (!((line).Substring(i, 1)).Equals(",")))
            let ch2 = (line).Substring(i, 1)
            set @field string.Concat(@field, ch2)
            set i (i + 1)
        result.Add(@field)
        if ((i < n) && ((line).Substring(i, 1)).Equals(","))
          set i (i + 1)
          set cont true
        else
          set cont false
      while cont
      return result
