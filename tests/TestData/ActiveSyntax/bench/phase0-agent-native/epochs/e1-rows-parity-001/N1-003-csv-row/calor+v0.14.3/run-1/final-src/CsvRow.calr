module CsvRow CsvRow block
  module CsvRowModule public
    func NeedsQuoting (string:@field) → bool
      !
      return ((@field).Contains(",") || ((@field).Contains("\"") || ((@field).Contains("\r") || (@field).Contains("\n"))))

    func EscapeField (string:@field) → string
      !
      let bool:needs = NeedsQuoting(@field)
      if needs
        return ("\"" + ((@field).Replace("\"", "\"\"") + "\""))
      return @field

    func JoinRow (List<string>:fields) → string
      !
      var string:result = ""
      let int:n = fields . Count
      var int:i = 0
      while (i < n)
        let string:@field = fields[i]
        let string:esc = EscapeField(@field)
        if (i > 0)
          set result (result + ",")
        set result (result + esc)
        set i (i + 1)
      return result

    func SplitRow (string:line) → List<string>
      ! mut, alloc
      var result = new List<string>()
      let int:n = line.Length
      var int:i = 0
      var bool:more = true
      while more
        var string:@field = ""
        if ((i < n) && ((line).Substring(i, 1)).Equals("\""))
          set i (i + 1)
          var bool:inQuote = true
          while (inQuote && (i < n))
            let string:c = (line).Substring(i, 1)
            if (c).Equals("\"")
              if (((i + 1) < n) && ((line).Substring((i + 1), 1)).Equals("\""))
                set @field (@field + "\"")
                set i (i + 2)
              else
                set i (i + 1)
                set inQuote false
            else
              set @field (@field + c)
              set i (i + 1)
        else
          while ((i < n) && (!((line).Substring(i, 1)).Equals(",")))
            set @field (@field + (line).Substring(i, 1))
            set i (i + 1)
        result.Add(@field)
        if ((i < n) && ((line).Substring(i, 1)).Equals(","))
          set i (i + 1)
          set more true
        else
          set more false
      return result
