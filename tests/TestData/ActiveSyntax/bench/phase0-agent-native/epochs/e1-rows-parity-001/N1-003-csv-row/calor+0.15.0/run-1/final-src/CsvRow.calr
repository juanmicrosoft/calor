module CsvRow CsvRow block
  module CsvRowModule public
    func NeedsQuoting (string:@field) → bool
      !
      return ((@field).Contains(",") || ((@field).Contains("\"") || ((@field).Contains("\r") || (@field).Contains("\n"))))

    func EscapeField (string:@field) → string
      !
      let bool:q = NeedsQuoting(@field)
      if (q == true)
        return ("\"" + ((@field).Replace("\"", "\"\"") + "\""))
      return @field

    func JoinRow (List<string>:fields) → string
      !
      var string:result = ""
      var bool:first = true
      each f in fields
        if (first == true)
          set first false
        else
          set result (result + ",")
        let string:esc = EscapeField(f)
        set result (result + esc)
      return result

    func SplitRow (string:line) → List<string>
      ! mut, alloc
      let List<string>:result = new List<string>()
      let int:n = line.Length
      var int:i = 0
      var bool:more = true
      while (more == true)
        var string:@field = ""
        if ((i < n) && ((line).Substring(i, 1)).Equals("\""))
          set i (i + 1)
          var bool:scan = true
          while (scan == true)
            if (i >= n)
              set scan false
            else
              let string:c = (line).Substring(i, 1)
              if (c).Equals("\"")
                if (((i + 1) < n) && ((line).Substring((i + 1), 1)).Equals("\""))
                  set @field (@field + "\"")
                  set i (i + 2)
                else
                  set i (i + 1)
                  set scan false
              else
                set @field (@field + c)
                set i (i + 1)
        else
          while ((i < n) && (!((line).Substring(i, 1)).Equals(",")))
            set @field (@field + (line).Substring(i, 1))
            set i (i + 1)
        result.Add(@field)
        if (i < n)
          set i (i + 1)
          if (i == n)
            result.Add("")
            set more false
        else
          set more false
      return result
