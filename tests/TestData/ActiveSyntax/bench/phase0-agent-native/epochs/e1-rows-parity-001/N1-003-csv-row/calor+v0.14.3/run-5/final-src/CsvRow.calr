module CsvRow CsvRow block
  module CsvRowModule public
    func NeedsQuoting (string:@field) → bool
      !
      return ((@field).Contains(",") || ((@field).Contains("\"") || ((@field).Contains("\r") || (@field).Contains("\n"))))

    func EscapeField (string:@field) → string
      !
      if NeedsQuoting(@field)
        let doubled = (@field).Replace("\"", "\"\"")
        return string.Concat("\"", string.Concat(doubled, "\""))
      else
        return @field

    func JoinRow (List<string>:fields) → string
      ! mut, alloc
      var sb = new System.Text.StringBuilder()
      var first = true
      each @field in fields
        if first
          set first false
        else
          set sb (sb).Append(",")
        set sb (sb).Append(EscapeField(@field))
      return (sb).ToString()

    func SplitRow (string:line) → List<string>
      ! mut, alloc
      let result = new List<string>()
      var i = 0
      var n = line.Length
      var more = true
      var sb = new System.Text.StringBuilder()
      var inField = true
      while more
        set sb new System.Text.StringBuilder()
        if ((i < n) && (((int)(line)[i]) == 34))
          set i (i + 1)
          set inField true
          while inField
            if (i >= n)
              set inField false
            else if (((int)(line)[i]) == 34)
              if (((i + 1) < n) && (((int)(line)[(i + 1)]) == 34))
                set sb (sb).Append("\"")
                set i (i + 2)
              else
                set i (i + 1)
                set inField false
            else
              set sb (sb).Append(((line)[i]).ToString())
              set i (i + 1)
        else
          while ((i < n) && (((int)(line)[i]) != 44))
            set sb (sb).Append(((line)[i]).ToString())
            set i (i + 1)
        result.Add((sb).ToString())
        if ((i < n) && (((int)(line)[i]) == 44))
          set i (i + 1)
        else
          set more false
      return result
