§M{CsvRow}
  §F{NeedsQuoting:pub} (str:field) -> bool
    §E{}
    §R (|| (contains field ",") (|| (contains field "\"") (|| (contains field "\r") (contains field "\n"))))

  §F{EscapeField:pub} (str:field) -> str
    §E{}
    §B{nq:bool} §C{NeedsQuoting} §A field §/C
    §IF (! nq)
      §R field
    §B{doubled:str} (replace field "\"" "\"\"")
    §R (+ "\"" (+ doubled "\""))

  §F{JoinRow:pub} (List<str>:fields) -> str
    §E{}
    §B{~result:str} ""
    §B{n:i32} §CNT{fields}
    §B{~i:i32} 0
    §WH (< i n)
      §IF (> i 0)
        §ASSIGN result (+ result ",")
      §B{fld:str} §IDX fields i
      §B{esc:str} §C{EscapeField} §A fld §/C
      §ASSIGN result (+ result esc)
      §ASSIGN i (+ i 1)
    §R result

  §F{SplitRow:pub} (str:line) -> List<str>
    §E{mut,alloc}
    §B{n:i32} (len line)
    §LIST{result:str}
    §/LIST
    §B{~i:i32} 0
    §B{~more:bool} true
    §WH more
      §B{~field:str} ""
      §IF (&& (< i n) (equals (substr line i 1) "\""))
        §ASSIGN i (+ i 1)
        §B{~done:bool} false
        §WH (! done)
          §B{ch:str} (substr line i 1)
          §IF (equals ch "\"")
            §B{next:str} (? (< (+ i 1) n) (substr line (+ i 1) 1) "")
            §IF (equals next "\"")
              §ASSIGN field (+ field "\"")
              §ASSIGN i (+ i 2)
            §EL
              §ASSIGN i (+ i 1)
              §ASSIGN done true
          §EL
            §ASSIGN field (+ field ch)
            §ASSIGN i (+ i 1)
      §EL
        §WH (&& (< i n) (! (equals (substr line i 1) ",")))
          §ASSIGN field (+ field (substr line i 1))
          §ASSIGN i (+ i 1)
      §PUSH{result} field
      §IF (< i n)
        §ASSIGN i (+ i 1)
      §EL
        §ASSIGN more false
    §R result
