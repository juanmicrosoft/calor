module CsvRow CsvRow block
  module CsvRowModule public
    func NeedsQuoting (string:@field) → bool
      !
      return ((@field).Contains(",") || ((@field).Contains("\"") || ((@field).Contains("\r") || (@field).Contains("\n"))))

    func EscapeField (string:@field) → string
      !
      if NeedsQuoting(@field)
        return string.Concat("\"", (@field).Replace("\"", "\"\""), "\"")
      else
        return @field

    func JoinRow (List<string>:fields) → string
      ! alloc, mut
      let escaped = new List<string>()
      each f in fields
        escaped.Add(EscapeField(f))
      return string.Join(",", escaped)

    func SplitRow (string:line) → List<string>
      ! alloc, mut
      let result = new List<string>()
      var @field = ""
      var i = 0
      var inq = false
      let n = line.Length
      while (i < n)
        let c = (line).Substring(i, 1)
        if inq
          if (c).Equals("\"")
            if (((i + 1) < n) && ((line).Substring((i + 1), 1)).Equals("\""))
              set @field string.Concat(@field, "\"")
              set i (i + 2)
            else
              set inq false
              set i (i + 1)
          else
            set @field string.Concat(@field, c)
            set i (i + 1)
        else if (c).Equals("\"")
          set inq true
          set i (i + 1)
        else if (c).Equals(",")
          result.Add(@field)
          set @field ""
          set i (i + 1)
        else
          set @field string.Concat(@field, c)
          set i (i + 1)
      result.Add(@field)
      return result
