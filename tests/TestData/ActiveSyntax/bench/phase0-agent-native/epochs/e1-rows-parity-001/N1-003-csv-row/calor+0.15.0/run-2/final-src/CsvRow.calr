module CsvRow CsvRow block
  module CsvRowModule public
    func NeedsQuoting (string:@field) → bool
      !
      return ((@field).Contains(",") || ((@field).Contains("\"") || ((@field).Contains("\r") || (@field).Contains("\n"))))

    func EscapeField (string:@field) → string
      !
      let bool:needs = NeedsQuoting(@field)
      if needs
        return string.Concat("\"", (@field).Replace("\"", "\"\""), "\"")
      else
        return @field

    func JoinRow (List<string>:fields) → string
      ! mut, alloc
      let List<string>:parts = new List<string>()
      each f in fields
        let string:esc = EscapeField(f)
        parts.Add(esc)
      return string.Join(",", parts)

    func SplitRow (string:line) → List<string>
      ! mut, alloc
      let List<string>:result = new List<string>()
      var int:i = 0
      let int:n = line.Length
      var bool:more = true
      while more
        var string:@field = ""
        if ((i < n) && ((line).Substring(i, 1)).Equals("\""))
          set i (i + 1)
          var bool:inq = true
          while inq
            if (i >= n)
              set inq false
            else if ((line).Substring(i, 1)).Equals("\"")
              if (((i + 1) < n) && ((line).Substring((i + 1), 1)).Equals("\""))
                set @field string.Concat(@field, "\"")
                set i (i + 2)
              else
                set i (i + 1)
                set inq false
            else
              set @field string.Concat(@field, (line).Substring(i, 1))
              set i (i + 1)
        else
          let int:start = i
          while ((i < n) && (!((line).Substring(i, 1)).Equals(",")))
            set i (i + 1)
          set @field (line).Substring(start, (i - start))
        result.Add(@field)
        if ((i < n) && ((line).Substring(i, 1)).Equals(","))
          set i (i + 1)
        else
          set more false
      return result
