§M{CsvRow}
  §F{NeedsQuoting:pub} (str:field) -> bool
    §E{}
    §R (|| (contains field ",") (|| (contains field "\"") (|| (contains field "\r") (contains field "\n"))))

  §F{EscapeField:pub} (str:field) -> str
    §E{}
    §B{needs:bool} §C{NeedsQuoting} §A field §/C
    §IF needs
      §R (concat "\"" (replace field "\"" "\"\"") "\"")
    §EL
      §R field

  §F{JoinRow:pub} (List<str>:fields) -> str
    §E{mut,alloc}
    §LIST{parts:str}
    §/LIST
    §EACH{f} fields
      §B{esc:str} §C{EscapeField} §A f §/C
      §PUSH{parts} esc
    §R (join "," parts)

  §F{SplitRow:pub} (str:line) -> List<str>
    §E{mut,alloc}
    §LIST{result:str}
    §/LIST
    §B{~i:i32} 0
    §B{n:i32} (len line)
    §B{~more:bool} true
    §WH more
      §B{~field:str} ""
      §IF (&& (< i n) (equals (substr line i 1) "\""))
        §ASSIGN i (+ i 1)
        §B{~inq:bool} true
        §WH inq
          §IF (>= i n)
            §ASSIGN inq false
          §EI (equals (substr line i 1) "\"")
            §IF (&& (< (+ i 1) n) (equals (substr line (+ i 1) 1) "\""))
              §ASSIGN field (concat field "\"")
              §ASSIGN i (+ i 2)
            §EL
              §ASSIGN i (+ i 1)
              §ASSIGN inq false
          §EL
            §ASSIGN field (concat field (substr line i 1))
            §ASSIGN i (+ i 1)
      §EL
        §B{start:i32} i
        §WH (&& (< i n) (! (equals (substr line i 1) ",")))
          §ASSIGN i (+ i 1)
        §ASSIGN field (substr line start (- i start))
      §PUSH{result} field
      §IF (&& (< i n) (equals (substr line i 1) ","))
        §ASSIGN i (+ i 1)
      §EL
        §ASSIGN more false
    §R result
