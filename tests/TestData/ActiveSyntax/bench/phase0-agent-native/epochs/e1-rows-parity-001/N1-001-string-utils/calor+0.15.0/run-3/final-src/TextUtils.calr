§M{TextUtils}
  §F{Slugify:pub} (str:s) -> str
    §E{}
    §B{lower:str} §C{s.ToLowerInvariant} §/C
    §R §C{lower.Replace} §A " " §A "-" §/C

  §F{Truncate:pub} (str:s, i32:maxLen) -> str
    §E{}
    §IF (<= (len s) maxLen)
      §R s
    §IF (> maxLen 3)
      §R (+ (substr s 0 (- maxLen 3)) "...")
    §R (substr s 0 maxLen)

  §F{WordCount:pub} (str:s) -> i32
    §E{}
    §B{~count:i32} 0
    §B{~inWord:bool} false
    §L{i:0:(- (len s) 1):1}
      §B{c:char} (char-at s i)
      §IF (is-whitespace c)
        §ASSIGN inWord false
      §EL
        §IF (! inWord)
          §ASSIGN count (+ count 1)
          §ASSIGN inWord true
    §R count
