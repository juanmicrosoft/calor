module CsvRow CsvRow block
  module CsvRowModule public
    func NeedsQuoting (string:@field) → bool
      !
      return ((@field).Contains(",") || ((@field).Contains("\"") || ((@field).Contains("\r") || (@field).Contains("\n"))))

    func EscapeField (string:@field) → string
      !
      let needs = NeedsQuoting(@field)
      if needs
        let doubled = (@field).Replace("\"", "\"\"")
        return string.Concat("\"", doubled, "\"")
      else
        return @field

    func JoinRow (List<string>:fields) → string
      !
      let result = ""
      let first = true
      each string:@field in fields
        let esc = EscapeField(@field)
        if first
          set result esc
          set first false
        else
          set result string.Concat(result, ",", esc)
      return result

    func SplitRow (string:line) → List<string>
      ! mut, alloc
      let List<string>:result = new List<string>()
      let i = 0
      let n = line.Length
      let done = false
      while (!done)
        let @field = ""
        if ((i < n) && (((int)(line)[i]) == 34))
          set i (i + 1)
          let qdone = false
          while ((!qdone) && (i < n))
            let c = (line)[i]
            if (((int)c) == 34)
              if (((i + 1) < n) && (((int)(line)[(i + 1)]) == 34))
                set @field string.Concat(@field, "\"")
                set i (i + 2)
              else
                set i (i + 1)
                set qdone true
            else
              set @field string.Concat(@field, (c).ToString())
              set i (i + 1)
        else
          while ((i < n) && (!(((int)(line)[i]) == 44)))
            let c2 = (line)[i]
            set @field string.Concat(@field, (c2).ToString())
            set i (i + 1)
        result.Add(@field)
        if ((i < n) && (((int)(line)[i]) == 44))
          set i (i + 1)
        else
          set done true
      return result
