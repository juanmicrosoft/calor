§M{CsvRow}
  §F{NeedsQuoting:pub} (str:field) -> bool
    §E{}
    §R (|| (contains field ",") (|| (contains field "\"") (|| (contains field "\r") (contains field "\n"))))

  §F{EscapeField:pub} (str:field) -> str
    §E{}
    §B{q:bool} §C{NeedsQuoting} §A field §/C
    §IF (! q)
      §R field
    §B{doubled:str} (replace field "\"" "\"\"")
    §R (+ "\"" (+ doubled "\""))

  §F{JoinRow:pub} (List<str>:fields) -> str
    §E{}
    §B{~result:str} ""
    §EACH{f:str:idx} fields
      §IF (> idx 0)
        §ASSIGN result (+ result ",")
      §B{esc:str} §C{EscapeField} §A f §/C
      §ASSIGN result (+ result esc)
    §R result

  §F{SplitRow:pub} (str:line) -> List<str>
    §E{mut,alloc}
    §LIST{result:str}
    §/LIST
    §B{n:i32} (len line)
    §B{~i:i32} 0
    §B{~more:bool} true
    §WH more
      §B{~field:str} ""
      §IF (&& (< i n) (equals (substr line i 1) "\""))
        §ASSIGN i (+ i 1)
        §B{~inq:bool} true
        §WH inq
          §IF (>= i n)
            §ASSIGN inq false
          §EI (equals (substr line i 1) "\"")
            §IF (&& (< (+ i 1) n) (equals (substr line (+ i 1) 1) "\""))
              §ASSIGN field (+ field "\"")
              §ASSIGN i (+ i 2)
            §EL
              §ASSIGN i (+ i 1)
              §ASSIGN inq false
          §EL
            §ASSIGN field (+ field (substr line i 1))
            §ASSIGN i (+ i 1)
      §EL
        §WH (&& (< i n) (! (equals (substr line i 1) ",")))
          §ASSIGN field (+ field (substr line i 1))
          §ASSIGN i (+ i 1)
      §PUSH{result} field
      §IF (&& (< i n) (equals (substr line i 1) ","))
        §ASSIGN i (+ i 1)
        §IF (>= i n)
          §PUSH{result} ""
          §ASSIGN more false
      §EL
        §ASSIGN more false
    §R result
