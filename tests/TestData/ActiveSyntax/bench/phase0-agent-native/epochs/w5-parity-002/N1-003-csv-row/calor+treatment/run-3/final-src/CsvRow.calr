module CsvRow CsvRow block
  module CsvRowModule public
    func NeedsQuoting (string:@field) → bool
      !
      return ((@field).Contains(",") || ((@field).Contains("\"") || ((@field).Contains("\r") || (@field).Contains("\n"))))

    func EscapeField (string:@field) → string
      !
      let nq = NeedsQuoting(@field)
      if nq
        return (("\"" + (@field).Replace("\"", "\"\"")) + "\"")
      else
        return @field

    func JoinRow (List<string>:fields) → string
      !
      var result = ""
      var i = 0
      let n = fields.Count
      while (i < n)
        if (i > 0)
          var result = (result + ",")
        let item = fields[i]
        let esc = EscapeField(item)
        var result = (result + esc)
        var i = (i + 1)
      return result

    func SplitRow (string:line) → List<string>
      ! mut, alloc
      let fields = new List<string>()
      var cur = ""
      var inQuotes = false
      var i = 0
      let n = line.Length
      while (i < n)
        let ch = (line).Substring(i, 1)
        if inQuotes
          if (ch).Equals("\"")
            if (((i + 1) < n) && ((line).Substring((i + 1), 1)).Equals("\""))
              var cur = (cur + "\"")
              var i = (i + 2)
            else
              var inQuotes = false
              var i = (i + 1)
          else
            var cur = (cur + ch)
            var i = (i + 1)
        else if (ch).Equals("\"")
          var inQuotes = true
          var i = (i + 1)
        else if (ch).Equals(",")
          fields.Add(cur)
          var cur = ""
          var i = (i + 1)
        else
          var cur = (cur + ch)
          var i = (i + 1)
      fields.Add(cur)
      return fields
