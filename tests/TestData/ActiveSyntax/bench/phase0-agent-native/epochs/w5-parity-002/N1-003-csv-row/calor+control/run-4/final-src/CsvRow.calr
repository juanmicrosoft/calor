module CsvRow CsvRow block
  module CsvRowModule public
    func NeedsQuoting (string:@field) → bool
      !
      return ((@field).Contains(",") || ((@field).Contains("\"") || ((@field).Contains("\r") || (@field).Contains("\n"))))

    func EscapeField (string:@field) → string
      !
      let needs = NeedsQuoting(@field)
      if needs
        return string.Concat("\"", (@field).Replace("\"", "\"\""), "\"")
      else
        return @field

    func JoinRow (List<string>:fields) → string
      !
      var result = ""
      var first = true
      each f in fields
        let esc = EscapeField(f)
        if first
          set result esc
          set first false
        else
          set result string.Concat(result, ",", esc)
      return result

    func SplitRow (string:line) → List<string>
      ! mut, alloc
      let result = new List<string>()
      var current = ""
      var inQuotes = false
      var i = 0
      let n = line.Length
      while (i < n)
        let ch = (line).Substring(i, 1)
        if inQuotes
          if (ch == "\"")
            if (((i + 1) < n) && ((line).Substring((i + 1), 1) == "\""))
              set current (current + "\"")
              set i (i + 2)
            else
              set inQuotes false
              set i (i + 1)
          else
            set current (current + ch)
            set i (i + 1)
        else if (ch == "\"")
          set inQuotes true
          set i (i + 1)
        else if (ch == ",")
          result.Add(current)
          set current ""
          set i (i + 1)
        else
          set current (current + ch)
          set i (i + 1)
      result.Add(current)
      return result
