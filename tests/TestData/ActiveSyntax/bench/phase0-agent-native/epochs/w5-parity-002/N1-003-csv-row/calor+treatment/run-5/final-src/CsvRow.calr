§M{CsvRow}
  §F{NeedsQuoting:pub} (str:field) -> bool
    §E{}
    §R (|| (contains field ",") (|| (contains field "\"") (|| (contains field "\r") (contains field "\n"))))

  §F{EscapeField:pub} (str:field) -> str
    §E{}
    §B{needs} §C{NeedsQuoting} field
    §IF needs
      §R (concat "\"" (concat (replace field "\"" "\"\"") "\""))
    §EL
      §R field

  §F{JoinRow:pub} (List<str>:fields) -> str
    §E{}
    §B{~result} STR:""
    §B{~first} BOOL:true
    §EACH{f} fields
      §B{esc} §C{EscapeField} f
      §IF first
        §ASSIGN first false
      §EL
        §ASSIGN result (concat result ",")
      §ASSIGN result (concat result esc)
    §R result

  §F{SplitRow:pub} (str:line) -> List<str>
    §E{mut,alloc}
    §B{result} §NEW{List<str>} §/NEW
    §B{~field} STR:""
    §B{~i} INT:0
    §B{~inq} BOOL:false
    §B{n} (len line)
    §WH (< i n)
      §B{c} (substr line i 1)
      §IF inq
        §IF (== c "\"")
          §IF (&& (< (+ i 1) n) (== (substr line (+ i 1) 1) "\""))
            §ASSIGN field (concat field "\"")
            §ASSIGN i (+ i 2)
          §EL
            §ASSIGN inq false
            §ASSIGN i (+ i 1)
        §EL
          §ASSIGN field (concat field c)
          §ASSIGN i (+ i 1)
      §EL
        §IF (== c ",")
          §C{result.Add} field
          §ASSIGN field ""
          §ASSIGN i (+ i 1)
        §EI (== c "\"")
          §ASSIGN inq true
          §ASSIGN i (+ i 1)
        §EL
          §ASSIGN field (concat field c)
          §ASSIGN i (+ i 1)
    §C{result.Add} field
    §R result
