module CsvRow CsvRow block
  module CsvRowModule public
    func NeedsQuoting (string:@field) → bool
      !
      return ((@field).Contains(",") || ((@field).Contains("\"") || ((@field).Contains("\r") || (@field).Contains("\n"))))

    func EscapeField (string:@field) → string
      !
      let needs = NeedsQuoting(@field)
      if needs
        return string.Concat("\"", string.Concat((@field).Replace("\"", "\"\""), "\""))
      else
        return @field

    func JoinRow (List<string>:fields) → string
      !
      var result = ""
      var first = true
      each f in fields
        let esc = EscapeField(f)
        if first
          set first false
        else
          set result string.Concat(result, ",")
        set result string.Concat(result, esc)
      return result

    func SplitRow (string:line) → List<string>
      ! mut, alloc
      let result = new List<string>()
      var @field = ""
      var i = 0
      var inq = false
      let n = line.Length
      while (i < n)
        let c = (line).Substring(i, 1)
        if inq
          if (c == "\"")
            if (((i + 1) < n) && ((line).Substring((i + 1), 1) == "\""))
              set @field string.Concat(@field, "\"")
              set i (i + 2)
            else
              set inq false
              set i (i + 1)
          else
            set @field string.Concat(@field, c)
            set i (i + 1)
        else if (c == ",")
          result.Add(@field)
          set @field ""
          set i (i + 1)
        else if (c == "\"")
          set inq true
          set i (i + 1)
        else
          set @field string.Concat(@field, c)
          set i (i + 1)
      result.Add(@field)
      return result
