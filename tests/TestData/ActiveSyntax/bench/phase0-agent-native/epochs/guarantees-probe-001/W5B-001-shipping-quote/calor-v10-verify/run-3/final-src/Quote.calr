module Quote Quote block
  module QuoteModule public
    func BaseFee (int:weight) → int
      !
      return (weight * 3)

    func DistanceFee (int:distance) → int
      !
      return (distance * 2)

    func QuoteWithSurcharge (int:baseAmount, int:surcharge, int:cap) → int
      !
      => (result <= cap)
      let int:total = (baseAmount + surcharge)
      if (total > cap)
        return cap
      return total

    func QuoteTotal (int:weight, int:distance, int:cap) → int
      !
      let int:baseAmount = BaseFee(weight)
      let int:extra = DistanceFee(distance)
      return QuoteWithSurcharge(baseAmount, extra, cap)

    func QuoteWithFloor (int:baseAmount, int:surcharge, int:cap, int:floor) → int
      !
      let int:total = (baseAmount + surcharge)
      if (total > cap)
        if (floor > cap)
          return floor
        else
          return cap
      else if (floor > total)
        return floor
      else
        return total

    func FormatQuote (int:amount) → string
      !
      return string.Concat("quote: ", (amount).ToString())
