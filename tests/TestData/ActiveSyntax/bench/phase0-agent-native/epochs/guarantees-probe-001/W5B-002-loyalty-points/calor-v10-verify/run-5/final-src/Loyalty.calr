module Loyalty Loyalty block
  module LoyaltyModule public
    func BasePoints (int:spend) → int
      !
      return (spend * 2)

    func BonusPoints (int:visits) → int
      !
      return (visits * 5)

    func AwardWithFloor (int:earned, int:bonus, int:minPoints) → int
      !
      => (result >= minPoints)
      let int:total = (earned + bonus)
      if (total < minPoints)
        return minPoints
      return total

    func TotalAward (int:spend, int:visits, int:minPoints) → int
      !
      let int:earned = BasePoints(spend)
      let int:bonus = BonusPoints(visits)
      return AwardWithFloor(earned, bonus, minPoints)

    func AwardWithCap (int:earned, int:bonus, int:minPoints, int:maxPoints) → int
      !
      let int:total = (earned + bonus)
      if (total < minPoints)
        if (minPoints > maxPoints)
          return maxPoints
        return minPoints
      if (total > maxPoints)
        return maxPoints
      return total

    func FormatAward (int:points) → string
      !
      return string.Concat("points: ", (points).ToString())
