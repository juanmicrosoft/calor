§M{Loyalty}
  §F{BasePoints:pub} (i32:spend) -> i32
    §E{}
    §R (* spend 2)

  §F{BonusPoints:pub} (i32:visits) -> i32
    §E{}
    §R (* visits 5)

  §F{AwardWithFloor:pub} (i32:earned, i32:bonus, i32:minPoints) -> i32
    §E{}
    §S (>= result minPoints)
    §B{total:i32} (+ earned bonus)
    §IF (< total minPoints)
      §R minPoints
    §R total

  §F{TotalAward:pub} (i32:spend, i32:visits, i32:minPoints) -> i32
    §E{}
    §B{earned:i32} §C{BasePoints} §A spend §/C
    §B{bonus:i32} §C{BonusPoints} §A visits §/C
    §R §C{AwardWithFloor} §A earned §A bonus §A minPoints §/C

  §F{AwardWithCap:pub} (i32:earned, i32:bonus, i32:minPoints, i32:maxPoints) -> i32
    §E{}
    §B{award:i32} §C{AwardWithFloor} §A earned §A bonus §A minPoints §/C
    §IF (> award maxPoints)
      §R maxPoints
    §R award

  §F{FormatAward:pub} (i32:points) -> str
    §E{}
    §R (concat "points: " (str points))
