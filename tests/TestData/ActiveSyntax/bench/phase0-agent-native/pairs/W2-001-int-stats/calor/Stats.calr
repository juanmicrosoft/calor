module Stats Stats block
  module StatsModule partial
    func Min (int[]:values) → int
      !
      requires (values.Length > 0)
      var int:smallest = values[0]
      var int:i = 1
      while (i < values.Length)
        let int:v = values[i]
        if (v < smallest)
          set smallest v
        set i (i + 1)
      return smallest

    func Max (int[]:values) → int
      !
      requires (values.Length > 0)
      var int:largest = values[0]
      var int:i = 1
      while (i < values.Length)
        let int:v = values[i]
        if (v > largest)
          set largest v
        set i (i + 1)
      return largest


