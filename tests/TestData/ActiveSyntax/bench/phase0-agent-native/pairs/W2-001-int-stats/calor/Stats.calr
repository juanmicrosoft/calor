module Stats Stats block
  module StatsModule partial
    func Min (int[]:values | (#.Length > 0)) → int
      !
      var int:smallest = values[0]
      var int:i = 1
      while (i < values.Length)
        let int:v = values[i]
        if (v < smallest)
          set smallest v
        set i (i + 1)
      return smallest

    func Max (int[]:values | (#.Length > 0)) → int
      !
      var int:largest = values[0]
      var int:i = 1
      while (i < values.Length)
        let int:v = values[i]
        if (v > largest)
          set largest v
        set i (i + 1)
      return largest


