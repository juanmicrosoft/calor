§M{Stats}
  §F{Min:pub} ([i32]:values) -> i32
    §E{}
    §Q (> §LEN values 0)
    §B{~smallest:i32} §IDX values 0
    §B{~i:i32} 1
    §WH (< i (len values))
      §B{v:i32} §IDX values i
      §IF (< v smallest)
        §ASSIGN smallest v
      §ASSIGN i (+ i 1)
    §R smallest

  §F{Max:pub} ([i32]:values) -> i32
    §E{}
    §Q (> §LEN values 0)
    §B{~largest:i32} §IDX values 0
    §B{~i:i32} 1
    §WH (< i (len values))
      §B{v:i32} §IDX values i
      §IF (> v largest)
        §ASSIGN largest v
      §ASSIGN i (+ i 1)
    §R largest
