§M{Stats}
  §F{Min:pub} ([i32]:values) -> i32
    §E{}
    §Q (> §LEN values 0)
    §B{~smallest:i32} §IDX values 0
    §B{~i:i32} 1
    §WH (< i (len values))
      §B{v:i32} §IDX values i
      §IF (< v smallest)
        §ASSIGN smallest v
      §ASSIGN i (+ i 1)
    §R smallest

  §F{Max:pub} ([i32]:values) -> i32
    §E{}
    §Q (> §LEN values 0)
    §B{~largest:i32} §IDX values 0
    §B{~i:i32} 1
    §WH (< i (len values))
      §B{v:i32} §IDX values i
      §IF (> v largest)
        §ASSIGN largest v
      §ASSIGN i (+ i 1)
    §R largest

  §F{Sum:pub} ([i32]:values) -> i32
    §E{}
    §B{~total:i32} 0
    §B{~i:i32} 0
    §WH (< i (len values))
      §B{v:i32} §IDX values i
      §ASSIGN total (+ total v)
      §ASSIGN i (+ i 1)
    §R total

  §F{Mean:pub} ([i32]:values) -> i32
    §E{}
    §Q (> §LEN values 0)
    §B{total:i32} §C{Sum} §A values §/C
    §B{n:i32} §LEN values
    §R (/ total n)

  §F{Clamp:pub} (i32:value, i32:lo, i32:hi) -> i32
    §E{}
    §Q (<= lo hi)
    §S (>= result lo)
    §S (<= result hi)
    §IF (< value lo)
      §R lo
    §IF (> value hi)
      §R hi
    §R value
