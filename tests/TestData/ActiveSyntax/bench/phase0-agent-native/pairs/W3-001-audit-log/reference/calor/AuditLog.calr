§M{AuditLog}
  §F{Append:pub} (str:path, str:entry) -> void
    §E{fs:w}
    §C{File.AppendAllText} §A path §A (+ entry "\n") §/C

  §F{CountEntries:pub} (str:path) -> i32
    §E{fs:r}
    §B{exists:bool} §C{File.Exists} §A path §/C
    §IF (! exists)
      §R INT:0
    §B{lines:[str]} §C{File.ReadAllLines} §A path §/C
    §R §LEN lines

  §F{LastEntry:pub} (str:path) -> str
    §E{fs:r}
    §B{exists:bool} §C{File.Exists} §A path §/C
    §IF (! exists)
      §R ""
    §B{lines:[str]} §C{File.ReadAllLines} §A path §/C
    §IF (== §LEN lines INT:0)
      §R ""
    §R §IDX lines (- §LEN lines INT:1)
