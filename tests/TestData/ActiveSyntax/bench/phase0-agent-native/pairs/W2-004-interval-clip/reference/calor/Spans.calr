module Spans Spans block
  module SpansModule partial
    func TotalCovered (int[]:starts, int[]:ends) → int
      !
      requires (starts.Length == ends.Length)
      => (result >= 0)
      var int:total = 0
      var int:i = 0
      while (i < starts.Length)
        set total (total + (ends[i] - starts[i]))
        set i (i + 1)
      return total

    func ContainsPoint (int[]:starts, int[]:ends, int:x) → bool
      !
      requires (starts.Length == ends.Length)
      var int:i = 0
      while (i < starts.Length)
        if ((x >= starts[i]) && (x < ends[i]))
          return true
        set i (i + 1)
      return false

    func ClipCovered (int[]:starts, int[]:ends, int:lo, int:hi) → int
      !
      requires (starts.Length == ends.Length)
      requires (lo <= hi)
      => (result >= 0)
      var int:total = 0
      var int:i = 0
      while (i < starts.Length)
        var int:s = starts[i]
        var int:e = ends[i]
        if (s < lo)
          set s lo
        if (e > hi)
          set e hi
        if (e > s)
          set total (total + (e - s))
        set i (i + 1)
      return total

    func GapCount (int[]:starts, int[]:ends) → int
      !
      requires (starts.Length == ends.Length)
      => (result >= 0)
      var int:n = 0
      var int:i = 1
      while (i < starts.Length)
        if (starts[i] > ends[(i - 1)])
          set n (n + 1)
        set i (i + 1)
      return n


