module Ledger Ledger block
  module LedgerModule partial
    func EntryFee (int:amount | ((# > 0) && (# < 1000000))) → int
      !
      => (result >= 0)
      return (amount / 100)

    func IsValidAccount (int:account, int:accountCount) → bool
      !
      return ((account >= 0) && (account < accountCount))

    func IsValidAmount (int:amount) → bool
      !
      return ((amount > 0) && (amount < 1000000))

    func PostEntry (int[]:debits, int[]:credits, int[]:amounts, int:count | ((((# >= 0) && (# < debits.Length)) && (# < credits.Length)) && (# < amounts.Length)), int:debitAcct, int:creditAcct, int:amount) → int
      ! mut
      => (result == (count + 1))
      set debits[count] debitAcct
      set credits[count] creditAcct
      set amounts[count] amount
      return (count + 1)

    func AccountBalance (int[]:debits, int[]:credits, int[]:amounts, int:count | ((((# >= 0) && (# <= debits.Length)) && (# <= credits.Length)) && (# <= amounts.Length)), int:account) → int
      !
      var int:total = 0
      var int:i = 0
      while (i < count)
        let int:amt = amounts[i]
        if (credits[i] == account)
          set total (total + amt)
        if (debits[i] == account)
          set total (total - amt)
        set i (i + 1)
      return total

    func TotalDebited (int[]:debits, int[]:amounts, int:count | (((# >= 0) && (# <= debits.Length)) && (# <= amounts.Length)), int:account) → int
      !
      var int:total = 0
      var int:i = 0
      while (i < count)
        if (debits[i] == account)
          let int:amt = amounts[i]
          set total (total + amt)
        set i (i + 1)
      return total

    func TotalCredited (int[]:credits, int[]:amounts, int:count | (((# >= 0) && (# <= credits.Length)) && (# <= amounts.Length)), int:account) → int
      !
      var int:total = 0
      var int:i = 0
      while (i < count)
        if (credits[i] == account)
          let int:amt = amounts[i]
          set total (total + amt)
        set i (i + 1)
      return total

    func TotalVolume (int[]:amounts, int:count | ((# >= 0) && (# <= amounts.Length))) → int
      !
      var int:total = 0
      var int:i = 0
      while (i < count)
        set total (total + amounts[i])
        set i (i + 1)
      return total

    func FeesCollected (int[]:credits, int[]:amounts, int:count | (((# >= 0) && (# <= credits.Length)) && (# <= amounts.Length))) → int
      !
      let int:fees = TotalCredited(credits, amounts, count, 0)
      return fees

    func TransferCost (int:amount | ((# > 0) && (# < 1000000))) → int
      !
      => (result >= amount)
      return (amount + (amount / 100))

    func CanAfford (int:balance, int:amount | ((# > 0) && (# < 1000000))) → bool
      !
      let int:cost = TransferCost(amount)
      return (balance >= cost)

    func Transfer (int[]:debits, int[]:credits, int[]:amounts, int:count | ((((# >= 0) && ((# + 2) <= debits.Length)) && ((# + 2) <= credits.Length)) && ((# + 2) <= amounts.Length)), int:fromAcct, int:toAcct, int:amount) → int
      ! mut
      => (result >= (count + 1))
      let int:next = PostEntry(debits, credits, amounts, count, fromAcct, toAcct, amount)
      let int:fee = EntryFee(amount)
      if (fee > 0)
        let int:next2 = PostEntry(debits, credits, amounts, next, fromAcct, 0, fee)
        return next2
      return next

    func BatchPost (int[]:debits, int[]:credits, int[]:amounts, int:count | (# >= 0), int[]:fromAccts, int[]:toAccts, int[]:batchAmounts, int:n | (((((((# >= 0) && (# <= fromAccts.Length)) && (# <= toAccts.Length)) && (# <= batchAmounts.Length)) && ((count + #) <= debits.Length)) && ((count + #) <= credits.Length)) && ((count + #) <= amounts.Length))) → int
      ! mut
      var int:cur = count
      var int:i = 0
      while (i < n)
        let int:fromAcct = fromAccts[i]
        let int:toAcct = toAccts[i]
        let int:amt = batchAmounts[i]
        set cur PostEntry(debits, credits, amounts, cur, fromAcct, toAcct, amt)
        set i (i + 1)
      return cur

    func BatchTransfer (int[]:debits, int[]:credits, int[]:amounts, int:count | (# >= 0), int[]:fromAccts, int[]:toAccts, int[]:batchAmounts, int:n | (((((((# >= 0) && (# <= fromAccts.Length)) && (# <= toAccts.Length)) && (# <= batchAmounts.Length)) && ((count + (2 * #)) <= debits.Length)) && ((count + (2 * #)) <= credits.Length)) && ((count + (2 * #)) <= amounts.Length))) → int
      ! mut
      var int:cur = count
      var int:i = 0
      while (i < n)
        let int:fromAcct = fromAccts[i]
        let int:toAcct = toAccts[i]
        let int:amt = batchAmounts[i]
        set cur PostEntry(debits, credits, amounts, cur, fromAcct, toAcct, amt)
        let int:fee = (amt / 100)
        if (fee > 0)
          set cur PostEntry(debits, credits, amounts, cur, fromAcct, 0, fee)
        set i (i + 1)
      return cur


