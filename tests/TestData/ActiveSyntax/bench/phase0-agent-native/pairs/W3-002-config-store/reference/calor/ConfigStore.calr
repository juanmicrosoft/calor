§M{ConfigStore}
  §F{Get:pub} (str:path, str:key) -> str
    §E{fs:r}
    §B{exists:bool} §C{File.Exists} §A path §/C
    §IF (! exists)
      §R ""
    §B{prefix:str} (+ key "=")
    §B{lines:[str]} §C{File.ReadAllLines} §A path §/C
    §EACH{line} lines
      §B{matches:bool} §C{line.StartsWith} §A prefix §/C
      §IF matches
        §R §C{line.Substring} §A §LEN prefix §/C
    §R ""

  §F{Set:pub} (str:path, str:key, str:value) -> void
    §E{fs:rw}
    §B{prefix:str} (+ key "=")
    §B{~content:str} ""
    §B{~found:bool} false
    §B{exists:bool} §C{File.Exists} §A path §/C
    §IF exists
      §B{lines:[str]} §C{File.ReadAllLines} §A path §/C
      §EACH{line} lines
        §B{matches:bool} §C{line.StartsWith} §A prefix §/C
        §IF (&& (! found) matches)
          §ASSIGN content (+ content (+ prefix (+ value "\n")))
          §ASSIGN found true
        §EL
          §ASSIGN content (+ content (+ line "\n"))
    §IF (! found)
      §ASSIGN content (+ content (+ prefix (+ value "\n")))
    §C{File.WriteAllText} §A path §A content §/C

  §F{Has:pub} (str:path, str:key) -> bool
    §E{fs:r}
    §B{exists:bool} §C{File.Exists} §A path §/C
    §IF (! exists)
      §R false
    §B{prefix:str} (+ key "=")
    §B{lines:[str]} §C{File.ReadAllLines} §A path §/C
    §EACH{line} lines
      §B{matches:bool} §C{line.StartsWith} §A prefix §/C
      §IF matches
        §R true
    §R false
