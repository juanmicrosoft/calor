§M{KvJournal}
  §F{Set:pub} (str:path, str:key, str:value) -> void
    §E{fs:w}
    §C{File.AppendAllText} §A path §A (+ key (+ "=" (+ value "\n"))) §/C

  §F{KeyOf:priv} (str:line) -> str
    §E{}
    §B{eq:i32} (indexof line "=" :ordinal)
    §IF (< eq 0)
      §R line
    §R (substr line 0 eq)

  §F{ValueOf:priv} (str:line) -> str
    §E{}
    §B{eq:i32} (indexof line "=" :ordinal)
    §IF (< eq 0)
      §R ""
    §R (substr line (+ eq 1) (- (len line) (+ eq 1)))

  §F{Get:pub} (str:path, str:key) -> str
    §E{fs:r}
    §B{exists:bool} §C{File.Exists} §A path §/C
    §IF (! exists)
      §R ""
    §B{lines:[str]} §C{File.ReadAllLines} §A path §/C
    §B{~found:str} ""
    §EACH{ln} lines
      §B{k:str} §C{KeyOf} §A ln §/C
      §IF (== k key)
        §ASSIGN found §C{ValueOf} §A ln §/C
    §R found

  §F{CountKeys:pub} (str:path) -> i32
    §E{fs:r,mut,alloc}
    §B{exists:bool} §C{File.Exists} §A path §/C
    §IF (! exists)
      §R 0
    §B{lines:[str]} §C{File.ReadAllLines} §A path §/C
    §LIST{seen:str}
    §/LIST
    §EACH{ln} lines
      §B{k:str} §C{KeyOf} §A ln §/C
      §IF (! §HAS{seen} k)
        §PUSH{seen} k
    §R §CNT{seen}

  §F{Compact:pub} (str:path) -> void
    §E{fs:rw,mut,alloc}
    §B{exists:bool} §C{File.Exists} §A path §/C
    §IF (! exists)
      §R
    §B{lines:[str]} §C{File.ReadAllLines} §A path §/C
    §LIST{order:str}
    §/LIST
    §EACH{ln} lines
      §B{k:str} §C{KeyOf} §A ln §/C
      §IF (! §HAS{order} k)
        §PUSH{order} k
    §B{~text:str} ""
    §EACH{k2} order
      §B{v:str} §C{Get} §A path §A k2 §/C
      §ASSIGN text (+ text (+ k2 (+ "=" (+ v "\n"))))
    §C{File.WriteAllText} §A path §A text §/C
