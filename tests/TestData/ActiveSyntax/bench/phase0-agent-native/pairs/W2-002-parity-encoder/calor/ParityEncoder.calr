module ParityEncoder ParityEncoder block
  module ParityEncoderModule partial
    func Encode (int[]:values) → int
      !
      var int:odd = 0
      var int:i = 0
      while (i < values.Length)
        let int:v = values[i]
        if ((v % 2) != 0)
          set odd (odd + 1)
        set i (i + 1)
      let int:n = values.Length
      return ((odd * 65536) + n)


