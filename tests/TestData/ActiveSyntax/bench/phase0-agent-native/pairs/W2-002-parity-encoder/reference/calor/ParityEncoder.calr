module ParityEncoder ParityEncoder block
  module ParityEncoderModule partial
    func Encode (int[]:values) → int
      !
      var int:odd = 0
      var int:i = 0
      while (i < values.Length)
        let int:v = values[i]
        if ((v % 2) != 0)
          set odd (odd + 1)
        set i (i + 1)
      let int:n = values.Length
      return ((odd * 65536) + n)

    func IsValidLength (int[]:values, int:expectedLength | (# >= 0)) → bool
      !
      let int:n = values.Length
      return (n == expectedLength)

    func CountEven (int[]:values) → int
      !
      => (result >= 0)
      => (result <= values.Length)
      var int:count = 0
      var int:i = 0
      while (i < values.Length)
        let int:v = values[i]
        if ((v % 2) == 0)
          set count (count + 1)
        set i (i + 1)
      return count

    func IndexOfFirstOdd (int[]:values) → int
      !
      => (result >= -1)
      => (result < values.Length)
      var int:i = 0
      while (i < values.Length)
        let int:v = values[i]
        if ((v % 2) != 0)
          return i
        set i (i + 1)
      return -1


