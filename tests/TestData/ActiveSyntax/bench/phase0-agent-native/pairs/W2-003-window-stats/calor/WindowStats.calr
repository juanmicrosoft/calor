module WindowStats WindowStats block
  module WindowStatsModule partial
    func WindowSum (int[]:values, int:start, int:count) → int
      !
      requires (start >= 0)
      requires (count > 0)
      requires ((start + count) <= values.Length)
      var int:total = 0
      var int:i = start
      while (i < (start + count))
        set total (total + values[i])
        set i (i + 1)
      return total


