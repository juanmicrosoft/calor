module WindowStats WindowStats block
  module WindowStatsModule partial
    func WindowSum (int[]:values, int:start | (# >= 0), int:count | ((# > 0) && ((start + #) <= values.Length))) → int
      !
      var int:total = 0
      var int:i = start
      while (i < (start + count))
        set total (total + values[i])
        set i (i + 1)
      return total

    func WindowMin (int[]:values, int:start | (# >= 0), int:count | ((# > 0) && ((start + #) <= values.Length))) → int
      !
      var int:best = values[start]
      var int:i = (start + 1)
      while (i < (start + count))
        let int:v = values[i]
        if (v < best)
          set best v
        set i (i + 1)
      return best

    func MaxWindowSum (int[]:values, int:count | ((# > 0) && (# <= values.Length))) → int
      !
      var int:best = WindowSum(values, 0, count)
      var int:s = 1
      while (s <= (values.Length - count))
        let int:cur = WindowSum(values, s, count)
        if (cur > best)
          set best cur
        set s (s + 1)
      return best

    func CountAbove (int[]:values, int:count | (# > 0), int:threshold) → int
      !
      => (result >= 0)
      if (count > values.Length)
        return 0
      var int:n = 0
      var int:s = 0
      while (s <= (values.Length - count))
        let int:cur = WindowSum(values, s, count)
        if (cur > threshold)
          set n (n + 1)
        set s (s + 1)
      return n


