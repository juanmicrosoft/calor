§M{L3M01}

  §F{l3m01_fn01:pub} (i32:x, i32:y) -> i32
    §E{}
    §Q (>= x 0)
    §S (<= result 23633)
    §B{total:i32} (+ (* x 2) y)
    §IF (> total 23633)
      §R 23633
    §R total

  §F{l3m01_fn02:pub} (i32:x, i32:y) -> i32
