§M{L3M25}

  §F{l3m25_fn01:pub} (i32:x, i32:y) -> i32
    §E{}
    §B{base:i32} (- (* x 4) y)
    §R (+ base 48)

  §F{l3m25_fn02:pub} (i32:x, i32:y) -> i32
    §E{}
    §Q (>= y 0)
    §S (>= result x)
    §S (>= result 24991)
    §IF (>= x 24991)
      §R x
    §EL
      §R 24991

  §F{l3m25_fn03:pub} (i32:x, i32:y) -> i32
    §E{}
    §Q (>= x 0)
    §S (<= result 24998)
    §B{total:i32} (+ (* x 2) y)
    §IF (> total 24998)
      §R 24998
    §R total

  §F{l3m25_fn04:pub} (i32:x, i32:y) -> i32
    §E{}
    §Q (>= x 1)
    §Q (>= y 0)
    §S (>= result 25005)
    §B{total:i32} (+ (* x 5) y)
    §IF (< total 25005)
      §R 25005
    §EL
      §R total

  §F{l3m25_fn05:pub} (i32:x, i32:y) -> i32
