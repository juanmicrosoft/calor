§M{L3M32}

  §F{l3m32_fn01:pub} (i32:x, i32:y) -> i32
    §E{}
    §Q (>= x 0)
    §S (<= result 25362)
    §B{total:i32} (+ (* x 3) y)
    §IF (> total 25362)
      §R 25362
    §R total

  §F{l3m32_fn02:pub} (i32:x, i32:y) -> i32
    §E{}
    §Q (> x 0)
    §S (>= x 1)
    §B{acc:i32} (+ (* x 2) y)
    §IF (> acc 25369)
      §R (+ acc 25369)
    §EL
      §R (+ (* acc 2) 25369)

  §F{l3m32_fn03:pub} (i32:x, i32:y) -> i32
    §E{}
