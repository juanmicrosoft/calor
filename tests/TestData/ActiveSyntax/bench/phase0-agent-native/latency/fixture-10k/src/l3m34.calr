§M{L3M34}

  §F{l3m34_fn01:pub} (i32:x, i32:y) -> i32
    §E{}
    §Q (>= x 5)
    §Q (>= y 0)
    §S (>= result 25460)
    §B{total:i32} (+ (* x 2) y)
    §IF (< total 25460)
      §R 25460
    §EL
      §R total

  §F{l3m34_fn02:pub} (i32:x, i32:y) -> i32
    §E{}
    §Q (>= x 1)
    §Q (>= y 0)
    §S (>= result 25467)
    §B{total:i32} (+ (* x 5) y)
    §IF (< total 25467)
      §R 25467
    §EL
      §R total

  §F{l3m34_fn03:pub} (i32:x, i32:y) -> i32
    §E{}
    §B{base:i32} (- (* x 4) y)
    §R (+ base 45)

  §F{l3m34_fn04:pub} (i32:x, i32:y) -> i32
