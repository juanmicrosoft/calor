§M{L3M21}

  §F{l3m21_fn01:pub} (i32:x, i32:y) -> i32
    §E{}
    §B{base:i32} (- (* x 4) y)
    §R (+ base 54)

  §F{l3m21_fn02:pub} (i32:x, i32:y) -> i32
    §E{}
    §Q (>= y 0)
    §S (>= result x)
    §S (>= result 24753)
    §IF (>= x 24753)
      §R x
    §EL
      §R 24753

