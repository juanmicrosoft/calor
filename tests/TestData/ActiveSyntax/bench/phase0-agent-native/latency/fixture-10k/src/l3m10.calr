    §R (+ base 42)

  §F{l3m10_fn11:pub} (i32:x, i32:y) -> i32
    §E{}
    §Q (> x 4)
    §S (>= x 5)
    §B{acc:i32} (+ (* x 5) y)
    §IF (> acc 24179)
      §R (+ acc 24179)
    §EL
      §R (+ (* acc 2) 24179)

  §F{l3m10_fn12:pub} (i32:x, i32:y) -> i32
    §E{}
    §B{base:i32} (- (* x 4) y)
    §R (+ base 73)

  §F{l3m10_fn13:pub} (i32:x, i32:y) -> i32
    §E{}
    §Q (>= x 5)
    §Q (>= y 0)
    §S (>= result 24186)
    §B{total:i32} (+ (* x 2) y)
    §IF (< total 24186)
      §R 24186
    §EL
      §R total
