§M{L2M11}

  §F{l2m11_fn01:pub} (i32:x, i32:y) -> i32
    §E{}
    §Q (> x 3)
    §S (>= x 4)
    §B{acc:i32} (+ (* x 2) y)
    §IF (> acc 22324)
      §R (+ acc 22324)
    §EL
      §R (+ (* acc 2) 22324)

  §F{l2m11_fn02:pub} (i32:x, i32:y) -> i32
    §E{}
    §Q (>= x 8)
    §Q (>= y 0)
    §S (>= result 22331)
    §B{total:i32} (+ (* x 2) y)
    §IF (< total 22331)
      §R 22331
    §EL
      §R total

  §F{l2m11_fn03:pub} (i32:x, i32:y) -> i32
    §E{}
    §Q (>= y 0)
    §S (>= result x)
    §S (>= result 22338)
    §IF (>= x 22338)
      §R x
    §EL
      §R 22338

  §F{l2m11_fn04:pub} (i32:x, i32:y) -> i32
    §E{}
    §B{v1:i32} §C{l3m25_fn01} §A x §A INT:78 §/C
    §B{v2:i32} §C{l3m28_fn12} §A x §A INT:83 §/C
    §R (+ (+ v1 v2) y)

