§M{L1M11}

  §F{l1m11_fn01:pub} (i32:x, i32:y) -> i32
    §E{}
    §Q (>= x 0)
    §S (<= result 20546)
    §B{total:i32} (+ (* x 3) y)
    §IF (> total 20546)
      §R 20546
    §R total

  §F{l1m11_fn02:pub} (i32:x, i32:y) -> i32
    §E{}
