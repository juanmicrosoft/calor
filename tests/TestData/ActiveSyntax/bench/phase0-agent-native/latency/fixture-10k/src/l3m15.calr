§M{L3M15}

  §F{l3m15_fn01:pub} (i32:x, i32:y) -> i32
    §E{}
    §Q (>= x 7)
    §Q (>= y 0)
    §S (>= result 24382)
    §B{total:i32} (+ (* x 5) y)
    §IF (< total 24382)
      §R 24382
    §EL
      §R total

  §F{l3m15_fn02:pub} (i32:x, i32:y) -> i32
