    §Q (>= y 0)
    §S (>= result 24984)
    §B{total:i32} (+ (* x 3) y)
    §IF (< total 24984)
      §R 24984
    §EL
      §R total

  §F{l3m24_fn11:pub} (i32:x, i32:y) -> i32
    §E{}
