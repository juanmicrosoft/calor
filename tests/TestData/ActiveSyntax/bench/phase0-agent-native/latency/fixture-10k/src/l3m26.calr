§M{L3M26}

  §F{l3m26_fn01:pub} (i32:x, i32:y) -> i32
    §E{}
    §Q (>= x 0)
    §S (<= result 25040)
    §B{total:i32} (+ (* x 3) y)
    §IF (> total 25040)
      §R 25040
    §R total

  §F{l3m26_fn02:pub} (i32:x, i32:y) -> i32
    §E{}
    §B{base:i32} (- (* x 4) y)
    §R (+ base 40)

  §F{l3m26_fn03:pub} (i32:x, i32:y) -> i32
    §E{}
    §Q (>= y 0)
    §S (>= result x)
    §S (>= result 25047)
    §IF (>= x 25047)
      §R x
    §EL
      §R 25047

  §F{l3m26_fn04:pub} (i32:x, i32:y) -> i32
    §E{}
    §B{base:i32} (- (* x 4) y)
    §R (+ base 7)

  §F{l3m26_fn05:pub} (i32:x, i32:y) -> i32
    §E{}
