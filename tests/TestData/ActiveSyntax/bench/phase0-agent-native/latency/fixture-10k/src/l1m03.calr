§M{L1M03}

  §F{l1m03_fn01:pub} (i32:x, i32:y) -> i32
    §E{}
    §Q (>= x 0)
    §S (<= result 20091)
    §B{total:i32} (+ (* x 2) y)
    §IF (> total 20091)
      §R 20091
    §R total

  §F{l1m03_fn02:pub} (i32:x, i32:y) -> i32
    §E{}
    §Q (> x 5)
    §S (>= x 6)
    §B{acc:i32} (+ (* x 3) y)
    §IF (> acc 20098)
      §R (+ acc 20098)
    §EL
      §R (+ (* acc 2) 20098)

  §F{l1m03_fn03:pub} (i32:x, i32:y) -> i32
    §E{}
