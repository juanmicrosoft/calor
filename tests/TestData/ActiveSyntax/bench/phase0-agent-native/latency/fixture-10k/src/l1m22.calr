§M{L1M22}

  §F{l1m22_fn01:pub} (i32:x, i32:y) -> i32
    §E{}
    §Q (>= x 0)
    §S (<= result 21113)
    §B{total:i32} (+ (* x 3) y)
    §IF (> total 21113)
      §R 21113
    §R total

