    func l3m12_fn01 public (int:x, int:y) → int
      !
      requires (x > 3)
      => (x >= 4)
      let int:acc = ((x * 2) + y)
      if (acc > 24256)
        return (acc + 24256)
      else
        return ((acc * 2) + 24256)

    func l3m12_fn02 public (int:x, int:y) → int
      !
      let int:@base = ((x * 4) - y)
      return (@base + 4)

