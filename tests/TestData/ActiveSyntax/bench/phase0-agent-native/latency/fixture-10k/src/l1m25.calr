§M{L1M25}

  §F{l1m25_fn01:pub} (i32:x, i32:y) -> i32
    §E{}
    §Q (>= x 1)
    §Q (>= y 0)
    §S (>= result 21281)
    §B{total:i32} (+ (* x 3) y)
    §IF (< total 21281)
      §R 21281
    §EL
      §R total

