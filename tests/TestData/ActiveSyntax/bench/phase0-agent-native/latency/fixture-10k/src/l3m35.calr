  §F{l3m35_fn06:pub} (i32:x, i32:y) -> i32
    §E{}
    §Q (>= x 0)
    §S (<= result 25537)
    §B{total:i32} (+ (* x 2) y)
    §IF (> total 25537)
      §R 25537
    §R total

  §F{l3m35_fn07:pub} (i32:x, i32:y) -> i32
    §E{}
