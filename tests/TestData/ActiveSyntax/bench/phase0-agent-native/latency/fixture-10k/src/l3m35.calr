§M{L3M35}

  §F{l3m35_fn01:pub} (i32:x, i32:y) -> i32
    §E{}
    §Q (>= y 0)
    §S (>= result x)
    §S (>= result 25516)
    §IF (>= x 25516)
      §R x
    §EL
      §R 25516

  §F{l3m35_fn02:pub} (i32:x, i32:y) -> i32
    §E{}
    §Q (> x 2)
    §S (>= x 3)
    §B{acc:i32} (+ (* x 2) y)
    §IF (> acc 25523)
      §R (+ acc 25523)
    §EL
      §R (+ (* acc 2) 25523)

  §F{l3m35_fn03:pub} (i32:x, i32:y) -> i32
    §E{}
    §B{base:i32} (- (* x 4) y)
    §R (+ base 20)

  §F{l3m35_fn04:pub} (i32:x, i32:y) -> i32
