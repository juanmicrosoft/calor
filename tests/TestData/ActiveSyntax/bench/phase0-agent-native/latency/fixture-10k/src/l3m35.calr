  §F{l3m35_fn08:pub} (i32:x, i32:y) -> i32
    §E{}
    §Q (>= x 3)
    §Q (>= y 0)
    §S (>= result 25544)
    §B{total:i32} (+ (* x 5) y)
    §IF (< total 25544)
