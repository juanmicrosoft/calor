§M{L3M11}

  §F{l3m11_fn01:pub} (i32:x, i32:y) -> i32
    §E{}
    §Q (>= x 2)
    §Q (>= y 0)
    §S (>= result 24193)
    §B{total:i32} (+ (* x 5) y)
    §IF (< total 24193)
      §R 24193
    §EL
      §R total

  §F{l3m11_fn02:pub} (i32:x, i32:y) -> i32
    §E{}
    §B{base:i32} (- (* x 4) y)
    §R (+ base 60)

  §F{l3m11_fn03:pub} (i32:x, i32:y) -> i32
    §E{}
    §Q (> x 6)
    §S (>= x 7)
    §B{acc:i32} (+ (* x 5) y)
    §IF (> acc 24200)
      §R (+ acc 24200)
    §EL
      §R (+ (* acc 2) 24200)

  §F{l3m11_fn04:pub} (i32:x, i32:y) -> i32
