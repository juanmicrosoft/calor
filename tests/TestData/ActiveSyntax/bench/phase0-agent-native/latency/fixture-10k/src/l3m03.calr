  §F{l3m03_fn05:pub} (i32:x, i32:y) -> i32
    §E{}
    §Q (> x 2)
    §S (>= x 3)
    §B{acc:i32} (+ (* x 3) y)
    §IF (> acc 23759)
      §R (+ acc 23759)
    §EL
      §R (+ (* acc 2) 23759)

  §F{l3m03_fn06:pub} (i32:x, i32:y) -> i32
    §E{}
