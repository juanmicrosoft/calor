  §F{l3m03_fn07:pub} (i32:x, i32:y) -> i32
    §E{}
    §Q (>= x 4)
    §Q (>= y 0)
    §S (>= result 23766)
    §B{total:i32} (+ (* x 2) y)
    §IF (< total 23766)
      §R 23766
    §EL
      §R total

  §F{l3m03_fn08:pub} (i32:x, i32:y) -> i32
    §E{}
    §Q (>= x 0)
