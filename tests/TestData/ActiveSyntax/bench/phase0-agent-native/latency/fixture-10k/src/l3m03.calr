§M{L3M03}

  §F{l3m03_fn01:pub} (i32:x, i32:y) -> i32
    §E{}
    §Q (>= y 0)
    §S (>= result x)
    §S (>= result 23745)
    §IF (>= x 23745)
      §R x
    §EL
      §R 23745

  §F{l3m03_fn02:pub} (i32:x, i32:y) -> i32
    §E{}
    §B{base:i32} (- (* x 4) y)
    §R (+ base 72)

  §F{l3m03_fn03:pub} (i32:x, i32:y) -> i32
