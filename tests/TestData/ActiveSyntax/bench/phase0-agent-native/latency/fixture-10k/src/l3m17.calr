§M{L3M17}

  §F{l3m17_fn01:pub} (i32:x, i32:y) -> i32
    §E{}
    §Q (>= x 4)
    §Q (>= y 0)
    §S (>= result 24501)
    §B{total:i32} (+ (* x 2) y)
    §IF (< total 24501)
      §R 24501
    §EL
      §R total

  §F{l3m17_fn02:pub} (i32:x, i32:y) -> i32
    §E{}
    §Q (> x 1)
    §S (>= x 2)
    §B{acc:i32} (+ (* x 3) y)
    §IF (> acc 24508)
      §R (+ acc 24508)
    §EL
      §R (+ (* acc 2) 24508)

  §F{l3m17_fn03:pub} (i32:x, i32:y) -> i32
