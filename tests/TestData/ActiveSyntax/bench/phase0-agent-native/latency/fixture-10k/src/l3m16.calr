§M{L3M16}

  §F{l3m16_fn01:pub} (i32:x, i32:y) -> i32
    §E{}
    §Q (>= x 6)
    §Q (>= y 0)
    §S (>= result 24445)
    §B{total:i32} (+ (* x 3) y)
    §IF (< total 24445)
      §R 24445
    §EL
      §R total

