§M{L2M32}

  §F{l2m32_fn01:pub} (i32:x, i32:y) -> i32
    §E{}
    §Q (>= x 4)
    §Q (>= y 0)
    §S (>= result 23395)
    §B{total:i32} (+ (* x 2) y)
    §IF (< total 23395)
      §R 23395
    §EL
      §R total

  §F{l2m32_fn02:pub} (i32:x, i32:y) -> i32
    §E{}
