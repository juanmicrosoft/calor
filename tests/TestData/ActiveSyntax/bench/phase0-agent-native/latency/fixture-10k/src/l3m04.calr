§M{L3M04}

  §F{l3m04_fn01:pub} (i32:x, i32:y) -> i32
    §E{}
    §Q (> x 5)
    §S (>= x 6)
    §B{acc:i32} (+ (* x 2) y)
    §IF (> acc 23801)
      §R (+ acc 23801)
    §EL
      §R (+ (* acc 2) 23801)

  §F{l3m04_fn02:pub} (i32:x, i32:y) -> i32
    §E{}
    §B{base:i32} (- (* x 4) y)
    §R (+ base 29)

  §F{l3m04_fn03:pub} (i32:x, i32:y) -> i32
    §E{}
    §Q (>= x 3)
    §Q (>= y 0)
    §S (>= result 23808)
    §B{total:i32} (+ (* x 3) y)
    §IF (< total 23808)
      §R 23808
    §EL
      §R total

  §F{l3m04_fn04:pub} (i32:x, i32:y) -> i32
    §E{}
    §Q (>= x 3)
    §Q (>= y 0)
    §S (>= result 23815)
    §B{total:i32} (+ (* x 5) y)
    §IF (< total 23815)
      §R 23815
    §EL
      §R total

  §F{l3m04_fn05:pub} (i32:x, i32:y) -> i32
    §E{}
    §Q (>= x 0)
    §S (<= result 23822)
    §B{total:i32} (+ (* x 3) y)
    §IF (> total 23822)
      §R 23822
    §R total

  §F{l3m04_fn06:pub} (i32:x, i32:y) -> i32
    §E{}
    §B{base:i32} (- (* x 4) y)
    §R (+ base 83)

  §F{l3m04_fn07:pub} (i32:x, i32:y) -> i32
    §E{}
    §Q (>= x 4)
    §Q (>= y 0)
    §S (>= result 23829)
    §B{total:i32} (+ (* x 5) y)
    §IF (< total 23829)
      §R 23829
    §EL
      §R total

  §F{l3m04_fn08:pub} (i32:x, i32:y) -> i32
    §E{}
    §Q (>= y 0)
    §S (>= result x)
    §S (>= result 23836)
    §IF (>= x 23836)
      §R x
    §EL
      §R 23836

  §F{l3m04_fn09:pub} (i32:x, i32:y) -> i32
    §E{}
    §B{base:i32} (- (* x 4) y)
    §R (+ base 16)

  §F{l3m04_fn10:pub} (i32:x, i32:y) -> i32
    §E{}
