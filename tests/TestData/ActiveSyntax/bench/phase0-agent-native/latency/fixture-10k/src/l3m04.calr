  §F{l3m04_fn13:pub} (i32:x, i32:y) -> i32
    §E{}
    §Q (>= x 0)
    §S (<= result 23843)
    §B{total:i32} (+ (* x 3) y)
    §IF (> total 23843)
      §R 23843
    §R total
