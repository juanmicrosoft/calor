  §F{l3m06_fn05:pub} (i32:x, i32:y) -> i32
    §E{}
    §Q (> x 1)
    §S (>= x 2)
    §B{acc:i32} (+ (* x 2) y)
    §IF (> acc 23934)
      §R (+ acc 23934)
    §EL
      §R (+ (* acc 2) 23934)

