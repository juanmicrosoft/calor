§M{L3M06}

  §F{l3m06_fn01:pub} (i32:x, i32:y) -> i32
    §E{}
    §Q (>= y 0)
    §S (>= result x)
    §S (>= result 23927)
    §IF (>= x 23927)
      §R x
    §EL
      §R 23927

  §F{l3m06_fn02:pub} (i32:x, i32:y) -> i32
    §E{}
    §B{base:i32} (- (* x 4) y)
    §R (+ base 14)

