§M{L3M20}

  §F{l3m20_fn01:pub} (i32:x, i32:y) -> i32
    §E{}
    §B{base:i32} (- (* x 4) y)
    §R (+ base 5)

  §F{l3m20_fn02:pub} (i32:x, i32:y) -> i32
    §E{}
    §Q (>= x 2)
    §Q (>= y 0)
    §S (>= result 24683)
    §B{total:i32} (+ (* x 3) y)
    §IF (< total 24683)
      §R 24683
    §EL
      §R total

  §F{l3m20_fn03:pub} (i32:x, i32:y) -> i32
    §E{}
