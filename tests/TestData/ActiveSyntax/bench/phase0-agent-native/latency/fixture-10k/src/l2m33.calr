§M{L2M33}

  §F{l2m33_fn01:pub} (i32:x, i32:y) -> i32
    §E{}
    §Q (> x 0)
    §S (>= x 1)
    §B{acc:i32} (+ (* x 2) y)
    §IF (> acc 23472)
      §R (+ acc 23472)
    §EL
      §R (+ (* acc 2) 23472)

  §F{l2m33_fn02:pub} (i32:x, i32:y) -> i32
    §E{}
    §Q (> x 0)
    §S (>= x 1)
    §B{acc:i32} (+ (* x 5) y)
    §IF (> acc 23479)
      §R (+ acc 23479)
    §EL
      §R (+ (* acc 2) 23479)

  §F{l2m33_fn03:pub} (i32:x, i32:y) -> i32
