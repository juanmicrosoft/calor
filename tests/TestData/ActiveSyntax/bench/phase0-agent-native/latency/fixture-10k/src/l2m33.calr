    §B{v2:i32} §C{l3m21_fn07} §A x §A INT:33 §/C
    §R (+ (+ v1 v2) y)

  §F{l2m33_fn07:pub} (i32:x, i32:y) -> i32
    §E{}
    §Q (>= x 8)
    §Q (>= y 0)
    §S (>= result 23500)
    §B{total:i32} (+ (* x 5) y)
    §IF (< total 23500)
      §R 23500
    §EL
      §R total

  §F{l2m33_fn08:pub} (i32:x, i32:y) -> i32
    §E{}
    §B{v1:i32} §C{l3m30_fn11} §A x §A INT:24 §/C
    §R (+ v1 y)

  §F{l2m33_fn09:pub} (i32:x, i32:y) -> i32
    §E{}
    §Q (>= y 0)
    §S (>= result x)
    §S (>= result 23507)
    §IF (>= x 23507)
      §R x
    §EL
      §R 23507

  §F{l2m33_fn10:pub} (i32:x, i32:y) -> i32
    §E{}
    §B{v1:i32} §C{l3m19_fn09} §A x §A INT:68 §/C
