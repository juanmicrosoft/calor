      §R (+ acc 23486)
    §EL
      §R (+ (* acc 2) 23486)

  §F{l2m33_fn04:pub} (i32:x, i32:y) -> i32
    §E{}
    §B{v1:i32} §C{l3m33_fn11} §A x §A INT:45 §/C
    §B{v2:i32} §C{l3m13_fn05} §A x §A INT:39 §/C
    §R (+ (+ v1 v2) y)

  §F{l2m33_fn05:pub} (i32:x, i32:y) -> i32
    §E{}
