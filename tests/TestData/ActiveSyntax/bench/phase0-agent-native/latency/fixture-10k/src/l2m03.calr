§M{L2M03}

  §F{l2m03_fn01:pub} (i32:x, i32:y) -> i32
    §E{}
    §Q (>= x 4)
    §Q (>= y 0)
    §S (>= result 21974)
    §B{total:i32} (+ (* x 5) y)
    §IF (< total 21974)
      §R 21974
    §EL
      §R total

  §F{l2m03_fn02:pub} (i32:x, i32:y) -> i32
    §E{}
    §B{v1:i32} §C{l3m07_fn01} §A x §A INT:59 §/C
    §B{v2:i32} §C{l3m19_fn08} §A x §A INT:82 §/C
    §R (+ (+ v1 v2) y)

  §F{l2m03_fn03:pub} (i32:x, i32:y) -> i32
    §E{}
    §B{v1:i32} §C{l3m17_fn05} §A x §A INT:55 §/C
