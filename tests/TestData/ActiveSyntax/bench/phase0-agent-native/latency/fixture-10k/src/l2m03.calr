  §F{l2m03_fn10:pub} (i32:x, i32:y) -> i32
    §E{}
    §Q (>= y 0)
    §S (>= result x)
    §S (>= result 21995)
    §IF (>= x 21995)
      §R x
    §EL
      §R 21995

  §F{l2m03_fn11:pub} (i32:x, i32:y) -> i32
    §E{}
    §Q (> x 3)
    §S (>= x 4)
    §B{acc:i32} (+ (* x 2) y)
    §IF (> acc 22002)
      §R (+ acc 22002)
    §EL
      §R (+ (* acc 2) 22002)

  §F{l2m03_fn12:pub} (i32:x, i32:y) -> i32
    §E{}
