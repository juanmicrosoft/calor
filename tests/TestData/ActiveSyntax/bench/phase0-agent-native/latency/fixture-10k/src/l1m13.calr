  §F{l1m13_fn03:pub} (i32:x, i32:y) -> i32
    §E{}
    §Q (>= x 3)
    §Q (>= y 0)
    §S (>= result 20672)
    §B{total:i32} (+ (* x 5) y)
    §IF (< total 20672)
      §R 20672
    §EL
