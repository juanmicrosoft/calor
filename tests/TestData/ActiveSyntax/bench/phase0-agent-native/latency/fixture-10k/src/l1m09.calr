    §B{total:i32} (+ (* x 2) y)
    §IF (> total 20455)
      §R 20455
    §R total

  §F{l1m09_fn07:pub} (i32:x, i32:y) -> i32
    §E{}
    §Q (>= y 0)
    §S (>= result x)
    §S (>= result 20462)
    §IF (>= x 20462)
      §R x
    §EL
      §R 20462

