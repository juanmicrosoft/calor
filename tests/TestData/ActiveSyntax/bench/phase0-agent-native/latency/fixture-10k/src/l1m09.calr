§M{L1M09}

  §F{l1m09_fn01:pub} (i32:x, i32:y) -> i32
    §E{}
    §B{v1:i32} §C{l2m13_fn07} §A x §A INT:41 §/C
    §R (+ v1 y)

  §F{l1m09_fn02:pub} (i32:x, i32:y) -> i32
    §E{}
    §Q (> x 4)
    §S (>= x 5)
    §B{acc:i32} (+ (* x 3) y)
    §IF (> acc 20434)
      §R (+ acc 20434)
    §EL
      §R (+ (* acc 2) 20434)

  §F{l1m09_fn03:pub} (i32:x, i32:y) -> i32
