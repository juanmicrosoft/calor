§M{L3M07}

  §F{l3m07_fn01:pub} (i32:x, i32:y) -> i32
    §E{}
    §B{base:i32} (- (* x 4) y)
    §R (+ base 40)

  §F{l3m07_fn02:pub} (i32:x, i32:y) -> i32
    §E{}
    §Q (>= y 0)
    §S (>= result x)
    §S (>= result 23955)
    §IF (>= x 23955)
      §R x
    §EL
      §R 23955

  §F{l3m07_fn03:pub} (i32:x, i32:y) -> i32
    §E{}
    §Q (>= y 0)
    §S (>= result x)
    §S (>= result 23962)
    §IF (>= x 23962)
      §R x
    §EL
      §R 23962

  §F{l3m07_fn04:pub} (i32:x, i32:y) -> i32
    §E{}
    §Q (>= x 0)
    §S (<= result 23969)
    §B{total:i32} (+ (* x 2) y)
    §IF (> total 23969)
      §R 23969
    §R total

  §F{l3m07_fn05:pub} (i32:x, i32:y) -> i32
    §E{}
