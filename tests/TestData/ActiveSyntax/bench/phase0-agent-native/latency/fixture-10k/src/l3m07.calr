    §R (+ base 11)

  §F{l3m07_fn08:pub} (i32:x, i32:y) -> i32
    §E{}
    §Q (> x 0)
    §S (>= x 1)
    §B{acc:i32} (+ (* x 5) y)
    §IF (> acc 23983)
      §R (+ acc 23983)
    §EL
      §R (+ (* acc 2) 23983)

  §F{l3m07_fn09:pub} (i32:x, i32:y) -> i32
    §E{}
