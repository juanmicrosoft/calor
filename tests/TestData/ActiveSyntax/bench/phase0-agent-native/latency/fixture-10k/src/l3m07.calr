    §Q (>= y 0)
    §S (>= result 23976)
    §B{total:i32} (+ (* x 3) y)
    §IF (< total 23976)
      §R 23976
    §EL
      §R total

  §F{l3m07_fn07:pub} (i32:x, i32:y) -> i32
    §E{}
