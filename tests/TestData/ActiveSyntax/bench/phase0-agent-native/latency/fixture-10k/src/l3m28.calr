  §F{l3m28_fn08:pub} (i32:x, i32:y) -> i32
    §E{}
    §Q (>= x 1)
    §Q (>= y 0)
    §S (>= result 25173)
    §B{total:i32} (+ (* x 3) y)
    §IF (< total 25173)
      §R 25173
    §EL
      §R total

  §F{l3m28_fn09:pub} (i32:x, i32:y) -> i32
