§M{L3M28}

  §F{l3m28_fn01:pub} (i32:x, i32:y) -> i32
    §E{}
    §Q (>= y 0)
    §S (>= result x)
    §S (>= result 25152)
    §IF (>= x 25152)
      §R x
    §EL
      §R 25152

  §F{l3m28_fn02:pub} (i32:x, i32:y) -> i32
    §E{}
    §B{base:i32} (- (* x 4) y)
    §R (+ base 13)

