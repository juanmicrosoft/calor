    §R (+ base 58)

  §F{l3m14_fn10:pub} (i32:x, i32:y) -> i32
    §E{}
    §Q (>= y 0)
    §S (>= result x)
    §S (>= result 24361)
    §IF (>= x 24361)
      §R x
    §EL
      §R 24361

  §F{l3m14_fn11:pub} (i32:x, i32:y) -> i32
    §E{}
    §Q (>= x 0)
    §S (<= result 24368)
    §B{total:i32} (+ (* x 5) y)
    §IF (> total 24368)
      §R 24368
    §R total

  §F{l3m14_fn12:pub} (i32:x, i32:y) -> i32
    §E{}
    §B{base:i32} (- (* x 4) y)
    §R (+ base 66)

  §F{l3m14_fn13:pub} (i32:x, i32:y) -> i32
    §E{}
    §Q (>= y 0)
    §S (>= result x)
    §S (>= result 24375)
    §IF (>= x 24375)
      §R x
    §EL
      §R 24375
