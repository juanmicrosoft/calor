§M{L3M14}

  §F{l3m14_fn01:pub} (i32:x, i32:y) -> i32
    §E{}
    §B{base:i32} (- (* x 4) y)
    §R (+ base 7)

  §F{l3m14_fn02:pub} (i32:x, i32:y) -> i32
    §E{}
    §Q (> x 2)
    §S (>= x 3)
    §B{acc:i32} (+ (* x 5) y)
    §IF (> acc 24340)
      §R (+ acc 24340)
    §EL
      §R (+ (* acc 2) 24340)

  §F{l3m14_fn03:pub} (i32:x, i32:y) -> i32
    §E{}
    §Q (> x 3)
    §S (>= x 4)
    §B{acc:i32} (+ (* x 3) y)
    §IF (> acc 24347)
      §R (+ acc 24347)
    §EL
      §R (+ (* acc 2) 24347)

  §F{l3m14_fn04:pub} (i32:x, i32:y) -> i32
    §E{}
    §B{base:i32} (- (* x 4) y)
    §R (+ base 54)

  §F{l3m14_fn05:pub} (i32:x, i32:y) -> i32
    §E{}
