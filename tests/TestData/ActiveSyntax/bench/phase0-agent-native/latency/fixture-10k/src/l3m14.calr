    §R (+ base 7)

  §F{l3m14_fn06:pub} (i32:x, i32:y) -> i32
    §E{}
    §Q (>= x 3)
    §Q (>= y 0)
    §S (>= result 24354)
    §B{total:i32} (+ (* x 3) y)
    §IF (< total 24354)
      §R 24354
    §EL
      §R total

  §F{l3m14_fn07:pub} (i32:x, i32:y) -> i32
    §E{}
