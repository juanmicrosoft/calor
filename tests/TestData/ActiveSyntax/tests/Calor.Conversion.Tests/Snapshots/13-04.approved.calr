module Test_13_04 Test_13_04 overflow unchecked
  class Result<T> public abstract

  class Ok<T> public
    extends Result<T>

    property T:Value public
      get

    ctor public (T:value)
      set Value value

  class Error<T> public
    extends Result<T>

    property string:Message public
      get

    ctor public (string:message)
      set Message message

  module ResultExtensions public
    func Describe<T> public (Result<T>:result) → string
      return match result
        case Ok<T> ok → "Success: ${ok.Value}"
        case Error<T> err → "Error: ${err.Message}"
        case _ → "Unknown"
