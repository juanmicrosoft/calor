module Test_13_08 Test_13_08 overflow unchecked
  using System.Collections.Generic

  class CollectionHoistDemo public
    func GetValues public () → Dictionary<string,int>
      !
      return new Dictionary<string,int> {{"a", Compute(1)}, {"b", Compute(2)}}

    func GetNames public () → HashSet<string>
      ! alloc
      let HashSet<string>:set004 = new HashSet<string>() {Format("x"), Format("y")}
      return set004

    func Compute private (int:x) → int
      return x * 2

    func Format private (string:s) → string
      return s.ToUpper()
