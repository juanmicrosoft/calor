module Test_05_03 Test_05_03 overflow unchecked
  using System.Linq
  using System.Collections.Generic

  class Transform public
    func GetNames public (List<string>:items) → List<string>
      !
      let _lamWhere008 = (string:s) => s.Length > 0
      let _chainWhere009 = items.Where(_lamWhere008)
      let _lamSelect006 = (string:s) => s.ToUpper()
      let _chainSelect010 = _chainWhere009.Select(_lamSelect006)
      let _lamOrderBy004 = (string:s) => s
      let _chainOrderBy011 = _chainSelect010.OrderBy(_lamOrderBy004)
      return _chainOrderBy011.ToList()
