§M{PureMath}
  §F{Add:pub} (i32:a, i32:b) -> i32
    §R (+ a b)

  §F{Multiply:pub} (i32:a, i32:b) -> i32
    §R (* a b)

  §F{Abs:pub} (i32:x) -> i32
    §IF (< x 0)
      §R (- 0 x)
    §EL
      §R x

  §F{Max:pub} (i32:a, i32:b) -> i32
    §IF (> a b)
      §R a
    §EL
      §R b

  §F{Power:pub} (i32:base, i32:exp) -> i32
    §Q (>= exp 0)
    §B{~result} 1
    §B{~i} 0
    §WH (< i exp)
      §B{~result} (* result base)
      §B{~i} (+ i 1)
    §R result

  §F{StringConcat:pub} (str:a, str:b) -> str
    §R (concat a b)

