module Calculator Calculator
  module CalculatorModule
    func Add public (int:a | (# >= 0), int:b | (# >= 0)) → int
      !
      return a + b

    func Subtract public (int:a | (# >= 0), int:b | (# >= 0)) → int
      !
      return a - b

    func Multiply public (int:a | (# >= 0), int:b | (# >= 0)) → int
      !
      return a * b

    func Divide public (int:a | (# >= 0), int:b | (# > 0)) → int
      !
      return a / b
