§M{Calculator}
  §F{Add:pub} (i32:a, i32:b) -> i32
    §Q (>= a 0)
    §Q (>= b 0)
    §R (+ a b)

  §F{Subtract:pub} (i32:a, i32:b) -> i32
    §Q (>= a 0)
    §Q (>= b 0)
    §R (- a b)

  §F{Multiply:pub} (i32:a, i32:b) -> i32
    §Q (>= a 0)
    §Q (>= b 0)
    §R (* a b)

  §F{Divide:pub} (i32:a, i32:b) -> i32
    §Q (>= a 0)
    §Q (> b 0)
    §R (/ a b)

