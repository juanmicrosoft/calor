module GradeCalculator GradeCalculator
  module GradeCalculatorModule
    func WeightedScore public (float:score | ((# >= 0) && (# <= 100)), float:weight | ((# > 0) && (# <= 1))) → float
      !
      return score * weight

    func LetterGrade public (float:score) → int
      !
      if score >= 90
        return 4
      else if score >= 80
        return 3
      else if score >= 70
        return 2
      else if score >= 60
        return 1
      else
        return 0

    func IsPassing public (float:score) → bool
      !
      return score >= 60
