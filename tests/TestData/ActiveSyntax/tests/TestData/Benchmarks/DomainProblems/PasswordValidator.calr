§M{PasswordValidator}
  §F{LongEnough:pub} (i32:length, i32:minLength) -> bool
    §R (>= length minLength)

  §F{HasDigit:pub} (bool:containsDigit) -> bool
    §R containsDigit

  §F{HasUpper:pub} (bool:containsUpper) -> bool
    §R containsUpper

  §F{StrengthScore:pub} (bool:longEnough, bool:hasDigit, bool:hasUpper, bool:hasSpecial) -> i32
    §B{score} 0
    §IF longEnough
      §ASSIGN score (+ score 1)
    §IF hasDigit
      §ASSIGN score (+ score 1)
    §IF hasUpper
      §ASSIGN score (+ score 1)
    §IF hasSpecial
      §ASSIGN score (+ score 1)
    §R score

