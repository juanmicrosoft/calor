module PasswordValidator PasswordValidator
  module PasswordValidatorModule
    func LongEnough public (int:length, int:minLength) → bool
      return length >= minLength

    func HasDigit public (bool:containsDigit) → bool
      return containsDigit

    func HasUpper public (bool:containsUpper) → bool
      return containsUpper

    func StrengthScore public (bool:longEnough, bool:hasDigit, bool:hasUpper, bool:hasSpecial) → int
      let score = 0
      if longEnough
        set score score + 1
      if hasDigit
        set score score + 1
      if hasUpper
        set score score + 1
      if hasSpecial
        set score score + 1
      return score
