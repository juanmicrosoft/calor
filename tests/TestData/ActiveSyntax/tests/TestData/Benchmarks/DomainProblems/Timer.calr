module Timer Timer
  module TimerModule
    func SecondsToMinutes public (int:seconds | (# >= 0)) → int
      !
      return seconds / 60

    func RemainingSeconds public (int:seconds | (# >= 0)) → int
      !
      return seconds % 60

    func IsExpired public (int:remaining) → bool
      !
      return remaining <= 0

    func Tick public (int:remaining | (# > 0)) → int
      !
      => result < remaining
      return remaining - 1
