§M{Timer}
  §F{SecondsToMinutes:pub} (i32:seconds) -> i32
    §Q (>= seconds 0)
    §R (/ seconds 60)

  §F{RemainingSeconds:pub} (i32:seconds) -> i32
    §Q (>= seconds 0)
    §R (% seconds 60)

  §F{IsExpired:pub} (i32:remaining) -> bool
    §R (<= remaining 0)

  §F{Tick:pub} (i32:remaining) -> i32
    §Q (> remaining 0)
    §S (< result remaining)
    §R (- remaining 1)

