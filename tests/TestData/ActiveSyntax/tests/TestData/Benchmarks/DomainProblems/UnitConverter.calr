module UnitConverter UnitConverter
  module UnitConverterModule
    func InchesToCm public (float:inches) → float
      !
      requires inches >= 0
      return inches * 2.54

    func CmToInches public (float:cm) → float
      !
      requires cm >= 0
      return cm / 2.54

    func PoundsToKg public (float:pounds) → float
      !
      requires pounds >= 0
      return pounds * 0.453592

    func KgToPounds public (float:kg) → float
      !
      requires kg >= 0
      return kg / 0.453592

    func GallonsToLiters public (float:gallons) → float
      !
      requires gallons >= 0
      return gallons * 3.78541
