module UnitConverter UnitConverter
  module UnitConverterModule
    func InchesToCm public (float:inches | (# >= 0)) → float
      !
      return inches * 2.54

    func CmToInches public (float:cm | (# >= 0)) → float
      !
      return cm / 2.54

    func PoundsToKg public (float:pounds | (# >= 0)) → float
      !
      return pounds * 0.453592

    func KgToPounds public (float:kg | (# >= 0)) → float
      !
      return kg / 0.453592

    func GallonsToLiters public (float:gallons | (# >= 0)) → float
      !
      return gallons * 3.78541
