module Inventory Inventory
  module InventoryModule
    func Restock public (int:current, int:quantity | (# > 0)) → int
      !
      => result > current
      return current + quantity

    func Sell public (int:current, int:quantity | ((# > 0) && (current >= #))) → int
      !
      => result >= 0
      return current - quantity

    func InStock public (int:quantity) → bool
      !
      return quantity > 0

    func NeedsReorder public (int:quantity, int:threshold) → bool
      !
      return quantity <= threshold
