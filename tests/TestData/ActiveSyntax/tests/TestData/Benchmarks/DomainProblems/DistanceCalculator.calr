module DistanceCalculator DistanceCalculator
  module DistanceCalculatorModule
    func DistanceSquared public (float:x1, float:y1, float:x2, float:y2) → float
      !
      => result >= 0
      let dx = x2 - x1
      let dy = y2 - y1
      return (dx * dx) + (dy * dy)

    func ManhattanDist public (float:x1, float:y1, float:x2, float:y2) → float
      !
      => result >= 0
      let dx = x2 - x1
      let dy = y2 - y1
      let absDx = dx
      if absDx < 0
        set absDx 0 - absDx
      let absDy = dy
      if absDy < 0
        set absDy 0 - absDy
      return absDx + absDy
