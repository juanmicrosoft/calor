module EmailValidator EmailValidator
  module EmailValidatorModule
    func HasAtSign public (bool:containsAt) → bool
      !
      return containsAt

    func HasDot public (bool:containsDot) → bool
      !
      return containsDot

    func IsValidLength public (int:length) → bool
      !
      return length >= 5 && length <= 254

    func IsValid public (bool:hasAt, bool:hasDot, int:length) → bool
      !
      return (hasAt && hasDot) && (length >= 5 && length <= 254)
