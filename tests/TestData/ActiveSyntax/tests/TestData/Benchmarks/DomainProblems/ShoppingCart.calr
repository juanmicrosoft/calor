module ShoppingCart ShoppingCart
  module ShoppingCartModule
    func ItemTotal public (float:price | (# > 0), int:quantity | (# > 0)) → float
      !
      => result >= 0
      return price * quantity

    func CartSubtotal public (float:itemTotal1 | (# >= 0), float:itemTotal2 | (# >= 0)) → float
      !
      => result >= 0
      return itemTotal1 + itemTotal2

    func TotalWithTax public (float:subtotal | (# >= 0), float:taxRate | ((# >= 0) && (# <= 1))) → float
      !
      => result >= subtotal
      return subtotal + (subtotal * taxRate)

    func NewQuantity public (int:oldQuantity, int:change) → int
      !
      let result = oldQuantity + change
      if result < 0
        return 0
      else
        return result
