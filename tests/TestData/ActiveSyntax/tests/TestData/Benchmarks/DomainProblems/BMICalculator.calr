module BMICalculator BMICalculator
  module BMICalculatorModule
    func CalculateBMI public (float:weightKg, float:heightM) → float
      !
      requires weightKg > 0
      requires heightM > 0
      => result > 0
      return weightKg / (heightM * heightM)

    func Category public (float:bmi) → int
      !
      requires bmi > 0
      if bmi < 18.5
        return 0
      else if bmi < 25
        return 1
      else if bmi < 30
        return 2
      else
        return 3

    func IsHealthy public (float:bmi) → bool
      !
      return bmi >= 18.5 && bmi < 25
