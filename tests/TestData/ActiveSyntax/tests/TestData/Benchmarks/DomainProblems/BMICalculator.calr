module BMICalculator BMICalculator
  module BMICalculatorModule
    func CalculateBMI public (float:weightKg | (# > 0), float:heightM | (# > 0)) → float
      !
      => result > 0
      return weightKg / (heightM * heightM)

    func Category public (float:bmi | (# > 0)) → int
      !
      if bmi < 18.5
        return 0
      else if bmi < 25
        return 1
      else if bmi < 30
        return 2
      else
        return 3

    func IsHealthy public (float:bmi) → bool
      !
      return bmi >= 18.5 && bmi < 25
