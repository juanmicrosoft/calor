module TaxCalculator TaxCalculator
  module TaxCalculatorModule
    func TaxRate public (float:income | (# >= 0)) → float
      !
      if income <= 10000
        return 0.1
      else if income <= 40000
        return 0.2
      else if income <= 85000
        return 0.3
      else
        return 0.37

    func SimpleTax public (float:income | (# >= 0), float:rate | ((# >= 0) && (# <= 1))) → float
      !
      return income * rate

    func AfterTax public (float:income | (# >= 0), float:tax | (# >= 0)) → float
      !
      => result >= 0
      return income - tax
