module PhoneBook PhoneBook
  module PhoneBookModule
    func EntryCount public (int:count) → int
      !
      => result >= 0
      return count

    func AddEntry public (int:count) → int
      !
      return count + 1

    func RemoveEntry public (int:count | (# > 0)) → int
      !
      => result >= 0
      return count - 1

    func IsEmpty public (int:count) → bool
      !
      return count == 0
