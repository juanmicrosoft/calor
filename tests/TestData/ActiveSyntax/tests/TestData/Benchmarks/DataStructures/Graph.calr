module Graph Graph
  module GraphModule
    func IsConnected public (int:edgeCount) → bool
      !
      return edgeCount > 0

    func Degree public (int:neighborCount) → int
      !
      => result >= 0
      return neighborCount

    func HasEdge public (int:@from | (# >= 0), int:@to | (# >= 0), int:nodeCount | ((@from < #) && (@to < #))) → bool
      !
      return @from != @to

    func NodeCount public (int:count) → int
      !
      => result >= 0
      return count
