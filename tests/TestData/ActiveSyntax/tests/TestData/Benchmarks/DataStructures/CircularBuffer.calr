module CircularBuffer CircularBuffer
  module CircularBufferModule
    func NextIndex public (int:current, int:capacity | (# > 0)) → int
      !
      => result >= 0
      => result < capacity
      return (current + 1) % capacity

    func IsFull public (int:count, int:capacity) → bool
      !
      return count == capacity

    func IsEmpty public (int:count) → bool
      !
      return count == 0

    func WriteIndex public (int:head, int:count, int:capacity | (# > 0)) → int
      !
      return (head + count) % capacity
