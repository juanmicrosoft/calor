module BitSet BitSet
  module BitSetModule
    func PowerOfTwo public (int:pos) → int
      !
      requires pos >= 0
      requires pos < 32
      => result > 0
      if pos == 0
        return 1
      let sub = PowerOfTwo(pos - 1)
      return 2 * sub

    func SetBit public (int:bits, int:pos) → int
      !
      requires pos >= 0
      requires pos < 32
      let mask = PowerOfTwo(pos)
      return bits + mask

    func TestBit public (int:bits, int:pos) → bool
      !
      requires pos >= 0
      requires pos < 32
      let mask = PowerOfTwo(pos)
      let div = bits / mask
      return div % 2 != 0

    func PopCount public (int:bits) → int
      !
      => result >= 0
      if bits == 0
        return 0
      let rest = PopCount(bits / 2)
      return (bits % 2) + rest
