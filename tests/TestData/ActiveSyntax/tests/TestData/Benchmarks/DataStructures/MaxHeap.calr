§M{MaxHeap}
  §F{Parent:pub} (i32:index) -> i32
    §Q (> index 0)
    §R (/ (- index 1) 2)

  §F{LeftChild:pub} (i32:index) -> i32
    §R (+ (* 2 index) 1)

  §F{RightChild:pub} (i32:index) -> i32
    §R (+ (* 2 index) 2)

  §F{ShouldSwapUp:pub} (i32:child, i32:parent) -> bool
    §R (> child parent)

  §F{HasChild:pub} (i32:childIndex, i32:size) -> bool
    §R (< childIndex size)

