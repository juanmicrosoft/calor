module BinaryTree BinaryTree
  module BinaryTreeModule
    func CompareValues public (int:a, int:b) → int
      if a < b
        return -1
      else if a > b
        return 1
      else
        return 0

    func ShouldGoLeft public (int:value, int:nodeValue) → bool
      return value < nodeValue

    func ShouldGoRight public (int:value, int:nodeValue) → bool
      return value > nodeValue

    func IsMatch public (int:value, int:nodeValue) → bool
      return value == nodeValue
