module HashMap HashMap
  module HashMapModule
    func BucketIndex public (int:hashCode, int:bucketCount | (# > 0)) → int
      !
      => result >= 0
      => result < bucketCount
      let absHash = hashCode
      if absHash < 0
        set absHash 0 - absHash
      return absHash % bucketCount

    func LoadFactor public (int:itemCount, int:bucketCount | (# > 0)) → float
      !
      return (double)itemCount / (double)bucketCount

    func NeedsResize public (int:itemCount, int:bucketCount | (# > 0)) → bool
      !
      return (itemCount * 100) > (bucketCount * 75)
