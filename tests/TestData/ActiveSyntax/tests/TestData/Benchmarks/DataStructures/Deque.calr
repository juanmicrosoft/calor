module Deque Deque
  module DequeModule
    func CanRemove public (int:size) → bool
      !
      return size > 0

    func NewSizeAfterAdd public (int:size) → int
      !
      => result > size
      return size + 1

    func NewSizeAfterRemove public (int:size | (# > 0)) → int
      !
      => result < size
      return size - 1

    func IsEmpty public (int:size) → bool
      !
      return size == 0
