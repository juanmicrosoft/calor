§M{PriorityQueue}
  §F{HigherPriority:pub} (i32:a, i32:b) -> bool
    §R (< a b)

  §F{ParentIndex:pub} (i32:index) -> i32
    §Q (> index 0)
    §R (/ (- index 1) 2)

  §F{LeftChild:pub} (i32:index) -> i32
    §Q (>= index 0)
    §R (+ (* 2 index) 1)

  §F{RightChild:pub} (i32:index) -> i32
    §Q (>= index 0)
    §R (+ (* 2 index) 2)

