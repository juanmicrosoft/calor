module MixedMath MixedMath
  module MixedMathModule
    func GoodSquare public (int:x) → int
      !
      => result >= 0
      return x * x

    func BadNegate public (int:x) → int
      !
      => result < 0
      return 0 - x

    func SafeDivide public (int:a, int:b | (# != 0)) → int
      !
      => result == a / b
      return a / b

    func ComplexCondition public (int:x | (# > 0), int:y | (# > 0)) → int
      !
      => result > 0
      return x + y
