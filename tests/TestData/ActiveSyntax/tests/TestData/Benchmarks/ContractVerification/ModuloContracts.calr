module ModuloContracts ModuloContracts
  module ModuloContractsModule
    func ModBounded public (int:a | (# >= 0), int:b | (# > 0)) → int
      !
      => result >= 0
      => result < b
      return a % b

    func ModEvenOdd public (int:n) → int
      !
      => result >= 0
      => result <= 1
      let r = n % 2
      if r < 0
        return 0 - r
      else
        return r

    func WrapAround public (int:index | (# >= 0), int:size | (# > 0)) → int
      !
      => result >= 0
      => result < size
      return index % size
