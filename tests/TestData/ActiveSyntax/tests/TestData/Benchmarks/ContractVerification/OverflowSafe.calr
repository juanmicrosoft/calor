module OverflowSafe OverflowSafe
  module OverflowSafeModule
    func IncrementSafe public (int:x | (# < 2147483647)) → int
      !
      => result > x
      return x + 1

    func DecrementSafe public (int:x | (# > -2147483648)) → int
      !
      => result < x
      return x - 1

    func DoubleSafe public (int:x | ((# > 0) && (# < 1073741824))) → int
      !
      => result > x
      return x * 2

    func SquareSafe public (int:x | ((# >= 0) && (# <= 46340))) → int
      !
      => result >= 0
      return x * x

    func NegateSafe public (int:x | ((# < 0) && (# > -2147483648))) → int
      !
      => result > 0
      return 0 - x

    func AddPositivesSafe public (int:x | ((# > 0) && (# < 1073741824)), int:y | ((# > 0) && (# < 1073741824))) → int
      !
      => result > 0
      return x + y

    func UnsignedNonNegative public (uint:x) → bool
      !
      => result == true
      return x >= 0
