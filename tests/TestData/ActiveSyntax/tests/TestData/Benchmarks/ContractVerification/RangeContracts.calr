module RangeContracts RangeContracts
  module RangeContractsModule
    func ClampByte public (int:value) → int
      !
      => result >= 0
      => result <= 255
      if value < 0
        return 0
      else if value > 255
        return 255
      else
        return value

    func Percentage public (int:part | (# >= 0), int:whole | ((# > 0) && (part <= #))) → int
      !
      => result >= 0
      => result <= 100
      return (part * 100) / whole

    func MapRange public (int:value, int:inMin | (value >= #), int:inMax | ((inMin < #) && (value <= #)), int:outMin, int:outMax | (outMin < #)) → int
      !
      return outMin + (((value - inMin) * (outMax - outMin)) / (inMax - inMin))
