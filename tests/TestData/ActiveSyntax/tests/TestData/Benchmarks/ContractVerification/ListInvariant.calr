module ListInvariant ListInvariant
  module ListInvariantModule
    func AddLength public (int:len | (# >= 0)) → int
      !
      => result > len
      => result == len + 1
      return len + 1

    func RemoveLength public (int:len | (# > 0)) → int
      !
      => result < len
      => result >= 0
      return len - 1

    func ConcatLength public (int:lenA | (# >= 0), int:lenB | (# >= 0)) → int
      !
      => result >= lenA
      => result >= lenB
      return lenA + lenB
