module OverflowUnsafe OverflowUnsafe
  module OverflowUnsafeModule
    func IncrementUnsafe public (int:x) → int
      !
      => result > x
      return x + 1

    func DecrementUnsafe public (int:x) → int
      !
      => result < x
      return x - 1

    func DoubleUnsafe public (int:x | (# > 0)) → int
      !
      => result > x
      return x * 2

    func SquareUnsafe public (int:x | (# >= 0)) → int
      !
      => result >= 0
      return x * x

    func NegateUnsafe public (int:x | (# < 0)) → int
      !
      => result > 0
      return 0 - x

    func AddPositivesUnsafe public (int:x | (# > 0), int:y | (# > 0)) → int
      !
      => result > 0
      return x + y
