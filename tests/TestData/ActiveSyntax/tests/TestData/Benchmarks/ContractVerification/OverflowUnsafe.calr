module OverflowUnsafe OverflowUnsafe
  module OverflowUnsafeModule
    func IncrementUnsafe public (int:x) → int
      !
      => result > x
      return x + 1

    func DecrementUnsafe public (int:x) → int
      !
      => result < x
      return x - 1

    func DoubleUnsafe public (int:x) → int
      !
      requires x > 0
      => result > x
      return x * 2

    func SquareUnsafe public (int:x) → int
      !
      requires x >= 0
      => result >= 0
      return x * x

    func NegateUnsafe public (int:x) → int
      !
      requires x < 0
      => result > 0
      return 0 - x

    func AddPositivesUnsafe public (int:x, int:y) → int
      !
      requires x > 0
      requires y > 0
      => result > 0
      return x + y
