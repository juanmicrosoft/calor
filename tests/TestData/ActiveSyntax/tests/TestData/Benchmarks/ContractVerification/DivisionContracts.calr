module DivisionContracts DivisionContracts
  module DivisionContractsModule
    func SafeDiv public (int:a, int:b | (# != 0)) → int
      !
      return a / b

    func SafeMod public (int:a, int:b | (# != 0)) → int
      !
      => result >= 0
      return a % b

    func DivRemainder public (int:a, int:b | (# != 0)) → int
      !
      return a - ((a / b) * b)
