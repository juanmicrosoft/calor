module SearchContracts SearchContracts
  module SearchContractsModule
    func MidIndex public (int:low | (# >= 0), int:high | (low <= #)) → int
      !
      => result >= low
      => result <= high
      return low + ((high - low) / 2)

    func NarrowLeft public (int:mid, int:high | (mid < #)) → int
      !
      => result > mid
      => result <= high
      return mid + 1

    func NarrowRight public (int:low, int:mid | (low < #)) → int
      !
      => result >= low
      => result < mid
      return mid - 1
