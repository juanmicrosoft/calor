module AbsoluteContracts AbsoluteContracts
  module AbsoluteContractsModule
    func AbsNonNeg public (int:x | (# > 0 - 2147483647)) → int
      !
      => result >= 0
      if x >= 0
        return x
      else
        return 0 - x

    func AbsIdempotent public (int:x | (# >= 0)) → int
      !
      => result == x
      return x

    func TriangleInequality public (int:absA | (# >= 0), int:absB | (# >= 0), int:absSum | (# >= 0)) → bool
      !
      return absSum <= (absA + absB)
