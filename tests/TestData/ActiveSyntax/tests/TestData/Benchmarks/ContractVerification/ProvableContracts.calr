§M{VerifiableMath}
  §F{Abs:pub} (i32:x) -> i32
    §S (>= result 0)
    §IF (>= x 0)
      §R x
    §EL
      §R (- 0 x)

  §F{Max:pub} (i32:a, i32:b) -> i32
    §S (>= result a)
    §S (>= result b)
    §IF (> a b)
      §R a
    §EL
      §R b

  §F{Min:pub} (i32:a, i32:b) -> i32
    §S (<= result a)
    §S (<= result b)
    §IF (< a b)
      §R a
    §EL
      §R b

  §F{Clamp:pub} (i32:value, i32:min, i32:max) -> i32
    §Q (<= min max)
    §S (>= result min)
    §S (<= result max)
    §IF (< value min)
      §R min
    §EI (> value max)
      §R max
    §EL
      §R value

