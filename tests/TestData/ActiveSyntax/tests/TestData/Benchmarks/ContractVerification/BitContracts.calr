module BitContracts BitContracts
  module BitContractsModule
    func PowerOfTwo public (int:n | (# > 0)) → bool
      !
      return (n & (n - 1)) == 0

    func IsAligned public (int:value, int:alignment | (# > 0)) → bool
      !
      return value % alignment == 0

    func ClearLowest public (int:n | (# > 0)) → int
      !
      return n & (n - 1)
