module SortingContracts SortingContracts
  module SortingContractsModule
    func IsSorted public (int:a, int:b) → bool
      !
      return a <= b

    func IsPartitioned public (int:left, int:pivot, int:right) → bool
      !
      return left <= pivot && right >= pivot

    func MergePreserves public (int:lenA | (# >= 0), int:lenB | (# >= 0)) → int
      !
      => result == lenA + lenB
      return lenA + lenB
