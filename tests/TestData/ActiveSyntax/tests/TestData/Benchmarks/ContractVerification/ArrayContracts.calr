module ArrayContracts ArrayContracts
  module ArrayContractsModule
    func ValidIndex public (int:length | (# > 0), int:index) → bool
      !
      => result == (index >= 0 && index < length)
      return index >= 0 && index < length

    func LastValidIndex public (int:length | (# > 0)) → int
      !
      => result >= 0
      => result < length
      return length - 1

    func LengthNonNegative public (int:length | (# >= 0)) → bool
      !
      => result == true
      return length >= 0

    func SafeIndexRange public (int:length | (# > 0), int:start | (# >= 0), int:count | (# > 0)) → bool
      !
      => result == ((start + count) <= length)
      return (start + count) <= length

    func MidpointIndex public (int:low | (# >= 0), int:high | (# > low)) → int
      !
      => result >= low
      => result < high
      return low + ((high - low) / 2)

    func BinarySearchBounds public (int:length | (# > 0), int:low | (# >= 0), int:high | (# <= length)) → bool
      !
      => result == (low <= high)
      return low <= high
