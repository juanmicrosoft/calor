module OptionType OptionType
  module OptionTypeModule
    func HasValue public (bool:isSome) → bool
      !
      return isSome

    func Unwrap public (int:value, bool:isSome | (# == true)) → int
      !
      return value

    func GetOrElse public (int:value, int:fallback, bool:isSome) → int
      !
      if isSome
        return value
      else
        return fallback
