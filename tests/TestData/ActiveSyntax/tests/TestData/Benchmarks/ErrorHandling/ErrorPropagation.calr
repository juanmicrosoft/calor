module ErrorPropagation ErrorPropagation
  module ErrorPropagationModule
    func Layer1 public (int:input | (# > 0)) → int
      !
      return input * 2

    func Layer2 public (int:input | (# > 0)) → int
      !
      return input + 10

    func Pipeline public (int:input | (# > 0)) → int
      !
      return (input * 2) + 10
