module Decorator Decorator
  module DecoratorModule
    func BasePrice public (float:price) → float
      !
      requires price > 0
      return price

    func WithTax public (float:price, float:taxRate) → float
      !
      requires price > 0
      requires taxRate >= 0
      => result >= price
      return price * (1 + taxRate)

    func WithDiscount public (float:price, float:discount) → float
      !
      requires price > 0
      requires discount >= 0
      requires discount <= 1
      return price * (1 - discount)
