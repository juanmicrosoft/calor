module Decorator Decorator
  module DecoratorModule
    func BasePrice public (float:price | (# > 0)) → float
      !
      return price

    func WithTax public (float:price | (# > 0), float:taxRate | (# >= 0)) → float
      !
      => result >= price
      return price * (1 + taxRate)

    func WithDiscount public (float:price | (# > 0), float:discount | ((# >= 0) && (# <= 1))) → float
      !
      return price * (1 - discount)
