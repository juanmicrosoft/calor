module Iterator Iterator
  module IteratorModule
    func HasNext public (int:current, int:end) → bool
      !
      return current < end

    func Next public (int:current, int:@step | (# > 0)) → int
      !
      return current + @step

    func Current public (int:value) → int
      !
      return value

    func Reset public (int:start) → int
      !
      return start
