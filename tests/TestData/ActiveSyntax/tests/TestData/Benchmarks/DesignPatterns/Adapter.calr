module Adapter Adapter
  module AdapterModule
    func MilesToKm public (float:miles | (# >= 0)) → float
      !
      return miles * 1.60934

    func KmToMiles public (float:km | (# >= 0)) → float
      !
      return km * 0.621371

    func FahrenheitToCelsius public (float:f) → float
      !
      return ((f - 32) * 5) / 9
