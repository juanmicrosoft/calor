module Proxy Proxy
  module ProxyModule
    func HasAccess public (int:userRole, int:requiredRole) → bool
      !
      return userRole >= requiredRole

    func LogAccess public (int:userId, bool:granted) → int
      ! cw
      if granted
        System.Console.WriteLine("Access granted")
      else
        System.Console.WriteLine("Access denied")
      return userId

    func CacheHit public (bool:isCached) → bool
      !
      return isCached
