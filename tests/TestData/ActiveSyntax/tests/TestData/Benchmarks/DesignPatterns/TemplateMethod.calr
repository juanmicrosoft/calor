§M{DesignPatterns}
  §CL{DataProcessor:int:abs}
    §MT{Process:pub} () -> str
      §B{str:data} §C{this.ReadData}
      §IF (== data "")
        §R "Validation failed"
      §B{str:processed} §C{this.ProcessData} data
      §R §C{this.SaveResults} processed

    §MT{ReadData:priv:abs} () -> str

    §MT{ProcessData:priv:abs} (str:data) -> str

    §MT{SaveResults:priv:abs} (str:data) -> str

    §MT{ValidateData:priv:virt} (str:data) -> bool
      §R (!= data "")


  §CL{CsvProcessor:pub}
    §EXT{DataProcessor}

    §FLD{str:_inputPath:priv}
    §FLD{str:_outputPath:priv}

    §CTOR{pub} (str:inputPath, str:outputPath)
      §ASSIGN this._inputPath inputPath
      §ASSIGN this._outputPath outputPath

    §MT{ReadData:priv:over} () -> str
      §R "CSV data from input"

    §MT{ProcessData:priv:over} (str:data) -> str
      §R §C{data.Replace} §A "," §A "|" §/C

    §MT{SaveResults:priv:over} (str:data) -> str
      §R "Saved CSV"

    §MT{ValidateData:priv:over} (str:data) -> bool
      §B{~_hoist000} §C{base.ValidateData} data
      §B{~_hoist001} §C{data.Contains} "CSV"
      §R (&& _hoist000 _hoist001)


  §CL{JsonProcessor:pub}
    §EXT{DataProcessor}

    §FLD{str:_endpoint:priv}
    §FLD{str:_outputPath:priv}

    §CTOR{pub} (str:endpoint, str:outputPath)
      §ASSIGN this._endpoint endpoint
      §ASSIGN this._outputPath outputPath

    §MT{ReadData:priv:over} () -> str
      §R "JSON content"

    §MT{ProcessData:priv:over} (str:data) -> str
      §R §C{data.Replace} §A "JSON" §A "PROCESSED_JSON" §/C

    §MT{SaveResults:priv:over} (str:data) -> str
      §R "Saved JSON"


  §M{TemplateMethodDemo:int}
    §F{ProcessCsv:pub} (str:input, str:output) -> str
      §B{CsvProcessor:processor} §NEW{CsvProcessor} §A input §A output §/NEW
      §R §C{processor.Process}

    §F{ProcessJson:pub} (str:endpoint, str:output) -> str
      §B{JsonProcessor:processor} §NEW{JsonProcessor} §A endpoint §A output §/NEW
      §R §C{processor.Process}


