module ExhaustiveMatch ExhaustiveMatch
  module ExhaustiveMatchModule
    func CardSuit public (int:suit) → int
      !
      if suit == 0
        return 0
      else if suit == 1
        return 1
      else if suit == 2
        return 2
      else if suit == 3
        return 3
      else
        return 0 - 1

    func IsRed public (int:suit) → bool
      !
      return suit == 1 || suit == 2
