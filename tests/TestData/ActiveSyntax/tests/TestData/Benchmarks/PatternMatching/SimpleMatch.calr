module SimpleMatch SimpleMatch
  module SimpleMatchModule
    func DayName public (int:day) → int
      !
      if day == 1
        return 1
      else if day == 2
        return 2
      else if day == 3
        return 3
      else if day == 4
        return 4
      else if day == 5
        return 5
      else if day == 6
        return 6
      else if day == 7
        return 7
      else
        return 0
