module TupleMatch TupleMatch
  module TupleMatchModule
    func RockPaperScissors public (int:player1, int:player2) → int
      !
      if player1 == player2
        return 0
      else if player1 == 0 && player2 == 2
        return 1
      else if player1 == 1 && player2 == 0
        return 1
      else if player1 == 2 && player2 == 1
        return 1
      else
        return 2
