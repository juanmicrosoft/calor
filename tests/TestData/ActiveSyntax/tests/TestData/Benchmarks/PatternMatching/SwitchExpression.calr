module SwitchExpression SwitchExpression
  module SwitchExpressionModule
    func Season public (int:month) → int
      !
      requires month >= 1
      requires month <= 12
      if month == 12
        return 0
      else if month <= 2
        return 0
      else if month <= 5
        return 1
      else if month <= 8
        return 2
      else if month <= 11
        return 3
      else
        return 0

    func DayType public (int:day) → int
      !
      if day == 0
        return 0
      else if day == 6
        return 0
      else
        return 1

    func HttpCategory public (int:status) → int
      !
      if status < 200
        return 1
      else if status < 300
        return 2
      else if status < 400
        return 3
      else if status < 500
        return 4
      else
        return 5
