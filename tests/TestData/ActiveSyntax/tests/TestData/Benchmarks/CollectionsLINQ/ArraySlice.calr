module ArraySlice ArraySlice
  module ArraySliceModule
    func SliceLength public (int:start | (# >= 0), int:end | (# > start)) → int
      !
      => result > 0
      return end - start

    func IsValidSlice public (int:start, int:end, int:length) → bool
      !
      return (start >= 0 && end <= length) && end >= start
