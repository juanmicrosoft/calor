§M{LinqPipeline}
  §F{SumPositive:pub} (i32:value, i32:acc) -> i32
    §IF (> value 0)
      §R (+ acc value)
    §EL
      §R acc

  §F{CountEven:pub} (i32:value, i32:acc) -> i32
    §IF (== (% value 2) 0)
      §R (+ acc 1)
    §EL
      §R acc

  §F{MaxOfTwo:pub} (i32:a, i32:b) -> i32
    §IF (> a b)
      §R a
    §EL
      §R b

  §F{AnyAboveThreshold:pub} (i32:value, i32:threshold) -> bool
    §R (> value threshold)

