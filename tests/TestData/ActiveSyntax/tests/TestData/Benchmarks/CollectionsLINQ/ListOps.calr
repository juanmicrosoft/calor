module ListOps ListOps
  module ListOpsModule
    func Sum public (int:a, int:b) → int
      return a + b

    func Count public (int:n) → int
      => result >= 0
      return n

    func FirstOrDefault public (int:value, int:defaultVal, bool:hasElements) → int
      if hasElements
        return value
      else
        return defaultVal
