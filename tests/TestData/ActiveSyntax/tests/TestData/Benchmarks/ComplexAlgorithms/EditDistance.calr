module EditDistance EditDistance
  module EditDistanceModule
    func MinOfThree public (int:a, int:b, int:c) → int
      !
      let minAB = a
      if b < minAB
        set minAB b
      if c < minAB
        return c
      else
        return minAB

    func SubstitutionCost public (int:charA, int:charB) → int
      !
      if charA == charB
        return 0
      else
        return 1
