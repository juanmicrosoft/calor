module BubbleSort BubbleSort
  module BubbleSortModule
    func NeedsSwap public (int:a, int:b) → bool
      !
      return a > b

    func PassEnd public (int:length | (# > 0), int:pass) → int
      !
      return length - (pass + 1)

    func TotalPasses public (int:length) → int
      !
      return length - 1
