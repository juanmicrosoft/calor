module SelectionSort SelectionSort
  module SelectionSortModule
    func IsNewMin public (int:current, int:currentMin) → bool
      !
      return current < currentMin

    func LastUnsorted public (int:length | (# > 0)) → int
      !
      return length - 1

    func SearchStart public (int:sortedCount) → int
      !
      return sortedCount + 1
