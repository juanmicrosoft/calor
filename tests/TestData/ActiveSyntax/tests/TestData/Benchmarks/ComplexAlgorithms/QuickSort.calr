module QuickSort QuickSort
  module QuickSortModule
    func ChoosePivot public (int:low | (# >= 0), int:high | (low <= #)) → int
      !
      return high

    func ShouldSwap public (int:value, int:pivot) → bool
      !
      return value <= pivot

    func NextPartitionIndex public (int:current) → int
      !
      return current + 1

    func IsSortedPair public (int:a, int:b) → bool
      !
      return a <= b
