module TowerOfHanoi TowerOfHanoi
  module TowerOfHanoiModule
    func MovesForDisks public (int:disks) → int
      !
      requires disks > 0
      => result > 0
      if disks == 1
        return 1
      else if disks == 2
        return 3
      else if disks == 3
        return 7
      else if disks == 4
        return 15
      else
        return ((2 * disks) * disks) - 1

    func IsBaseCase public (int:disks) → bool
      !
      return disks == 1

    func SubProblemSize public (int:disks) → int
      !
      requires disks > 1
      return disks - 1
