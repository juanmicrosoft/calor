module Dijkstra Dijkstra
  module DijkstraModule
    func Relax public (int:currentDist | (# >= 0), int:edgeWeight | (# > 0), int:neighborDist) → bool
      !
      return (currentDist + edgeWeight) < neighborDist

    func NewDist public (int:currentDist | (# >= 0), int:edgeWeight | (# > 0)) → int
      !
      => result > currentDist
      return currentDist + edgeWeight

    func Infinity public () → int
      !
      return 2147483647
