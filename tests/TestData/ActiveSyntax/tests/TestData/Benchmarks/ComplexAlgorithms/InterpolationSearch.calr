module InterpolationSearch InterpolationSearch
  module InterpolationSearchModule
    func EstimatePosition public (int:low, int:high | (low <= #), int:target, int:lowVal, int:highVal | (lowVal < #)) → int
      !
      let range = high - low
      let valRange = highVal - lowVal
      let offset = target - lowVal
      return low + ((offset * range) / valRange)

    func InRange public (int:target, int:lowVal, int:highVal) → bool
      !
      return target >= lowVal && target <= highVal
