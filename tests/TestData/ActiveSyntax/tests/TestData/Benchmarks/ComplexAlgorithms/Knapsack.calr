module Knapsack Knapsack
  module KnapsackModule
    func BetterValue public (int:withItem, int:withoutItem) → int
      !
      if withItem > withoutItem
        return withItem
      else
        return withoutItem

    func Fits public (int:weight | (# > 0), int:capacity | (# >= 0)) → bool
      !
      return weight <= capacity

    func RemainingCapacity public (int:capacity, int:weight | (capacity >= #)) → int
      !
      => result >= 0
      return capacity - weight
