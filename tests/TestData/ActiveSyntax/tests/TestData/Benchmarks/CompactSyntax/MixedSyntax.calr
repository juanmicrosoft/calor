module MixedSyntax MixedSyntax
  module MixedSyntaxModule
    func Compact public (int:x) → int
      !
      return x * 2

    func Verbose public (int:x | (# > 0)) → int
      !
      => result > x
      return x * 3

    func CompactWithContract public (int:a, int:b | (# != 0)) → int
      !
      return a / b
