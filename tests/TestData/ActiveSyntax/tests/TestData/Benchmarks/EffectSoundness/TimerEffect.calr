module TimerService TimerService
  module TimerServiceModule
    func ElapsedMs public (int:startMs, int:endMs | (# >= startMs)) → int
      !
      => result >= 0
      return endMs - startMs

    func ShouldTimeout public (int:elapsedMs, int:timeoutMs) → bool
      !
      return elapsedMs >= timeoutMs

    func RemainingMs public (int:timeoutMs | (# >= 0), int:elapsedMs) → int
      !
      let remaining = timeoutMs - elapsedMs
      if remaining < 0
        return 0
      else
        return remaining
