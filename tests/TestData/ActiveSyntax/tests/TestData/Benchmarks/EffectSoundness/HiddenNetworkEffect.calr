§M{OrderService}
  §F{SaveOrder:pub} (str:orderId) -> void
    §E{cw}
    §P orderId

  §F{NotifyCustomer:pub} (str:email, str:message) -> void
    §E{cw}
    §P email
    §P message

  §F{ProcessOrder:pub} (str:orderId, str:email) -> void
    §E{cw}
    §C{SaveOrder} orderId
    §C{NotifyCustomer} §A email §A "Order shipped" §/C

