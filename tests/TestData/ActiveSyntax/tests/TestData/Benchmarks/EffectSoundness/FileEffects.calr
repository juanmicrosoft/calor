module FileService FileService
  module FileServiceModule
    func ReadFile public (string:path) → string
      ! fs:r
      return path

    func WriteFile public (string:path, string:content) → void
      ! fs:w
      System.Console.WriteLine(content)

    func ProcessFile public (string:input, string:output) → void
      ! fs:w
      System.Console.WriteLine(input)
