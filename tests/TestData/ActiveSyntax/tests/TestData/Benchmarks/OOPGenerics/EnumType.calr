module EnumType EnumType
  module EnumTypeModule
    func DaysInSeason public (int:season) → int
      !
      if season == 0
        return 92
      else if season == 1
        return 92
      else if season == 2
        return 91
      else
        return 90

    func IsWarm public (int:season) → bool
      !
      return season == 1 || season == 0
