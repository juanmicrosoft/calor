module ConstructorInit ConstructorInit
  module ConstructorInitModule
    func ValidateWidth public (float:width | (# > 0)) → float
      !
      return width

    func ValidateHeight public (float:height | (# > 0)) → float
      !
      return height

    func Area public (float:width | (# > 0), float:height | (# > 0)) → float
      !
      => result > 0
      return width * height
