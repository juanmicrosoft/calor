module GenericConstraints GenericConstraints
  module GenericConstraintsModule
    func Compare public (int:a, int:b) → int
      if a < b
        return 0 - 1
      else if a > b
        return 1
      else
        return 0

    func MaxOf public (int:a, int:b) → int
      if a >= b
        return a
      else
        return b
