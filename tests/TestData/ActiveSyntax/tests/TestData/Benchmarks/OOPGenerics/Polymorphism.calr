module Polymorphism Polymorphism
  module PolymorphismModule
    func ProcessShape public (int:shapeType, float:param1, float:param2) → float
      !
      if shapeType == 0
        return 3.14159 * (param1 * param1)
      else if shapeType == 1
        return param1 * param2
      else
        return (param1 * param2) / 2
