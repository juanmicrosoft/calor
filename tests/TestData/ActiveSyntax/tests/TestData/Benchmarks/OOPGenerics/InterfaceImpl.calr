module InterfaceImpl InterfaceImpl
  module InterfaceImplModule
    func AreaCircle public (float:radius | (# > 0)) → float
      !
      return 3.14159265 * (radius * radius)

    func AreaSquare public (float:side | (# > 0)) → float
      !
      return side * side

    func AreaTriangle public (float:@base | (# > 0), float:height | (# > 0)) → float
      !
      return (@base * height) / 2
