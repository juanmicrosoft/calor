module Inheritance Inheritance
  module InheritanceModule
    func AnimalSound public (int:animalType) → int
      !
      if animalType == 0
        return 0
      else if animalType == 1
        return 1
      else
        return 2

    func CanFly public (int:animalType) → bool
      !
      return animalType == 2

    func Legs public (int:animalType) → int
      !
      if animalType == 0
        return 4
      else if animalType == 1
        return 4
      else
        return 2
