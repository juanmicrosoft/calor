module CompoundInterest CompoundInterest
  module CompoundInterestModule
    func SimpleInterest public (float:principal | (# > 0), float:rate | (# >= 0), int:years | (# > 0)) → float
      !
      => result >= principal
      return principal * (1 + rate * (double)years)

    func YearlyGrowth public (float:amount | (# > 0), float:rate | (# >= 0)) → float
      !
      return amount * (1 + rate)
