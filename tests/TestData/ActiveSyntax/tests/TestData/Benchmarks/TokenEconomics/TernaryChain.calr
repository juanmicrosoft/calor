module TernaryChain TernaryChain
  module TernaryChainModule
    func Classify public (int:score) → int
      !
      if score >= 90
        return 4
      else if score >= 80
        return 3
      else if score >= 70
        return 2
      else if score >= 60
        return 1
      else
        return 0

    func Signum public (int:x) → int
      !
      if x > 0
        return 1
      else if x < 0
        return 0 - 1
      else
        return 0

    func Clamp100 public (int:x) → int
      !
      if x < 0
        return 0
      else if x > 100
        return 100
      else
        return x
