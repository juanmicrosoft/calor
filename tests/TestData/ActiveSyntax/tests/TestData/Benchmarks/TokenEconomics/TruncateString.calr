module TruncateString TruncateString
  module TruncateStringModule
    func NeedsTruncation public (int:strLen, int:maxLen) → bool
      requires maxLen > 0
      return strLen > maxLen

    func TruncatedLength public (int:strLen, int:maxLen) → int
      requires maxLen > 0
      if strLen > maxLen
        return maxLen
      else
        return strLen
