module TruncateString TruncateString
  module TruncateStringModule
    func NeedsTruncation public (int:strLen, int:maxLen | (# > 0)) → bool
      !
      return strLen > maxLen

    func TruncatedLength public (int:strLen, int:maxLen | (# > 0)) → int
      !
      if strLen > maxLen
        return maxLen
      else
        return strLen
