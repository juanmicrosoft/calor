module DigitCount DigitCount
  module DigitCountModule
    func IsZero public (int:n) → bool
      !
      return n == 0

    func Abs public (int:n) → int
      !
      => result >= 0
      if n < 0
        return 0 - n
      else
        return n

    func DigitCountPositive public (int:n) → int
      !
      requires n >= 0
      => result > 0
      if n < 10
        return 1
      let rest = DigitCountPositive(n / 10)
      return 1 + rest

    func DigitCount public (int:n) → int
      !
      => result > 0
      if n == 0
        return 1
      let absN = Abs(n)
      return DigitCountPositive(absN)
