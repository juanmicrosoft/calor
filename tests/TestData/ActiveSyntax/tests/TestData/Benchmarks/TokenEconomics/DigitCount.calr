§M{DigitCount}
  §F{IsZero:pub} (i32:n) -> bool
    §R (== n 0)

  §F{Abs:pub} (i32:n) -> i32
    §S (>= result 0)
    §IF (< n 0)
      §R (- 0 n)
    §EL
      §R n

  §F{DigitCountPositive:pub} (i32:n) -> i32
    §Q (>= n 0)
    §S (> result 0)
    §IF (< n 10)
      §R 1
    §B{rest} §C{DigitCountPositive} (/ n 10)
    §R (+ 1 rest)

  §F{DigitCount:pub} (i32:n) -> i32
    §S (> result 0)
    §IF (== n 0)
      §R 1
    §B{absN} §C{Abs} n
    §R §C{DigitCountPositive} absN

