§M{MathOps}
  §F{Abs:pub} (i32:x) -> i32
    §S (>= result 0)
    §IF (< x 0)
      §R (- 0 x)
    §EL
      §R x

  §F{Min:pub} (i32:a, i32:b) -> i32
    §IF (< a b)
      §R a
    §EL
      §R b

  §F{Max:pub} (i32:a, i32:b) -> i32
    §IF (> a b)
      §R a
    §EL
      §R b

