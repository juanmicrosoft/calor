module ReverseArray ReverseArray
  module ReverseArrayModule
    func SwapIndex public (int:length, int:i | ((# >= 0) && (# < length))) → int
      !
      return (length - 1) - i

    func ShouldSwap public (int:left, int:right) → bool
      !
      return left < right

    func MidPoint public (int:length | (# > 0)) → int
      !
      return length / 2
