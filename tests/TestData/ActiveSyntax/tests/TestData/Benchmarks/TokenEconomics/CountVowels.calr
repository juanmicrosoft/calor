module StringAnalysis StringAnalysis
  module StringAnalysisModule
    func IsVowel public (string:ch) → bool
      if ch == "a"
        return true
      else if ch == "e"
        return true
      else if ch == "i"
        return true
      else if ch == "o"
        return true
      else if ch == "u"
        return true
      else
        return false
