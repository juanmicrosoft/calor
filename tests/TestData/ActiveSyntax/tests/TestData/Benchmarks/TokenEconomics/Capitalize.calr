module Capitalize Capitalize
  module CapitalizeModule
    func ShouldCapitalize public (int:charCode) → bool
      !
      return charCode >= 97 && charCode <= 122

    func ToUpper public (int:charCode | (# >= 97 && # <= 122)) → int
      !
      return charCode - 32

    func IsEmpty public (int:length) → bool
      !
      return length == 0
