module Hypotenuse Hypotenuse
  module HypotenuseModule
    func HypotenuseSquared public (float:a | (# > 0), float:b | (# > 0)) → float
      !
      => result > 0
      return a * a + b * b

    func SumOfSquares public (float:x, float:y) → float
      !
      => result >= 0
      return x * x + y * y
