§M{MediatR.Pipeline}
  §NS{MediatR.Pipeline:file}
    §U{System.Collections.Generic}
    §U{System.Threading}
    §U{System.Threading.Tasks}

    §IFACE{IRequestPreProcessor<in TRequest>}
      §MT{Process} (TRequest:request, CancellationToken:cancellationToken) -> Task

    §IFACE{IPipelineBehavior<TRequest,TResponse>}
      §MT{Handle} (TRequest:request, RequestHandlerDelegate<TResponse>:next, CancellationToken:cancellationToken) -> Task<TResponse>

    §CL{RequestPreProcessorBehavior<TRequest,TResponse>:pub}
      §IMPL{IPipelineBehavior<TRequest, TResponse>}

      §FLD{Seq<IRequestPreProcessor<TRequest>>:_preProcessors:priv:readonly}

      §CTOR{pub} (Seq<IRequestPreProcessor<TRequest>>:preProcessors)
        §ASSIGN _preProcessors preProcessors

      §AMT{Handle:pub} (TRequest:request, RequestHandlerDelegate<TResponse>:next, CancellationToken:cancellationToken) -> TResponse
        §EACH{processor:var} _preProcessors
          §B{_chainProcess010} §C{processor.Process} §A request §A cancellationToken §/C
          §B{_} §AWAIT §C{_chainProcess010.ConfigureAwait} false
        §B{_chainNext011} §C{next}
        §R §AWAIT §C{_chainNext011.ConfigureAwait} false


    §CSHARP{public delegate Task<TResponse> RequestHandlerDelegate<TResponse>();}§/CSHARP


