§M{MatchAfter}
  §F{MatchOption:pub}<eff e> (bool:hasValue, i32:value, Func<i32,i32>:onSome §E{e}, Func<i32>:onNone §E{e}) -> i32
    §E{e}
    §IF hasValue
      §R §C{onSome} §A value §/C
    §R §C{onNone} §/C

  §F{Identity:pub} (i32:x) -> i32
    §E{}
    §R x

  §F{Zero:pub} () -> i32
    §E{}
    §R INT:0

  §F{Shout:pub} (i32:x) -> i32
    §E{cw}
    §P x
    §R x

  §F{BothPure:pub} (bool:h, i32:v) -> i32
    §E{}
    §R §C{MatchOption} §A h §A v §A Identity §A Zero §/C

  §F{OneImpure:pub} (bool:h, i32:v) -> i32
    §E{cw}
    §R §C{MatchOption} §A h §A v §A Shout §A Zero §/C
