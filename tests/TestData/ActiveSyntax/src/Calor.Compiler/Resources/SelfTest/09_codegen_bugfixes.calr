§M{Transliterator}
  §U{System}
  §U{System.Collections.Generic}
  §U{System.Text}

  §CL{TransliteratorBase:pub:abs}
    §PROP{Name:str:pub:abs:get}


  §CL{CyrillicToLatin:pub}
    §EXT{TransliteratorBase}

    §FLD{str:_mappings:priv}

    §PROP{Name:str:pub:over:get}

    §CTOR{pub} (str:name)
      §ASSIGN this._mappings name

    §MT{Transliterate:pub} (str:input) -> str
      §E{cw,cr,mut,alloc}
      §B{~dict} §NEW{Dictionary<char,str>} §/NEW
      §B{[char]:buf} §ARR{char:256}
      §B{~sb} §NEW{StringBuilder} §/NEW
      §B{ConsoleKeyInfo:keyPressed} §C{Console.ReadKey} §/C
      §L{i:0:(len input):1}
        §B{char:ch} §IDX{input} i
        §IF (== ch (char-lit "Y"))
          §C{sb.Append} §A "Y" §/C
        §EL
          §C{sb.Append} §A ch §/C
      §C{Console.WriteLine} §A "{0} {1}" §A §NEW{StringBuilder} §/NEW §A §NEW{StringBuilder} §/NEW §/C
      §R §C{sb.ToString} §/C
