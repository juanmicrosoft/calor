§M{SkillSyntax}
  §F{Main:pub} () -> void
    §E{cw}
    §C{Console.WriteLine} §A "=== Calor Skill Syntax Validation ===" §/C
    §C{Console.WriteLine} §A "" §/C
    §C{TestArithmetic} §/C
    §C{TestComparison} §/C
    §C{TestControlFlow} §/C

  §F{TestArithmetic:priv} () -> void
    §E{cw}
    §C{Console.WriteLine} §A "Testing arithmetic operators..." §/C

  §F{Add:pub} (i32:a, i32:b) -> i32
    §R (+ a b)

  §F{Subtract:pub} (i32:a, i32:b) -> i32
    §R (- a b)

  §F{Multiply:pub} (i32:a, i32:b) -> i32
    §R (* a b)

  §F{TestComparison:priv} () -> void
    §E{cw}
    §C{Console.WriteLine} §A "Testing comparison operators..." §/C

  §F{IsPositive:pub} (i32:x) -> bool
    §R (> x 0)

  §F{IsZero:pub} (i32:x) -> bool
    §R (== x 0)

  §F{TestControlFlow:priv} () -> void
    §E{cw}
    §C{Console.WriteLine} §A "Testing control flow..." §/C
    §L{i:1:5:1}
      §C{Console.WriteLine} §A i §/C

