module FizzBuzz FizzBuzz block
  module FizzBuzzModule
    func Main () → void
      ! cw
      for i from 1 to 100 step 1
        if i % 15 == 0
          Console.WriteLine("FizzBuzz")
        else if i % 3 == 0
          Console.WriteLine("Fizz")
        else if i % 5 == 0
          Console.WriteLine("Buzz")
        else
          Console.WriteLine(i)
