module W5BShapes W5BShapes block
  func QuoteWithSurcharge (int:baseAmount, int:surcharge, int:cap) → int
    !
    => (result <= cap)
    let int:total = (baseAmount + surcharge)
    if (total > cap)
      return cap
    return total

  func AwardWithFloor (int:earned, int:bonus, int:minPoints) → int
    !
    => (result >= minPoints)
    let int:total = (earned + bonus)
    if (total < minPoints)
      return minPoints
    return total

  func GrantRequests (int:requested, int:maxAllowed) → int
    !
    => (result <= maxAllowed)
    if (requested > maxAllowed)
      return maxAllowed
    return requested
