§M{W5BShapes}
  §F{QuoteWithSurcharge:pub} (i32:baseAmount, i32:surcharge, i32:cap) -> i32
    §S (<= result cap)
    §B{total:i32} (+ baseAmount surcharge)
    §IF (> total cap)
      §R cap
    §R total

  §F{AwardWithFloor:pub} (i32:earned, i32:bonus, i32:minPoints) -> i32
    §S (>= result minPoints)
    §B{total:i32} (+ earned bonus)
    §IF (< total minPoints)
      §R minPoints
    §R total

  §F{GrantRequests:pub} (i32:requested, i32:maxAllowed) -> i32
    §S (<= result maxAllowed)
    §IF (> requested maxAllowed)
      §R maxAllowed
    §R requested
