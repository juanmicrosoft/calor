module OutcomeProvenWithResult OutcomeProvenWithResult block
  func Identity (int:x) → int
    !
    => (result == x)
    return x

  func Max (int:a, int:b) → int
    !
    => (result >= a)
    => (result >= b)
    if (a >= b)
      return a
    else
      return b

  func Clamp (int:x) → int
    !
    => (result >= 0)
    if (x < 0)
      return 0
    else if (x > 100)
      return 100
    else
      return x
