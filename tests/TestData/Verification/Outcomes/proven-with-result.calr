§M{m1:OutcomeProvenWithResult}
  §F{f1:Identity:pub} (i32:x) -> i32
    §S (== result x)
    §R x

  §F{f2:Max:pub} (i32:a, i32:b) -> i32
    §S (>= result a)
    §S (>= result b)
    §IF{if1} (>= a b)
      §R a
    §EL
      §R b

  §F{f3:Clamp:pub} (i32:x) -> i32
    §S (>= result 0)
    §IF{if1} (< x 0)
      §R 0
    §EI (> x 100)
      §R 100
    §EL
      §R x
