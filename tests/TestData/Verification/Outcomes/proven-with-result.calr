§M{OutcomeProvenWithResult}
  §F{Identity:pub} (i32:x) -> i32
    §S (== result x)
    §R x

  §F{Max:pub} (i32:a, i32:b) -> i32
    §S (>= result a)
    §S (>= result b)
    §IF (>= a b)
      §R a
    §EL
      §R b

  §F{Clamp:pub} (i32:x) -> i32
    §S (>= result 0)
    §IF (< x 0)
      §R 0
    §EI (> x 100)
      §R 100
    §EL
      §R x
