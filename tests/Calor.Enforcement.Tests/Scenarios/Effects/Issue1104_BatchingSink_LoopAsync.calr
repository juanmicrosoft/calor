// #1104 crash-repro fixture (v0.16 W3(c)), reduced from the Lossy conversion of
// bench/corpus/serilog/src/Serilog/Core/Sinks/Batching/BatchingSink.cs at the
// pinned submodule SHA 0597ddfb (converter options as in Calor0425CorpusLedgerTests).
//
// The C# line `_batchScheduler.MarkFailure(out var shouldDropBatch, out var shouldDropQueue);`
// converted to a hoisted mutable binding of shouldDropQueue whose initializer is a
// call that takes the binding itself as an argument. Resolving the type of
// `shouldDropQueue` typed that call's arguments, which resolved `shouldDropQueue`
// again — unbounded before the fix; the host died.
//
// The original was written in the retired section-marker syntax and reduced in three
// steps (full converted module → enclosing class, receiver field and LoopAsync's
// bindings → this shape). 0.30 rewrites it in native syntax with the same members.
// This file does NOT bind or compile — that is the point of it (the effect pass is
// reached here without a binder). The receiver field is load-bearing: a receiver that
// does not resolve to a type returns before the arguments are typed and the cycle is
// never entered.
module Calor0425Leg Calor0425Leg
  class BatchingSink internal sealed
    field FailureAwareBatchScheduler:_batchScheduler private readonly

    func LoopAsync private async ()
      var shouldDropQueue = _batchScheduler.MarkFailure(shouldDropBatch, shouldDropQueue)
