<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>Calor.Enforcement.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="coverlet.collector">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    <PackageReference Include="Xunit.SkippableFact" />
  </ItemGroup>

  <!--
    Real framework metadata for the Tier B effect tests (TestHarness.FrameworkReferences).
    The compilations under test receive these assemblies only as explicit references,
    the `calor -r` equivalent. PackageDownload fetches the packages without making them
    dependencies, so they are not in this test host's trusted platform assemblies (nor in
    Calor.Compiler.Tests', which references this project); the DLLs are copied to
    FrameworkReferences/ beside the tests.
  -->
  <PropertyGroup>
    <CalorFrameworkReferenceVersion>10.0.3</CalorFrameworkReferenceVersion>
  </PropertyGroup>
  <ItemGroup>
    <CalorFrameworkReference Include="Microsoft.Extensions.Logging.Abstractions" PackageFolder="microsoft.extensions.logging.abstractions" />
    <CalorFrameworkReference Include="Microsoft.Extensions.Configuration.Abstractions" PackageFolder="microsoft.extensions.configuration.abstractions" />
    <CalorFrameworkReference Include="Microsoft.Extensions.Primitives" PackageFolder="microsoft.extensions.primitives" />
    <CalorFrameworkReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" PackageFolder="microsoft.extensions.dependencyinjection.abstractions" />
    <CalorFrameworkReference Include="Microsoft.EntityFrameworkCore" PackageFolder="microsoft.entityframeworkcore" />
    <PackageDownload Include="@(CalorFrameworkReference)" Version="[$(CalorFrameworkReferenceVersion)]" />
    <None Include="@(CalorFrameworkReference->'$(NuGetPackageRoot)%(PackageFolder)/$(CalorFrameworkReferenceVersion)/lib/net10.0/%(Identity).dll')"
          Link="FrameworkReferences/%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Calor.Compiler\Calor.Compiler.csproj" />
    <ProjectReference Include="..\..\src\Calor.Runtime\Calor.Runtime.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Include all test scenario files in the output directory -->
    <None Include="Scenarios\**\*.*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>


  <ItemGroup>
    <Compile Include="..\Shared\Z3TestSeeding.cs" Link="Shared\Z3TestSeeding.cs" />
    <Compile Include="..\Shared\Z3ConsumerGuardTests.cs" Link="Shared\Z3ConsumerGuardTests.cs" />
    <!-- #1564: pins CALOR_HOME to an empty directory so in-process conversion never reads ~/.calor/manifests. -->
    <Compile Include="..\Shared\HermeticCalorHome.cs" Link="Shared\HermeticCalorHome.cs" />
  </ItemGroup>
</Project>
