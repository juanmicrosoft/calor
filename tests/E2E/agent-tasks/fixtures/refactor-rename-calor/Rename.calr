module RenameExamples RenameExamples block
  func Calculate (int:val) → int
    !
    => (result == (val * 2))
    return (val * 2)

  func ValidatedOp (int:num, int:max) → int
    !
    requires (num >= 0)
    requires (num <= max)
    => (result <= max)
    return num

  func OuterCalc (int:x) → int
    !
    let inner = (x * 2)
    return (x + inner)
