module RenameExamples RenameExamples block
  func Calculate (int:val) → int
    !
    => (result == (val * 2))
    return (val * 2)

  func ValidatedOp (int:num | (# >= 0), int:max | (num <= #)) → int
    !
    => (result <= max)
    return num

  func OuterCalc (int:x) → int
    !
    let inner = (x * 2)
    return (x + inner)
