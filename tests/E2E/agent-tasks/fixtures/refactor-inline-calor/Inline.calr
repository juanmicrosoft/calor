module InlineExamples InlineExamples block
  func Double (int:x) → int
    !
    return (x * 2)

  func Calculate (int:a, int:b) → int
    !
    var _hoist000 = Double(a)
    var _hoist001 = Double(b)
    return (_hoist000 + _hoist001)

  func Clamp (int:value, int:min, int:max | (min <= #)) → int
    !
    => (result >= min)
    => (result <= max)
    return ((value < min) ? min : ((value > max) ? max : value))

  func NormalizeScore (int:score) → int
    !
    => (result >= 0)
    => (result <= 100)
    return Clamp(score, 0, 100)

  func Square (int:n) → int
    !
    => (result >= 0)
    return (n * n)

  func SumOfSquares (int:x, int:y) → int
    !
    => (result >= 0)
    var _hoist002 = Square(x)
    var _hoist003 = Square(y)
    return (_hoist002 + _hoist003)
