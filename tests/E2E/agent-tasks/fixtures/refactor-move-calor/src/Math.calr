module MathModule MathModule block
  func Abs (int:x) → int
    !
    => (result >= 0)
    return ((x < 0) ? (0 - x) : x)

  func SafeDivide (int:a, int:b) → int
    !
    requires (b != 0)
    => (result == (a / b))
    return (a / b)

  func Distance (int:x, int:y) → int
    !
    => (result >= 0)
    return Abs(((x * x) + (y * y)))
