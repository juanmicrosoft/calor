§M{SignatureExamples}
  §F{Greet:pub} (str:name) -> str
    §R name

  §F{TryParse:pub} (str:input) -> i32
    §R 0

  §F{CreateRange:pub} (i32:start, i32:end, i32:step) -> i32
    §Q (<= start end)
    §Q (> step 0)
    §R (/ (- end start) step)

  §F{CountSteps:pub} (i32:max) -> i32
    §Q (> max 0)
    §R §C{CreateRange} §A 0 §A max §A 1 §/C

