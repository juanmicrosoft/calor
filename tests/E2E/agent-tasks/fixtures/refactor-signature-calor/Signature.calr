module SignatureExamples SignatureExamples block
  func Greet (string:name) → string
    !
    return name

  func TryParse (string:input) → int
    !
    return 0

  func CreateRange (int:start, int:end | (start <= #), int:@step | (# > 0)) → int
    !
    return ((end - start) / @step)

  func CountSteps (int:max | (# > 0)) → int
    !
    return CreateRange(0, max, 1)
