module Impure Impure block
  func LogAndDouble (int:x) → int
    ! cw
    Console.WriteLine(x)
    return (x * 2)

  func ComputeWithLogging (int:a, int:b) → int
    ! cw
    Console.WriteLine("Computing...")
    return (a + b)

  func NoContractAdd (int:x, int:y) → int
    !
    return (x + y)
