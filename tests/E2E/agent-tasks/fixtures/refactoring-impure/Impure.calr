§M{Impure}
  §F{LogAndDouble:pub} (i32:x) -> i32
    §E{cw}
    §C{Console.WriteLine} §A x §/C
    §R (* x 2)

  §F{ComputeWithLogging:pub} (i32:a, i32:b) -> i32
    §E{cw}
    §C{Console.WriteLine} §A "Computing..." §/C
    §R (+ a b)

  §F{NoContractAdd:pub} (i32:x, i32:y) -> i32
    §R (+ x y)

