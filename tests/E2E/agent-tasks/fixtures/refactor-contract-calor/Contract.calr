module ContractExamples ContractExamples block
  func Sqrt (int:x) → int
    !
    return x

  func Abs (int:x) → int
    !
    return ((x < 0) ? (0 - x) : x)

  func GetElement (int:index, int:length) → int
    !
    return (((index >= 0) && (index < length)) ? index : (0 - 1))

  func PrintValue (int:x) → void
    ! cw
    Console.WriteLine(x)
