module ExtractExamples ExtractExamples block
  func Distance (int:x, int:y) → int
    !
    return ((x * x) + (y * y))

  func ProcessArray (int:index, int:length) → int
    !
    requires (index >= 0)
    requires (index < length)
    => (result >= 0)
    return (((index >= 0) && (index < length)) ? index : (0 - 1))

  func LogAndCompute (int:a, int:b) → int
    ! cw
    Console.WriteLine("Computing sum")
    return (a + b)

  func ComputeNested (int:x, int:y, int:z) → int
    !
    return ((x * x) + ((y * y) + (z * z)))
