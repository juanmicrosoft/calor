module MathOps MathOps block
  func Calculate (int:val | (# >= 0), int:prior) → int
    !
    => (result >= prior)
    let validated = ValidateInput(val)
    let scaled = ScaleInput(validated)
    let total = RunningTotal(scaled, prior)
    return total

  func ValidateInput (int:val | (# >= 0)) → int
    !
    return val

  func ScaleInput (int:val) → int
    !
    return (val * 2)

  func RunningTotal (int:scaled, int:prior) → int
    !
    return (scaled + prior)
