§M{GridOps}
  §F{SumGrid:pub} (i32:size) -> i32
    §B{~total} 0
    §L{x:0:size:1}
      §B{plane} §C{SumPlane} §A x §A size §/C
      §B{~total} (+ total plane)
    §R total

  §F{SumPlane:pub} (i32:x, i32:size) -> i32
    §B{~sum} 0
    §L{y:0:size:1}
      §L{z:0:size:1}
        §B{~sum} (+ sum (+ x (+ y z)))
    §R sum

