module GridOps GridOps block
  func SumGrid (int:size) → int
    !
    var total = 0
    for x from 0 to size step 1
      let plane = SumPlane(x, size)
      var total = (total + plane)
    return total

  func SumPlane (int:x, int:size) → int
    !
    var sum = 0
    for y from 0 to size step 1
      for z from 0 to size step 1
        var sum = (sum + (x + (y + z)))
    return sum
