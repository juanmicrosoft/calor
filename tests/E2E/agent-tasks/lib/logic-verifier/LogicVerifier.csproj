<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <NoWarn>CS8012</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <!-- Never reference the integration checkout: every dependency belongs to the selected arm. -->
    <Reference Include="$(CompilerDirectory)/*.dll" Exclude="$(CompilerDirectory)/libz3.dll" />
    <None Include="$(CompilerDirectory)/libz3.*" CopyToOutputDirectory="PreserveNewest" Link="%(Filename)%(Extension)" />
    <None Include="$(CompilerDirectory)/runtimes/**/*" CopyToOutputDirectory="PreserveNewest" Link="runtimes/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
