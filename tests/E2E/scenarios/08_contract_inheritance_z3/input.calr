§M{ContractZ3Test}
  §IFACE{IService}
    §MT{Process} (i32:value) -> i32
      §Q (>= value 0)

  §CL{ValidService:pub}
    §IMPL{IService}

    §MT{Process:pub} (i32:value) -> i32
      §Q (>= value -10)
      §S (>= result 1)
      §R (+ value 1)


  §CL{AnotherValidService:pub}
    §IMPL{IService}

