§M{PatternDemo}
  §F{GetGrade:pub} (i32:score) -> str
    §R §W score
      §K §PREL{gte} 90 → "A"
      §K §PREL{gte} 80 → "B"
      §K §PREL{gte} 70 → "C"
      §K §PREL{gte} 60 → "D"
      §K _ → "F"

  §F{GetHttpStatus:pub} (i32:code) -> str
    §R §W code
      §K 200 → "OK"
      §K 404 → "Not Found"
      §K 500 → "Server Error"
      §K _ → "Unknown"

  §F{Describe:pub} (i32:x) -> str
    §R §W x
      §K §VAR{n} §WHEN (> n 100) → "large"
      §K §VAR{n} §WHEN (< n 0) → "negative"
      §K 0 → "zero"
      §K _ → "normal"
