[Ll]ogs/

# .NET Core
project.lock.json
project.fragment.lock.json
artifacts/

# ASP.NET Scaffolding
ScaffoldingReadMe.txt

# NuGet Packages
*.nupkg
# NuGet Symbol Packages
*.snupkg

# Others
~$*
*~
CodeCoverage/

# MSBuild Binary and Structured Log
*.binlog

# MSTest test Results
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*

# NUnit
*.VisualState.xml
TestResult.xml
nunit-*.xml

# Z3 libraries (downloaded or built from source on build)
src/Calor.Compiler/z3/
src/Calor.Compiler/runtimes/
src/Calor.Compiler/.z3-temp/

# VS Code extension build artifacts
editors/vscode/server/
editors/vscode/*.vsix

# Conversion reports (generated locally)
conversion-reports/

# Stale report files
report.json

# Claude Code local settings (machine-specific)
.claude/settings.local.json

# Plan drafts and critique archives (working artifacts, not deliverables)
docs/plans/archive/

# Calor template backup files
CLAUDE.md.bak

# Calor incremental build state (calor --cache / calor watch / MSBuild task)
.calor-build-state.json
.claude/worktrees/

# Verification fixture corpora: local verify runs must not commit artifacts
tests/TestData/Verification/**/.calor/
tests/TestData/Verification/**/*.g.cs

# Harness run-internal state must not be committed with epoch results
bench/phase0-agent-native/epochs/**/.envelope-src/
bench/phase0-agent-native/epochs/**/.envelope-meta.json
bench/phase0-agent-native/epochs/**/.envelope.err
bench/phase0-agent-native/epochs/**/.prev-src/
bench/phase0-agent-native/epochs/**/.shim/
bench/phase0-agent-native/epochs/**/.lasthash
bench/phase0-agent-native/epochs/**/.itercount
bench/phase0-agent-native/epochs/**/.src_build.txt
bench/phase0-agent-native/epochs/**/.ho_last.txt
bench/phase0-agent-native/epochs/**/.ho_final.txt
bench/phase0-agent-native/epochs/**/heldout/
# WS5 probe-project run-internals (analogs of heldout/ + .ho_final.txt + .lasthash)
bench/phase0-agent-native/epochs/**/probe/
bench/phase0-agent-native/epochs/**/.probe_final.txt
bench/phase0-agent-native/epochs/**/.smokehash
# WS2 MCP write-path reject replay payloads (run-internal; recorded in mcp-writes.jsonl)
bench/phase0-agent-native/epochs/**/rejects/
