// Security Benchmark: Command Injection Detection
// Tests taint analysis for command injection vulnerabilities

§M{m001:CommandInjectionBenchmark}

  §F{f001:VulnerableShellExec:pub}
    // BUG: Direct shell execution with user input
    // EXPECTED: Calor0982 Command Injection
    §I{string:user_input}
    §O{i32}
    §E{proc}
    §B{cmd:string} (+ STR:"ls -la " user_input)
    §B{slashes:string} §C{cmd.Replace} §A STR:"\\" §A STR:"\\\\" §/C
    §B{argument:string} §C{slashes.Replace} §A STR:"\"" §A STR:"\\\"" §/C
    §C{System.Diagnostics.Process.Start} §A STR:"/bin/sh" §A (+ STR:"-c \"" (+ argument STR:"\"")) §/C
    §R INT:0

  §F{f002:SafeWhitelistedCommand:pub}
    // SAFE: Only whitelisted commands executed
    // EXPECTED: No warnings
    §I{i32:option}
    §O{i32}
    §E{proc}
    §IF{if1} (== option INT:1)
      §C{System.Diagnostics.Process.Start} §A STR:"ls" §/C
    §EI (== option INT:2)
      §C{System.Diagnostics.Process.Start} §A STR:"pwd" §/C
    §EL
      §C{System.Diagnostics.Process.Start} §A STR:"whoami" §/C
    §R INT:0

  §F{f003:VulnerablePopen:pub}
    // BUG: User input passed to popen
    // EXPECTED: Calor0982 Command Injection
    §I{string:user_input}
    §O{string}
    §E{proc}
    §B{cmd:string} (+ STR:"cat " user_input)
    §B{slashes:string} §C{cmd.Replace} §A STR:"\\" §A STR:"\\\\" §/C
    §B{argument:string} §C{slashes.Replace} §A STR:"\"" §A STR:"\\\"" §/C
    §B{result} §C{System.Diagnostics.Process.Start} §A STR:"/bin/sh" §A (+ STR:"-c \"" (+ argument STR:"\"")) §/C
    §R STR:""

  §F{f004:SafeEscapedCommand:pub}
    // SAFE: Shell arguments properly escaped
    // EXPECTED: No warnings
    §I{string:user_input}
    §O{i32}
    §E{proc}
    §B{quoted:string} §C{user_input.Replace} §A STR:"'" §A STR:"'\\''" §/C
    §B{safe:string} (+ STR:"'" (+ quoted STR:"'"))
    §B{cmd:string} (+ STR:"echo " safe)
    §B{slashes:string} §C{cmd.Replace} §A STR:"\\" §A STR:"\\\\" §/C
    §B{argument:string} §C{slashes.Replace} §A STR:"\"" §A STR:"\\\"" §/C
    §C{System.Diagnostics.Process.Start} §A STR:"/bin/sh" §A (+ STR:"-c \"" (+ argument STR:"\"")) §/C
    §R INT:0

  §F{f005:VulnerableSystemCall:pub}
    // BUG: User input in system call
    // EXPECTED: Calor0982 Command Injection
    §I{string:user_input}
    §O{i32}
    §E{proc}
    §B{script:string} (+ STR:"python script.py --arg=" user_input)
    §B{slashes:string} §C{script.Replace} §A STR:"\\" §A STR:"\\\\" §/C
    §B{argument:string} §C{slashes.Replace} §A STR:"\"" §A STR:"\\\"" §/C
    §C{System.Diagnostics.Process.Start} §A STR:"/bin/sh" §A (+ STR:"-c \"" (+ argument STR:"\"")) §/C
    §R INT:0

  §F{f006:SafeArrayExec:pub}
    // SAFE: Command executed as array (no shell)
    // EXPECTED: No warnings
    §I{string:user_input}
    §O{i32}
    §E{proc}
    §B{startInfo} §NEW{System.Diagnostics.ProcessStartInfo} §A STR:"ls" §/NEW
    §ASSIGN startInfo . UseShellExecute BOOL:false
    §C{startInfo.ArgumentList.Add} §A STR:"-la" §/C
    §C{startInfo.ArgumentList.Add} §A user_input §/C
    §C{System.Diagnostics.Process.Start} §A startInfo §/C
    §R INT:0
