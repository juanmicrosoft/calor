// Security Benchmark: SQL Injection Detection
// Tests taint analysis for SQL injection vulnerabilities

§M{m001:SqlInjectionBenchmark}

  §F{f001:VulnerableQuery:pub}
    // BUG: Direct SQL concatenation with user input
    // EXPECTED: Calor0981 SQL Injection
    §I{string:user_input}
    §O{string}
    §E{db:w}
    §B{~query:string} (+ STR:"SELECT * FROM users WHERE name = '" user_input)
    §ASSIGN query (+ query STR:"'")
    §C{db.execute} §A query §/C
    §R query

  §F{f002:SafeParameterizedQuery:pub}
    // SAFE: Parameterized query with placeholders
    // EXPECTED: No warnings
    §I{string:user_input}
    §O{string}
    §E{db:w}
    §B{query:string} STR:"SELECT * FROM users WHERE name = ?"
    §C{db.execute_param} §A query §A user_input §/C
    §R query

  §F{f003:VulnerableMultipleConcatenation:pub}
    // BUG: Multiple concatenations with user input
    // EXPECTED: Calor0981 SQL Injection
    §I{string:user_input}
    §I{string:user_data}
    §O{string}
    §E{db:w}
    §B{~query:string} STR:"INSERT INTO users (name, email) VALUES ('"
    §ASSIGN query (+ query user_input)
    §ASSIGN query (+ query STR:"', '")
    §ASSIGN query (+ query user_data)
    §ASSIGN query (+ query STR:"')")
    §C{db.execute} §A query §/C
    §R query

  §F{f004:SafeEscapedInput:pub}
    // SAFE: Input properly escaped before concatenation
    // EXPECTED: No warnings
    §I{string:user_input}
    §O{string}
    §E{db:w}
    §B{escaped:string} §C{sql_escape} §A user_input §/C
    §B{~query:string} (+ STR:"SELECT * FROM users WHERE name = '" escaped)
    §ASSIGN query (+ query STR:"'")
    §C{db.execute} §A query §/C
    §R query

  §F{f005:VulnerableIndirectTaint:pub}
    // BUG: Taint propagates through intermediate variable
    // EXPECTED: Calor0981 SQL Injection
    §I{string:user_input}
    §O{string}
    §E{db:w}
    §B{name:string} user_input
    §B{search:string} name
    §B{~query:string} (+ STR:"SELECT * FROM users WHERE name LIKE '%" search)
    §ASSIGN query (+ query STR:"%'")
    §C{db.query} §A query §/C
    §R query

  §F{f006:SafeConstantQuery:pub}
    // SAFE: Query uses only constants
    // EXPECTED: No warnings
    §O{string}
    §E{db:w}
    §B{tableName:string} STR:"users"
    §B{query:string} (+ STR:"SELECT COUNT(*) FROM " tableName)
    §C{db.execute} §A query §/C
    §R query
