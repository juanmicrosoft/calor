module ProvenContracts ProvenContracts
  func Square public (int:x | ((# >= 0) && (# <= 46340))) → int
    !
    => result >= 0
    return x * x

  func AbsoluteValue public (int:x | (# >= 0 - 2147483647)) → int
    !
    => result >= 0
    if x < 0
      return 0 - x
    else
      return x

  func Max public (int:a, int:b) → int
    !
    => result >= a
    => result >= b
    if a >= b
      return a
    else
      return b

  func AddPositive public (int:a | ((# > 0) && (# <= 1073741823)), int:b | ((# > 0) && (# <= 1073741823))) → int
    !
    => result > a
    => result > b
    return a + b

  func Identity public (int:x) → int
    !
    => result == x
    return x
