§M{ProvenContracts}
  §F{Square:pub} (i32:x) -> i32
    §Q (>= x 0)
    §Q (<= x 46340)
    §S (>= result 0)
    §R (* x x)

  §F{AbsoluteValue:pub} (i32:x) -> i32
    §Q (>= x (- 0 2147483647))
    §S (>= result 0)
    §IF (< x 0)
      §R (- 0 x)
    §EL
      §R x

  §F{Max:pub} (i32:a, i32:b) -> i32
    §S (>= result a)
    §S (>= result b)
    §IF (>= a b)
      §R a
    §EL
      §R b

  §F{AddPositive:pub} (i32:a, i32:b) -> i32
    §Q (> a 0)
    §Q (> b 0)
    §Q (<= a 1073741823)
    §Q (<= b 1073741823)
    §S (> result a)
    §S (> result b)
    §R (+ a b)

  §F{Identity:pub} (i32:x) -> i32
    §S (== result x)
    §R x
