module ProvenContracts ProvenContracts block
  func Square (int:x) → int
    !
    requires (x >= 0)
    requires (x <= 46340)
    => (result >= 0)
    return (x * x)

  func AbsoluteValue (int:x) → int
    !
    requires (x >= (0 - 2147483647))
    => (result >= 0)
    if (x < 0)
      return (0 - x)
    else
      return x

  func Max (int:a, int:b) → int
    !
    => (result >= a)
    => (result >= b)
    if (a >= b)
      return a
    else
      return b

  func AddPositive (int:a, int:b) → int
    !
    requires (a > 0)
    requires (b > 0)
    requires (a <= 1073741823)
    requires (b <= 1073741823)
    => (result > a)
    => (result > b)
    return (a + b)

  func Identity (int:x) → int
    !
    => (result == x)
    return x
