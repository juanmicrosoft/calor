module ViolationDetected ViolationDetected block
  func BadPostcondition (int:x) → int
    !
    => (result > x)
    return x

  func ImpossibleContract (int:x) → int
    !
    => ((x + 1) > (x + 2))
    return (x + 1)

  func DivisionBug (int:a, int:b) → int
    !
    requires (b != 0)
    => ((a / b) > a)
    return (a / b)
