§M{MixedContracts}
  §F{SafeDivide:pub} (i32:a, i32:b) -> i32
    §Q (!= b 0)
    §S (!= b 0)
    §R (/ a b)

  §F{SumArray:pub} (i32:n) -> i32
    §Q (>= n 0)
    §R 0

  §F{Increment:pub} (i32:x) -> i32
    §S (== result (+ x 1))
    §R (+ x 1)

  §F{ClampPositive:pub} (i32:x) -> i32
    §S (>= result 0)
    §IF (< x 0)
      §R 0
    §EL
      §R x

