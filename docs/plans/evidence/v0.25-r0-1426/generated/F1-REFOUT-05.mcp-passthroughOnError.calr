§M{m001:F1REFOUT05:overflow=unchecked}
  §U{System}

  §CL{c001:Probe:pub:stat}
    §MT{m002:BumpAndGet:pub:stat} (i32:x:ref) -> i32
      §ASSIGN x (+ x 1)
      §R (* x 100)

    §MT{m003:Run:pub:stat} () -> str
      §B{~v:i32} 1
      §B{i32:total} (+ §C{BumpAndGet} §A{ref} v §/C v)
      §R (+ (+ total "|") v)


